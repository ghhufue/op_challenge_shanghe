// Included by the local or competition Host driver.
#include <stdexcept>
#include "kernel_operator.h"
namespace bmms {
struct Shape { int64_t b,m,n,k; };
template<class T> __aicore__ inline float Decode(uint16_t bits) {
    union { uint16_t bits; half value; } v; v.bits=bits;
    return static_cast<float>(v.value);
}
template<> __aicore__ inline float Decode<bfloat16_t>(uint16_t bits) {
    union { uint32_t bits; float value; } v; v.bits=static_cast<uint32_t>(bits)<<16;
    return v.value;
}
// Diagnostic small-shape path; one writer owns all output cache lines.
template<class T,bool TX1,bool TX2>
__global__ __vector__ void Scalar(GM_ADDR x1,GM_ADDR x2,GM_ADDR y,Shape s) {
    AscendC::GlobalTensor<uint16_t> a,b;
    AscendC::GlobalTensor<float> out;
    a.SetGlobalBuffer((__gm__ uint16_t*)x1); b.SetGlobalBuffer((__gm__ uint16_t*)x2);
    out.SetGlobalBuffer((__gm__ float*)y);
    AscendC::TPipe pipe;
    AscendC::TBuf<AscendC::TPosition::VECCALC> buffer;
    pipe.InitBuffer(buffer,64*sizeof(float));
    auto result=buffer.Get<float>();
    for(int64_t batch=0;batch<s.b;++batch) {
        float score=0;
        for(int64_t m=0;m<s.m;++m) {
            float best=-__builtin_inff();
            for(int64_t n=0;n<s.n;++n) {
                float dot=0;
                for(int64_t k=0;k<s.k;++k) {
                    auto ai=batch*s.m*s.k+(TX1?k*s.m+m:m*s.k+k);
                    auto bi=batch*s.n*s.k+(TX2?n*s.k+k:k*s.n+n);
                    dot+=Decode<T>(a.GetValue(ai))*Decode<T>(b.GetValue(bi));
                }
                best=dot>best?dot:best;
            }
            score+=best;
        }
        result.SetValue(batch,score);
    }
    AscendC::SetFlag<AscendC::HardEvent::S_MTE3>(0);
    AscendC::WaitFlag<AscendC::HardEvent::S_MTE3>(0);
    AscendC::DataCopyExtParams params{1,static_cast<uint32_t>(s.b*sizeof(float)),0,0,0};
    AscendC::DataCopyPad(out,result,params);
}
template<class T>
void LaunchScalar(GM_ADDR a,GM_ADDR b,GM_ADDR y,Shape s,aclrtStream stream,bool t1,bool t2) {
    if(t1&&t2) Scalar<T,true,true><<<1,nullptr,stream>>>(a,b,y,s);
    else if(t1) Scalar<T,true,false><<<1,nullptr,stream>>>(a,b,y,s);
    else if(t2) Scalar<T,false,true><<<1,nullptr,stream>>>(a,b,y,s);
    else Scalar<T,false,false><<<1,nullptr,stream>>>(a,b,y,s);
}
}
extern "C" void run_kernel(GM_ADDR x1,const TensorGroupInfo& info_x1,
    GM_ADDR x2,const TensorGroupInfo& info_x2,GM_ADDR y,const TensorGroupInfo& info_y,
    int64_t availableCoreNum,aclrtStream stream,bool transposeX1,bool transposeX2) {
    const auto* a=info_x1.tensors[0].shape;
    const auto* b=info_x2.tensors[0].shape;
    bmms::Shape s{a[0],transposeX1?a[2]:a[1],transposeX2?b[1]:b[2],transposeX1?a[1]:a[2]};
    if(info_x1.tensors[0].dtype==1) bmms::LaunchScalar<half>(x1,x2,y,s,stream,transposeX1,transposeX2);
    else if(info_x1.tensors[0].dtype==2) bmms::LaunchScalar<bfloat16_t>(x1,x2,y,s,stream,transposeX1,transposeX2);
    else throw std::runtime_error("Unsupported input dtype");
}
