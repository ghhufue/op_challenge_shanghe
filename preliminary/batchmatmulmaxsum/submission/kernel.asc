namespace bmms {

inline void CheckAcl(aclError status, const char* operation) {
    if (status != ACL_SUCCESS) {
        throw std::runtime_error(std::string(operation) + ": " + std::to_string(status));
    }
}

inline int64_t QueryCoreCount(aclrtDevAttr attribute, const char* name) {
    int32_t deviceId = 0;
    CheckAcl(aclrtGetDevice(&deviceId), "aclrtGetDevice");
    int64_t count = 0;
    CheckAcl(aclrtGetDeviceInfo(deviceId, attribute, &count), name);
    if (count < 1) {
        throw std::runtime_error(std::string("No ") + name + " are available");
    }
    return count;
}

inline int64_t QueryCubeCoreCount() {
    return QueryCoreCount(ACL_DEV_ATTR_CUBE_CORE_NUM, "Cube core count");
}

inline int64_t QueryVectorCoreCount() {
    return QueryCoreCount(ACL_DEV_ATTR_VECTOR_CORE_NUM, "Vector core count");
}

class DeviceAllocation {
public:
    explicit DeviceAllocation(uint64_t bytes) : bytes_(bytes) {
        if (bytes_ == 0) {
            throw std::invalid_argument("Device allocation size must be positive");
        }
        CheckAcl(aclrtMalloc(&address_, static_cast<size_t>(bytes_), ACL_MEM_MALLOC_HUGE_FIRST),
                 "aclrtMalloc");
    }

    ~DeviceAllocation() {
        if (address_ != nullptr) {
            aclrtFree(address_);
        }
    }

    DeviceAllocation(const DeviceAllocation&) = delete;
    DeviceAllocation& operator=(const DeviceAllocation&) = delete;

    DeviceAllocation(DeviceAllocation&& other) noexcept
        : address_(other.address_), bytes_(other.bytes_) {
        other.address_ = nullptr;
        other.bytes_ = 0;
    }

    DeviceAllocation& operator=(DeviceAllocation&&) = delete;

    GM_ADDR Address() const {
        return static_cast<uint8_t*>(address_);
    }

    uint64_t Bytes() const {
        return bytes_;
    }

private:
    void* address_ = nullptr;
    uint64_t bytes_ = 0;
};

}  // namespace bmms
// ===== END host/acl_runtime.h =====

// ===== BEGIN host/input_validation.h =====
namespace bmms {

inline Shape ValidateInputs(GM_ADDR x1, const TensorGroupInfo& infoX1,
                            GM_ADDR x2, const TensorGroupInfo& infoX2,
                            GM_ADDR y, const TensorGroupInfo& infoY,
                            bool transposeX1, bool transposeX2) {
    if (x1 == nullptr || x2 == nullptr || y == nullptr) {
        throw std::invalid_argument("Input and output device addresses must be non-null");
    }
    if (infoX1.numTensors != 1 || infoX2.numTensors != 1 || infoY.numTensors != 1 ||
        infoX1.tensors == nullptr || infoX2.tensors == nullptr || infoY.tensors == nullptr) {
        throw std::invalid_argument("Each tensor group must contain exactly one tensor");
    }

    const auto& lhs = infoX1.tensors[0];
    const auto& rhs = infoX2.tensors[0];
    const auto& output = infoY.tensors[0];
    if (lhs.shape == nullptr || rhs.shape == nullptr || output.shape == nullptr ||
        lhs.numDims != 3 || rhs.numDims != 3 || output.numDims != 1) {
        throw std::invalid_argument("Expected rank-3 inputs and a rank-1 output");
    }
    if ((lhs.dtype != 1 && lhs.dtype != 2) || rhs.dtype != lhs.dtype || output.dtype != 0) {
        throw std::invalid_argument("Expected matching FP16/BF16 inputs and FP32 output");
    }

    Shape shape{
        lhs.shape[0],
        transposeX1 ? lhs.shape[2] : lhs.shape[1],
        transposeX2 ? rhs.shape[1] : rhs.shape[2],
        transposeX1 ? lhs.shape[1] : lhs.shape[2]
    };
    const int64_t rhsK = transposeX2 ? rhs.shape[2] : rhs.shape[1];
    if (rhs.shape[0] != shape.b || rhsK != shape.k || output.shape[0] != shape.b) {
        throw std::invalid_argument("Input/output shapes are inconsistent");
    }
    if (shape.b < 1 || shape.b > 64 || shape.m < 1 || shape.m > 8192 ||
        shape.n < 1 || shape.n > 8192 || shape.k < 32 || shape.k > 8192 ||
        shape.k % 8 != 0 || shape.b * shape.m * shape.k > (1LL << 26) ||
        shape.b * shape.n * shape.k > (1LL << 26)) {
        throw std::invalid_argument("Shape is outside the supported problem range");
    }
    return shape;
}

}  // namespace bmms
// ===== END host/input_validation.h =====

// ===== BEGIN host/bm_tiling.h =====
namespace bmms {

template<uint32_t TileM, uint32_t TileN, uint32_t TileK>
inline AscendC::tiling::TCubeTiling MakeBmCubeTiling(
        const Shape& shape, int32_t inputDtype, bool transposeX1, bool transposeX2) {
    static_assert(TileM > 0 && TileN > 0 && TileK > 0, "BM tile sizes must be positive");
    const char* socName = aclrtGetSocName();
    if (socName == nullptr) {
        throw std::runtime_error("aclrtGetSocName returned null");
    }
    auto* platform = platform_ascendc::PlatformAscendCManager::GetInstance(socName);
    if (platform == nullptr) {
        throw std::runtime_error("Failed to initialize AscendC platform information");
    }

    const matmul_tiling::DataType dataType = inputDtype == 1
        ? matmul_tiling::DataType::DT_FLOAT16
        : matmul_tiling::DataType::DT_BF16;
    matmul_tiling::MatmulApiTiling tiling(*platform);
    if (tiling.SetAType(matmul_tiling::TPosition::GM, matmul_tiling::CubeFormat::ND,
                        dataType, transposeX1) != 0 ||
        tiling.SetBType(matmul_tiling::TPosition::GM, matmul_tiling::CubeFormat::ND,
                        dataType, transposeX2) != 0 ||
        tiling.SetCType(matmul_tiling::TPosition::GM, matmul_tiling::CubeFormat::ND,
                        matmul_tiling::DataType::DT_FLOAT) != 0 ||
        tiling.SetBiasType(matmul_tiling::TPosition::GM, matmul_tiling::CubeFormat::ND,
                           matmul_tiling::DataType::DT_FLOAT) != 0 ||
        tiling.SetShape(static_cast<int32_t>(TileM), static_cast<int32_t>(TileN),
                        static_cast<int32_t>(shape.k)) != 0 ||
        tiling.SetOrgShape(static_cast<int32_t>(shape.m), static_cast<int32_t>(shape.n),
                           static_cast<int32_t>(shape.k)) != 0 ||
        tiling.SetFixSplit(static_cast<int32_t>(TileM), static_cast<int32_t>(TileN),
                           static_cast<int32_t>(TileK)) != 0 ||
        tiling.EnableBias(false) != 0 ||
        tiling.SetBufferSpace(-1, -1, -1) != 0) {
        throw std::runtime_error("Failed to configure BM Matmul tiling");
    }

    AscendC::tiling::TCubeTiling result;
    if (tiling.GetTiling(result) != 0) {
        throw std::runtime_error("Failed to generate BM Matmul tiling");
    }
    return result;
}

inline GM_ADDR UploadPersistentCubeTiling(
        const AscendC::tiling::TCubeTiling& tiling) {
    constexpr size_t bytes = sizeof(AscendC::tiling::TCubeTiling);
    void* deviceAddress = nullptr;
    CheckAcl(aclrtMalloc(&deviceAddress, bytes, ACL_MEM_MALLOC_HUGE_FIRST),
             "aclrtMalloc(persistent Matmul tiling)");
    const aclError copyStatus = aclrtMemcpy(
        deviceAddress, bytes, &tiling, bytes, ACL_MEMCPY_HOST_TO_DEVICE);
    if (copyStatus != ACL_SUCCESS) {
        aclrtFree(deviceAddress);
        CheckAcl(copyStatus, "aclrtMemcpy(Matmul tiling H2D)");
    }
    return static_cast<uint8_t*>(deviceAddress);
}

}  // namespace bmms
// ===== END host/bm_tiling.h =====

// ===== BEGIN kernels/reference.asc =====
namespace bmms {

__aicore__ inline uint32_t AtomicOutputElements(int64_t batches) {
    return static_cast<uint32_t>(
        (batches + kAtomicAlignmentFloats - 1) / kAtomicAlignmentFloats *
        kAtomicAlignmentFloats);
}

__aicore__ inline void AtomicAddBatchSums(
        AscendC::GlobalTensor<float>& atomicOutput,
        AscendC::LocalTensor<float>& localSums, uint32_t elementCount) {
    AscendC::SetFlag<AscendC::HardEvent::S_MTE3>(0);
    AscendC::WaitFlag<AscendC::HardEvent::S_MTE3>(0);
    AscendC::SetAtomicAdd<float>();
    AscendC::DataCopy(atomicOutput, localSums, elementCount);
    AscendC::DisableDmaAtomic();
}

template<class T>
__aicore__ inline float Decode(uint16_t bits) {
    union {
        uint16_t bits;
        half value;
    } value;
    value.bits = bits;
    return static_cast<float>(value.value);
}

template<>
__aicore__ inline float Decode<bfloat16_t>(uint16_t bits) {
    union {
        uint32_t bits;
        float value;
    } value;
    value.bits = static_cast<uint32_t>(bits) << 16;
    return value.value;
}

// Correctness path. Each worker owns complete (batch, row) tasks, accumulates
// per-batch sums in UB, then issues exactly one aligned atomic GM write.
template<class T, bool TX1, bool TX2>
__global__ __vector__ void RowMax(GM_ADDR x1, GM_ADDR x2, GM_ADDR atomicOutputAddress,
                                  Shape shape, int64_t taskCount,
                                  int64_t workerCount) {
    AscendC::GlobalTensor<uint16_t> lhs;
    AscendC::GlobalTensor<uint16_t> rhs;
    AscendC::GlobalTensor<float> atomicOutput;
    lhs.SetGlobalBuffer(reinterpret_cast<__gm__ uint16_t*>(x1));
    rhs.SetGlobalBuffer(reinterpret_cast<__gm__ uint16_t*>(x2));
    atomicOutput.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(atomicOutputAddress));

    AscendC::TPipe pipe;
    AscendC::TBuf<AscendC::TPosition::VECCALC> atomicBuffer;
    pipe.InitBuffer(atomicBuffer, kMaxOutputBatches * sizeof(float));
    auto localSums = atomicBuffer.Get<float>();
    const uint32_t atomicElements = AtomicOutputElements(shape.b);
    for (uint32_t index = 0; index < atomicElements; ++index) {
        localSums.SetValue(index, 0.0f);
    }

    const int64_t workerId = AscendC::GetBlockIdx();
    for (int64_t taskId = workerId; taskId < taskCount; taskId += workerCount) {
        const int64_t batch = taskId / shape.m;
        const int64_t row = taskId - batch * shape.m;
        float best = -__builtin_inff();

        for (int64_t column = 0; column < shape.n; ++column) {
            float dot = 0.0f;
            for (int64_t depth = 0; depth < shape.k; ++depth) {
                const uint64_t lhsIndex = static_cast<uint64_t>(batch) * shape.m * shape.k +
                    (TX1 ? static_cast<uint64_t>(depth) * shape.m + row
                         : static_cast<uint64_t>(row) * shape.k + depth);
                const uint64_t rhsIndex = static_cast<uint64_t>(batch) * shape.n * shape.k +
                    (TX2 ? static_cast<uint64_t>(column) * shape.k + depth
                         : static_cast<uint64_t>(depth) * shape.n + column);
                dot += Decode<T>(lhs.GetValue(lhsIndex)) * Decode<T>(rhs.GetValue(rhsIndex));
            }
            best = dot > best ? dot : best;
        }
        const uint32_t batchIndex = static_cast<uint32_t>(batch);
        localSums.SetValue(batchIndex, localSums.GetValue(batchIndex) + best);
    }
    AtomicAddBatchSums(atomicOutput, localSums, atomicElements);
}

template<class T>
void LaunchRowMax(GM_ADDR x1, GM_ADDR x2, GM_ADDR atomicOutput, Shape shape,
                  int64_t workerCount, aclrtStream stream,
                  bool transposeX1, bool transposeX2) {
    const int64_t taskCount = shape.b * shape.m;
    if (transposeX1 && transposeX2) {
        RowMax<T, true, true><<<workerCount, nullptr, stream>>>(
            x1, x2, atomicOutput, shape, taskCount, workerCount);
    } else if (transposeX1) {
        RowMax<T, true, false><<<workerCount, nullptr, stream>>>(
            x1, x2, atomicOutput, shape, taskCount, workerCount);
    } else if (transposeX2) {
        RowMax<T, false, true><<<workerCount, nullptr, stream>>>(
            x1, x2, atomicOutput, shape, taskCount, workerCount);
    } else {
        RowMax<T, false, false><<<workerCount, nullptr, stream>>>(
            x1, x2, atomicOutput, shape, taskCount, workerCount);
    }
}

}  // namespace bmms
// ===== END kernels/reference.asc =====

// ===== BEGIN kernels/mixed.asc =====
#include "lib/matmul_intf.h"

namespace bmms {

using namespace AscendC;

constexpr uint64_t kMixedSyncMode = 2;
constexpr uint64_t kMixedReadyFlag = 5;
constexpr uint64_t kMixedReusableFlagBase = 6;

// Match the official FusedLinearOnlineMaxSum MIX kernel: Matmul emits unit
// completion information and the paired AIV sub-blocks consume each tile.
constexpr MatmulConfig kBmmsMixedMatmulConfig{
    false, false, true, 0, 0, 0, false, false, false, false,
    false, 0, 0, 0, 0, 0, 0, 0, true};

__aicore__ inline void LoadMixedCubeTiling(
        GM_ADDR source, TCubeTiling& destination) {
    auto* sourceWords = reinterpret_cast<__gm__ uint32_t*>(source);
    auto* destinationWords = reinterpret_cast<uint32_t*>(&destination);
    for (uint32_t index = 0;
         index < sizeof(TCubeTiling) / sizeof(uint32_t); ++index) {
        destinationWords[index] = sourceWords[index];
    }
}

template<class T, bool TX1, bool TX2,
         uint32_t TileM, uint32_t TileN, uint32_t TileK>
__global__ __aicore__ void BatchMatmulMaxSumMixed(
        GM_ADDR x1, GM_ADDR x2, GM_ADDR workspaceAddress, GM_ADDR yAddress,
        GM_ADDR cubeTilingAddress, Shape shape, uint32_t cubeBlocks,
        uint32_t nGroups) {
    KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_MIX_AIC_1_2);
    static_assert(TileM % kMixedVectorRatio == 0,
                  "Mixed Matmul rows must split evenly across paired AIV cores");

    const uint32_t rawBlock = GetBlockIdx();
    const uint32_t taskRatio = static_cast<uint32_t>(GetTaskRation());
    uint32_t logicalCore = rawBlock;
    uint32_t vectorLane = 0;
    if ASCEND_IS_AIV {
        logicalCore = rawBlock / taskRatio;
        vectorLane = rawBlock - logicalCore * taskRatio;
    }

    const uint64_t mGroups =
        (static_cast<uint64_t>(shape.m) + TileM - 1) / TileM;
    const uint64_t nTiles =
        (static_cast<uint64_t>(shape.n) + TileN - 1) / TileN;
    const uint64_t bmTaskCount = static_cast<uint64_t>(shape.b) * mGroups;
    const uint64_t taskCount = bmTaskCount * nGroups;
    uint64_t iterationsForCore = 0;
    for (uint64_t task = logicalCore; task < taskCount; task += cubeBlocks) {
        const uint32_t nGroup = static_cast<uint32_t>(task % nGroups);
        iterationsForCore += (nTiles - nGroup + nGroups - 1) / nGroups;
    }
    const uint64_t stageElementsPerBuffer =
        static_cast<uint64_t>(TileM) * TileN;
    const uint64_t stageElements =
        static_cast<uint64_t>(cubeBlocks) * kMixedStageBuffers *
        stageElementsPerBuffer;
    const uint64_t partialMaxOffsetElements =
        ((stageElements * sizeof(float) + 511) / 512 * 512) / sizeof(float);
    const uint64_t partialMaxElements = taskCount * TileM;
    const uint64_t partialSumOffsetElements =
        ((partialMaxOffsetElements * sizeof(float) +
          partialMaxElements * sizeof(float) + 511) / 512 * 512) /
        sizeof(float);

    GlobalTensor<T> lhs;
    GlobalTensor<T> rhs;
    GlobalTensor<float> stage;
    GlobalTensor<float> partialMax;
    GlobalTensor<float> partialSums;
    GlobalTensor<float> output;
    lhs.SetGlobalBuffer(reinterpret_cast<__gm__ T*>(x1));
    rhs.SetGlobalBuffer(reinterpret_cast<__gm__ T*>(x2));
    stage.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(workspaceAddress));
    partialMax.SetGlobalBuffer(
        reinterpret_cast<__gm__ float*>(workspaceAddress) +
        partialMaxOffsetElements);
    partialSums.SetGlobalBuffer(
        reinterpret_cast<__gm__ float*>(workspaceAddress) +
        partialSumOffsetElements);
    output.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(yAddress));

    TPipe pipe;
    if ASCEND_IS_AIC {
        using AType = MatmulType<TPosition::GM, CubeFormat::ND, T, TX1>;
        using BType = MatmulType<TPosition::GM, CubeFormat::ND, T, TX2>;
        using CType = MatmulType<TPosition::GM, CubeFormat::ND, float>;
        // A fused MIX kernel runs the Matmul implementation directly on its
        // AIC side.  The generic Matmul alias selects MatmulServiceAux when
        // SPLIT_CORE_CUBE is defined, which only services a separate AIV
        // client and leaves this direct AIC call without a producer.
        matmul::MatmulImpl<AType, BType, CType, CType,
                           kBmmsMixedMatmulConfig> matmul;
        TCubeTiling cubeTiling;
        LoadMixedCubeTiling(cubeTilingAddress, cubeTiling);
        matmul.Init(&cubeTiling, &pipe);

        uint64_t sequence = 0;
        for (uint64_t task = logicalCore; task < taskCount; task += cubeBlocks) {
            const uint64_t bmTask = task / nGroups;
            const uint32_t nGroup = static_cast<uint32_t>(task % nGroups);
            const uint64_t batch = bmTask / mGroups;
            const uint64_t mGroup = bmTask - batch * mGroups;
            const uint64_t rowBase = mGroup * TileM;
            const uint32_t actualM = static_cast<uint32_t>(
                shape.m - static_cast<int64_t>(rowBase) < TileM
                    ? shape.m - static_cast<int64_t>(rowBase) : TileM);
            const uint64_t lhsBatch =
                batch * static_cast<uint64_t>(shape.m) * shape.k;
            const uint64_t rhsBatch =
                batch * static_cast<uint64_t>(shape.n) * shape.k;
            const uint64_t lhsOffset = lhsBatch +
                (TX1 ? rowBase : rowBase * static_cast<uint64_t>(shape.k));

            for (uint64_t nTile = nGroup; nTile < nTiles;
                 nTile += nGroups, ++sequence) {
                const uint32_t pingPong = static_cast<uint32_t>(sequence & 1ULL);
                if (sequence >= kMixedStageBuffers) {
                    CrossCoreWaitFlag(kMixedReusableFlagBase + pingPong);
                }

                const uint32_t columnBase = static_cast<uint32_t>(nTile * TileN);
                const uint32_t actualN = static_cast<uint32_t>(
                    shape.n - static_cast<int64_t>(columnBase) < TileN
                        ? shape.n - static_cast<int64_t>(columnBase) : TileN);
                const uint64_t rhsOffset = rhsBatch +
                    (TX2 ? static_cast<uint64_t>(columnBase) * shape.k
                         : columnBase);
                const uint64_t stageOffset =
                    (static_cast<uint64_t>(logicalCore) * kMixedStageBuffers +
                     pingPong) * stageElementsPerBuffer;

                matmul.SetOrgShape(static_cast<int>(shape.m),
                                   static_cast<int>(shape.n),
                                   static_cast<int>(shape.k),
                                   static_cast<int>(shape.k),
                                   static_cast<int>(TileN));
                matmul.SetTensorA(lhs[lhsOffset], TX1);
                matmul.SetTensorB(rhs[rhsOffset], TX2);
                matmul.SetTail(static_cast<int>(actualM),
                               static_cast<int>(actualN),
                               static_cast<int>(shape.k));
                // Each core owns a compact TileM x TileN staging buffer.  The
                // MIX Matmul API must therefore write sequentially instead of
                // applying the global output matrix stride.
                matmul.template IterateAll<false>(stage[stageOffset], 0, true);
                CrossCoreSetFlag<kMixedSyncMode, PIPE_FIX>(kMixedReadyFlag);
            }
        }
        matmul.End();
    }

    if ASCEND_IS_AIV {
        constexpr uint32_t RowsPerLane = TileM / kMixedVectorRatio;
        constexpr uint32_t FloatRepeat = 64;
        constexpr uint32_t MaxSegments = TileN / FloatRepeat;
        TBuf<TPosition::VECCALC> tileBuffer;
        TBuf<TPosition::VECCALC> rowMaxBuffer;
        TBuf<TPosition::VECCALC> segmentMaxBuffer;
        pipe.InitBuffer(tileBuffer, RowsPerLane * TileN * sizeof(float));
        pipe.InitBuffer(rowMaxBuffer, RowsPerLane * sizeof(float));
        pipe.InitBuffer(segmentMaxBuffer,
                        RowsPerLane * MaxSegments * 2 * sizeof(float));
        LocalTensor<float> tile = tileBuffer.Get<float>();
        LocalTensor<float> rowMax = rowMaxBuffer.Get<float>();
        LocalTensor<float> segmentMax = segmentMaxBuffer.Get<float>();

        uint64_t sequence = 0;
        for (uint64_t task = logicalCore; task < taskCount; task += cubeBlocks) {
            const uint64_t bmTask = task / nGroups;
            const uint32_t nGroup = static_cast<uint32_t>(task % nGroups);
            const uint64_t batch = bmTask / mGroups;
            const uint64_t mGroup = bmTask - batch * mGroups;
            const uint64_t rowBase = mGroup * TileM;
            const uint32_t actualM = static_cast<uint32_t>(
                shape.m - static_cast<int64_t>(rowBase) < TileM
                    ? shape.m - static_cast<int64_t>(rowBase) : TileM);
            const uint32_t laneRowBase = vectorLane * RowsPerLane;
            const uint32_t laneRows = actualM > laneRowBase
                ? (actualM - laneRowBase < RowsPerLane
                       ? actualM - laneRowBase : RowsPerLane)
                : 0;
            for (uint32_t row = 0; row < RowsPerLane; ++row) {
                rowMax.SetValue(row, -__builtin_inff());
            }

            for (uint64_t nTile = nGroup; nTile < nTiles;
                 nTile += nGroups, ++sequence) {
                const uint32_t pingPong = static_cast<uint32_t>(sequence & 1ULL);
                CrossCoreWaitFlag(kMixedReadyFlag);
                const uint32_t columnBase = static_cast<uint32_t>(nTile * TileN);
                const uint32_t actualN = static_cast<uint32_t>(
                    shape.n - static_cast<int64_t>(columnBase) < TileN
                        ? shape.n - static_cast<int64_t>(columnBase) : TileN);
                const uint64_t stageOffset =
                    (static_cast<uint64_t>(logicalCore) * kMixedStageBuffers +
                     pingPong) * stageElementsPerBuffer +
                    static_cast<uint64_t>(laneRowBase) * TileN;

                DataCopy(tile, stage[stageOffset], RowsPerLane * TileN);
                SetFlag<HardEvent::MTE2_V>(0);
                WaitFlag<HardEvent::MTE2_V>(0);
                const uint32_t activeSegments =
                    (actualN + FloatRepeat - 1) / FloatRepeat;
                for (uint32_t segment = 0; segment < activeSegments; ++segment) {
                    const uint32_t segmentStart = segment * FloatRepeat;
                    const uint32_t segmentCount = actualN - segmentStart < FloatRepeat
                        ? actualN - segmentStart : FloatRepeat;
                    if (laneRows > 0) {
                        WholeReduceMax(
                            segmentMax[segment * RowsPerLane * 2], tile[segmentStart],
                            static_cast<int32_t>(segmentCount),
                            static_cast<int32_t>(laneRows), 1, 1,
                            static_cast<int32_t>(TileN / 8),
                            ReduceOrder::ORDER_ONLY_VALUE);
                    }
                }
                if (laneRows > 0) {
                    SetFlag<HardEvent::V_S>(0);
                    WaitFlag<HardEvent::V_S>(0);
                    for (uint32_t row = 0; row < laneRows; ++row) {
                        float best = rowMax.GetValue(row);
                        for (uint32_t segment = 0; segment < activeSegments;
                            ++segment) {
                            const float value = segmentMax.GetValue(
                                segment * RowsPerLane * 2 + row);
                            best = value > best ? value : best;
                        }
                        rowMax.SetValue(row, best);
                    }
                }
                if (sequence + kMixedStageBuffers < iterationsForCore) {
                    // This acknowledgement follows the MTE3 write of the
                    // per-tile partial maxima.  PIPE_S is not a valid producer
                    // for this cross-core event on dav-2201 and faults as an
                    // illegal AIV instruction once a stage buffer is reused.
                    CrossCoreSetFlag<kMixedSyncMode, PIPE_MTE3>(
                        kMixedReusableFlagBase + pingPong);
                }
            }

            const uint64_t partialBase = task * TileM + laneRowBase;
            SetFlag<HardEvent::S_MTE3>(0);
            WaitFlag<HardEvent::S_MTE3>(0);
            DataCopy(partialMax[partialBase], rowMax, RowsPerLane);
            SetFlag<HardEvent::MTE3_S>(0);
            WaitFlag<HardEvent::MTE3_S>(0);
        }
    }

    SyncAll<false>();

    if ASCEND_IS_AIV {
        constexpr uint32_t RowsPerLane = TileM / kMixedVectorRatio;
        TBuf<TPosition::VECCALC> batchSumBuffer;
        pipe.InitBuffer(batchSumBuffer, kMaxOutputBatches * sizeof(float));
        LocalTensor<float> batchSums = batchSumBuffer.Get<float>();
        for (uint32_t batch = 0; batch < kMaxOutputBatches; ++batch) {
            batchSums.SetValue(batch, 0.0f);
        }

        const uint32_t vectorBlocks = cubeBlocks * taskRatio;
        const uint64_t laneTaskCount = bmTaskCount * kMixedVectorRatio;
        for (uint64_t laneTask = rawBlock; laneTask < laneTaskCount;
             laneTask += vectorBlocks) {
            const uint64_t bmTask = laneTask / kMixedVectorRatio;
            const uint32_t lane = static_cast<uint32_t>(
                laneTask % kMixedVectorRatio);
            const uint64_t batch = bmTask / mGroups;
            const uint64_t mGroup = bmTask - batch * mGroups;
            const uint64_t rowBase = mGroup * TileM;
            const uint32_t actualM = static_cast<uint32_t>(
                shape.m - static_cast<int64_t>(rowBase) < TileM
                    ? shape.m - static_cast<int64_t>(rowBase) : TileM);
            const uint32_t laneRowBase = lane * RowsPerLane;
            const uint32_t laneRows = actualM > laneRowBase
                ? (actualM - laneRowBase < RowsPerLane
                       ? actualM - laneRowBase : RowsPerLane)
                : 0;
            float taskSum = 0.0f;
            for (uint32_t row = 0; row < laneRows; ++row) {
                float best = -__builtin_inff();
                for (uint32_t nGroup = 0; nGroup < nGroups; ++nGroup) {
                    const uint64_t task = bmTask * nGroups + nGroup;
                    const float value = partialMax.GetValue(
                        task * TileM + laneRowBase + row);
                    best = value > best ? value : best;
                }
                taskSum += best;
            }
            const uint32_t batchIndex = static_cast<uint32_t>(batch);
            batchSums.SetValue(
                batchIndex, batchSums.GetValue(batchIndex) + taskSum);
        }

        const uint64_t partialBase =
            static_cast<uint64_t>(rawBlock) * kMaxOutputBatches;
        SetFlag<HardEvent::S_MTE3>(0);
        WaitFlag<HardEvent::S_MTE3>(0);
        DataCopy(partialSums[partialBase], batchSums, kMaxOutputBatches);
        SetFlag<HardEvent::MTE3_S>(0);
        WaitFlag<HardEvent::MTE3_S>(0);
    }

    SyncAll<false>();

    if ASCEND_IS_AIV {
        const uint32_t vectorBlocks = cubeBlocks * taskRatio;
        // Keep the final B<=64 reduction on one well-defined AIV sub-block.
        // Direct MIX launches expose only the paired sub-block IDs reliably at
        // this point; distributing batches by rawBlock can leave higher batch
        // outputs unwritten even though every worker partial is available.
        if (rawBlock == 0) {
            for (uint32_t batch = 0; batch < static_cast<uint32_t>(shape.b);
                 ++batch) {
                float total = 0.0f;
                for (uint32_t worker = 0; worker < vectorBlocks; ++worker) {
                    total += partialSums.GetValue(
                        static_cast<uint64_t>(worker) * kMaxOutputBatches + batch);
                }
                output.SetValue(batch, total);
            }
        }
    }
}

template<class T, bool TX1, bool TX2,
         uint32_t TileM, uint32_t TileN, uint32_t TileK>
inline void LaunchBatchMatmulMaxSumMixed(
        GM_ADDR x1, GM_ADDR x2, GM_ADDR workspace, GM_ADDR y,
        GM_ADDR cubeTiling, Shape shape,
        uint32_t cubeBlocks, uint32_t nGroups, aclrtStream stream) {
    BatchMatmulMaxSumMixed<T, TX1, TX2, TileM, TileN, TileK>
        <<<cubeBlocks, nullptr, stream>>>(
            x1, x2, workspace, y, cubeTiling, shape, cubeBlocks, nGroups);
}

template<class T, uint32_t TileM, uint32_t TileN, uint32_t TileK>
inline void LaunchBatchMatmulMaxSumMixedByTranspose(
        GM_ADDR x1, GM_ADDR x2, GM_ADDR workspace, GM_ADDR y,
        GM_ADDR cubeTiling, Shape shape,
        uint32_t cubeBlocks, uint32_t nGroups, aclrtStream stream,
        bool transposeX1, bool transposeX2) {
    if (transposeX1 && transposeX2) {
        LaunchBatchMatmulMaxSumMixed<T, true, true, TileM, TileN, TileK>(
            x1, x2, workspace, y, cubeTiling, shape, cubeBlocks, nGroups, stream);
    } else if (transposeX1) {
        LaunchBatchMatmulMaxSumMixed<T, true, false, TileM, TileN, TileK>(
            x1, x2, workspace, y, cubeTiling, shape, cubeBlocks, nGroups, stream);
    } else if (transposeX2) {
        LaunchBatchMatmulMaxSumMixed<T, false, true, TileM, TileN, TileK>(
            x1, x2, workspace, y, cubeTiling, shape, cubeBlocks, nGroups, stream);
    } else {
        LaunchBatchMatmulMaxSumMixed<T, false, false, TileM, TileN, TileK>(
            x1, x2, workspace, y, cubeTiling, shape, cubeBlocks, nGroups, stream);
    }
}

}  // namespace bmms
// ===== END kernels/mixed.asc =====

// ===== BEGIN kernels/kernel_dispatch.asc =====
namespace bmms {

// The direct-invocation ABI has no external workspace argument. Keep one
// workspace per stream and exact plan so run_kernel can enqueue one MIX task
// and return without releasing in-flight memory. Device reset reclaims these
// process-lifetime allocations after evaluation.
struct ExecutionResourceKey {
    aclrtStream stream;
    TilingKey tilingKey;
    Shape shape;
    int32_t inputDtype;
    bool transposeX1;
    bool transposeX2;
    uint32_t launchBlocks;
    uint32_t splitN;
    uint64_t workspaceBytes;
};

struct CachedExecutionResources {
    ExecutionResourceKey key;
    GM_ADDR workspace;
    uint64_t workspaceBytes;
    GM_ADDR cubeTiling;
};

inline bool SameExecutionResourceKey(
        const ExecutionResourceKey& lhs, const ExecutionResourceKey& rhs) {
    return lhs.stream == rhs.stream && lhs.tilingKey == rhs.tilingKey &&
           lhs.shape.b == rhs.shape.b && lhs.shape.m == rhs.shape.m &&
           lhs.shape.n == rhs.shape.n && lhs.shape.k == rhs.shape.k &&
           lhs.inputDtype == rhs.inputDtype &&
           lhs.transposeX1 == rhs.transposeX1 &&
           lhs.transposeX2 == rhs.transposeX2 &&
           lhs.launchBlocks == rhs.launchBlocks &&
           lhs.splitN == rhs.splitN &&
           lhs.workspaceBytes == rhs.workspaceBytes;
}

inline std::vector<CachedExecutionResources>& ExecutionResourceCache() {
    static std::vector<CachedExecutionResources> cache;
    return cache;
}

inline std::atomic_flag& ExecutionResourceCacheLock() {
    static std::atomic_flag lock = ATOMIC_FLAG_INIT;
    return lock;
}

class ExecutionResourceCacheGuard {
public:
    ExecutionResourceCacheGuard() {
        while (ExecutionResourceCacheLock().test_and_set(std::memory_order_acquire)) {
        }
    }

    ~ExecutionResourceCacheGuard() {
        ExecutionResourceCacheLock().clear(std::memory_order_release);
    }

    ExecutionResourceCacheGuard(const ExecutionResourceCacheGuard&) = delete;
    ExecutionResourceCacheGuard& operator=(const ExecutionResourceCacheGuard&) = delete;
};

inline GM_ADDR AllocatePersistentDeviceBuffer(uint64_t bytes, const char* operation) {
    if (bytes == 0) {
        throw std::invalid_argument("Persistent device buffer must not be empty");
    }
    void* address = nullptr;
    CheckAcl(aclrtMalloc(&address, static_cast<size_t>(bytes), ACL_MEM_MALLOC_HUGE_FIRST),
             operation);
    return static_cast<uint8_t*>(address);
}

inline ExecutionResourceKey MakeExecutionResourceKey(
        const Plan& plan, aclrtStream stream, int32_t inputDtype,
        bool transposeX1, bool transposeX2) {
    return ExecutionResourceKey{
        stream,
        plan.key,
        Shape{plan.tiling.b, plan.tiling.m, plan.tiling.n, plan.tiling.k},
        inputDtype,
        transposeX1,
        transposeX2,
        plan.tiling.launchBlocks,
        plan.tiling.splitN,
        plan.tiling.workspaceBytes};
}

template<class Factory>
inline CachedExecutionResources GetOrCreateExecutionResources(
        const ExecutionResourceKey& key, Factory factory) {
    ExecutionResourceCacheGuard guard;
    for (const auto& resources : ExecutionResourceCache()) {
        if (SameExecutionResourceKey(resources.key, key)) {
            return resources;
        }
    }
    CachedExecutionResources resources = factory();
    ExecutionResourceCache().push_back(resources);
    return resources;
}

inline CachedExecutionResources GetReferenceExecutionResources(
        const Plan& plan, aclrtStream stream, int32_t inputDtype,
        bool transposeX1, bool transposeX2) {
    const ExecutionResourceKey key = MakeExecutionResourceKey(
        plan, stream, inputDtype, transposeX1, transposeX2);
    return GetOrCreateExecutionResources(key, [&]() {
        return CachedExecutionResources{
            key,
            AllocatePersistentDeviceBuffer(
                plan.tiling.workspaceBytes, "aclrtMalloc(reference workspace cache)"),
            plan.tiling.workspaceBytes,
            nullptr};
    });
}

template<uint32_t TileM, uint32_t TileN, uint32_t TileK>
inline CachedExecutionResources GetMixedExecutionResources(
        const Plan& plan, aclrtStream stream, int32_t inputDtype,
        bool transposeX1, bool transposeX2) {
    const Shape shape{plan.tiling.b, plan.tiling.m, plan.tiling.n, plan.tiling.k};
    const ExecutionResourceKey key = MakeExecutionResourceKey(
        plan, stream, inputDtype, transposeX1, transposeX2);
    return GetOrCreateExecutionResources(key, [&]() {
        const AscendC::tiling::TCubeTiling cubeTiling =
            MakeBmCubeTiling<TileM, TileN, TileK>(
                shape, inputDtype, transposeX1, transposeX2);
        return CachedExecutionResources{
            key,
            AllocatePersistentDeviceBuffer(
                plan.tiling.workspaceBytes, "aclrtMalloc(MIX workspace cache)"),
            plan.tiling.workspaceBytes,
            UploadPersistentCubeTiling(cubeTiling)};
    });
}

inline void ExecuteReferencePlan(const Plan& plan, GM_ADDR x1, GM_ADDR x2, GM_ADDR y,
                                 int32_t inputDtype, aclrtStream stream,
                                 bool transposeX1, bool transposeX2) {
    const CachedExecutionResources resources = GetReferenceExecutionResources(
        plan, stream, inputDtype, transposeX1, transposeX2);
    GM_ADDR atomicOutput = resources.workspace;
    const Shape shape{plan.tiling.b, plan.tiling.m, plan.tiling.n, plan.tiling.k};
    CheckAcl(aclrtMemsetAsync(
                 atomicOutput, static_cast<size_t>(resources.workspaceBytes), 0,
                 static_cast<size_t>(resources.workspaceBytes), stream),
             "aclrtMemsetAsync(reference atomic output)");

    if (inputDtype == 1) {
        LaunchRowMax<half>(x1, x2, atomicOutput, shape, plan.tiling.launchBlocks,
                           stream, transposeX1, transposeX2);
    } else {
        LaunchRowMax<bfloat16_t>(x1, x2, atomicOutput, shape, plan.tiling.launchBlocks,
                                 stream, transposeX1, transposeX2);
    }
    const size_t outputBytes = static_cast<size_t>(shape.b) * sizeof(float);
    CheckAcl(aclrtMemcpyAsync(y, outputBytes, atomicOutput, outputBytes,
                              ACL_MEMCPY_DEVICE_TO_DEVICE, stream),
             "aclrtMemcpyAsync(reference atomic output to y)");
}

template<uint32_t TileM, uint32_t TileN, uint32_t TileK>
inline void ExecuteMixedPlan(
        const Plan& plan, GM_ADDR x1, GM_ADDR x2, GM_ADDR y,
        int32_t inputDtype, aclrtStream stream,
        bool transposeX1, bool transposeX2) {
    const Shape shape{plan.tiling.b, plan.tiling.m, plan.tiling.n, plan.tiling.k};
    const CachedExecutionResources resources =
        GetMixedExecutionResources<TileM, TileN, TileK>(
            plan, stream, inputDtype, transposeX1, transposeX2);
    if (inputDtype == 1) {
        LaunchBatchMatmulMaxSumMixedByTranspose<half, TileM, TileN, TileK>(
            x1, x2, resources.workspace, y, resources.cubeTiling, shape,
            plan.tiling.launchBlocks, plan.tiling.splitN, stream,
            transposeX1, transposeX2);
    } else {
        LaunchBatchMatmulMaxSumMixedByTranspose<bfloat16_t, TileM, TileN, TileK>(
            x1, x2, resources.workspace, y, resources.cubeTiling, shape,
            plan.tiling.launchBlocks, plan.tiling.splitN, stream,
            transposeX1, transposeX2);
    }
}

inline void ExecutePlan(const Plan& plan, GM_ADDR x1, GM_ADDR x2, GM_ADDR y,
                        int32_t inputDtype, aclrtStream stream,
                        bool transposeX1, bool transposeX2) {
    switch (plan.path) {
        case KernelPath::REFERENCE:
            ExecuteReferencePlan(plan, x1, x2, y, inputDtype, stream,
                                 transposeX1, transposeX2);
            return;
        case KernelPath::BM:
            switch (plan.key) {
                case TilingKey::BM_16X128X64:
                    ExecuteMixedPlan<16, 128, 64>(plan, x1, x2, y, inputDtype, stream,
                                                   transposeX1, transposeX2);
                    return;
                case TilingKey::BM_32X128X64:
                    ExecuteMixedPlan<32, 128, 64>(plan, x1, x2, y, inputDtype, stream,
                                                   transposeX1, transposeX2);
                    return;
                case TilingKey::BM_32X256X64:
                    ExecuteMixedPlan<32, 256, 64>(plan, x1, x2, y, inputDtype, stream,
                                                   transposeX1, transposeX2);
                    return;
                case TilingKey::BM_64X128X128:
                    ExecuteMixedPlan<64, 128, 128>(plan, x1, x2, y, inputDtype, stream,
                                                    transposeX1, transposeX2);
                    return;
                default:
                    throw std::invalid_argument("Selected BM MIX kernel is not implemented");
            }
        case KernelPath::BMN:
            switch (plan.key) {
                case TilingKey::BMN_16X256X64_P2:
                case TilingKey::BMN_16X256X64_P4:
                    ExecuteMixedPlan<16, 256, 64>(plan, x1, x2, y, inputDtype, stream,
                                                   transposeX1, transposeX2);
                    return;
                default:
                    throw std::invalid_argument("Selected BMN MIX kernel is not implemented");
            }
    }
    throw std::invalid_argument("Selected kernel path is invalid");
}

}  // namespace bmms
// ===== END kernels/kernel_dispatch.asc =====

// ===== BEGIN kernel.asc =====
// Included by the local or competition Host driver.

extern "C" void run_kernel(GM_ADDR x1, const TensorGroupInfo& info_x1,
    GM_ADDR x2, const TensorGroupInfo& info_x2, GM_ADDR y, const TensorGroupInfo& info_y,
    int64_t availableCoreNum, aclrtStream stream, bool transposeX1, bool transposeX2) {
    const bmms::Shape shape = bmms::ValidateInputs(
        x1, info_x1, x2, info_x2, y, info_y, transposeX1, transposeX2);
    const bmms::TilingKey key = bmms::SelectTilingKey(
        shape, availableCoreNum, info_x1.tensors[0].dtype, transposeX1, transposeX2);
    const bmms::StaticTilingConfig* config = bmms::FindTilingConfig(key);
    const int64_t computeCoreNum = config->path == bmms::KernelPath::REFERENCE
        ? availableCoreNum : bmms::QueryCubeCoreCount();
    const bmms::Plan plan = bmms::MakePlan(shape, computeCoreNum, key);
    bmms::ExecutePlan(plan, x1, x2, y, info_x1.tensors[0].dtype, stream,
                      transposeX1, transposeX2);
}
// ===== END kernel.asc =====
