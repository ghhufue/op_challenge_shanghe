namespace bmms {

inline void CheckAcl(aclError status, const char* operation) {
    if (status != ACL_SUCCESS) {
        throw std::runtime_error(std::string(operation) + ": " + std::to_string(status));
    }
}

inline int64_t QueryCoreCount(aclrtDevAttr attribute, const char* name) {
    int32_t deviceId = 0;
    CheckAcl(aclrtGetDevice(&deviceId), "aclrtGetDevice");
    int64_t count = 0;
    CheckAcl(aclrtGetDeviceInfo(deviceId, attribute, &count), name);
    if (count < 1) {
        throw std::runtime_error(std::string("No ") + name + " are available");
    }
    return count;
}

inline int64_t QueryCubeCoreCount() {
    return QueryCoreCount(ACL_DEV_ATTR_CUBE_CORE_NUM, "Cube core count");
}

inline int64_t QueryVectorCoreCount() {
    return QueryCoreCount(ACL_DEV_ATTR_VECTOR_CORE_NUM, "Vector core count");
}

class DeviceAllocation {
public:
    explicit DeviceAllocation(uint64_t bytes) : bytes_(bytes) {
        if (bytes_ == 0) {
            throw std::invalid_argument("Device allocation size must be positive");
        }
        CheckAcl(aclrtMalloc(&address_, static_cast<size_t>(bytes_), ACL_MEM_MALLOC_HUGE_FIRST),
                 "aclrtMalloc");
    }

    ~DeviceAllocation() {
        if (address_ != nullptr) {
            aclrtFree(address_);
        }
    }

    DeviceAllocation(const DeviceAllocation&) = delete;
    DeviceAllocation& operator=(const DeviceAllocation&) = delete;

    DeviceAllocation(DeviceAllocation&& other) noexcept
        : address_(other.address_), bytes_(other.bytes_) {
        other.address_ = nullptr;
        other.bytes_ = 0;
    }

    DeviceAllocation& operator=(DeviceAllocation&&) = delete;

    GM_ADDR Address() const {
        return static_cast<uint8_t*>(address_);
    }

    uint64_t Bytes() const {
        return bytes_;
    }

private:
    void* address_ = nullptr;
    uint64_t bytes_ = 0;
};

}  // namespace bmms
// ===== END host/acl_runtime.h =====

// ===== BEGIN host/input_validation.h =====
namespace bmms {

inline Shape ValidateInputs(GM_ADDR x1, const TensorGroupInfo& infoX1,
                            GM_ADDR x2, const TensorGroupInfo& infoX2,
                            GM_ADDR y, const TensorGroupInfo& infoY,
                            bool transposeX1, bool transposeX2) {
    if (x1 == nullptr || x2 == nullptr || y == nullptr) {
        throw std::invalid_argument("Input and output device addresses must be non-null");
    }
    if (infoX1.numTensors != 1 || infoX2.numTensors != 1 || infoY.numTensors != 1 ||
        infoX1.tensors == nullptr || infoX2.tensors == nullptr || infoY.tensors == nullptr) {
        throw std::invalid_argument("Each tensor group must contain exactly one tensor");
    }

    const auto& lhs = infoX1.tensors[0];
    const auto& rhs = infoX2.tensors[0];
    const auto& output = infoY.tensors[0];
    if (lhs.shape == nullptr || rhs.shape == nullptr || output.shape == nullptr ||
        lhs.numDims != 3 || rhs.numDims != 3 || output.numDims != 1) {
        throw std::invalid_argument("Expected rank-3 inputs and a rank-1 output");
    }
    if ((lhs.dtype != 1 && lhs.dtype != 2) || rhs.dtype != lhs.dtype || output.dtype != 0) {
        throw std::invalid_argument("Expected matching FP16/BF16 inputs and FP32 output");
    }

    Shape shape{
        lhs.shape[0],
        transposeX1 ? lhs.shape[2] : lhs.shape[1],
        transposeX2 ? rhs.shape[1] : rhs.shape[2],
        transposeX1 ? lhs.shape[1] : lhs.shape[2]
    };
    const int64_t rhsK = transposeX2 ? rhs.shape[2] : rhs.shape[1];
    if (rhs.shape[0] != shape.b || rhsK != shape.k || output.shape[0] != shape.b) {
        throw std::invalid_argument("Input/output shapes are inconsistent");
    }
    if (shape.b < 1 || shape.b > 64 || shape.m < 1 || shape.m > 8192 ||
        shape.n < 1 || shape.n > 8192 || shape.k < 32 || shape.k > 8192 ||
        shape.k % 8 != 0 || shape.b * shape.m * shape.k > (1LL << 26) ||
        shape.b * shape.n * shape.k > (1LL << 26)) {
        throw std::invalid_argument("Shape is outside the supported problem range");
    }
    return shape;
}

}  // namespace bmms
// ===== END host/input_validation.h =====

// ===== BEGIN host/bm_tiling.h =====
namespace bmms {

template<uint32_t TileM, uint32_t TileN, uint32_t TileK>
inline optiling::TCubeTiling MakeBmCubeTiling(
        const Shape& shape, int32_t inputDtype, bool transposeX1, bool transposeX2) {
    static_assert(TileM > 0 && TileN > 0 && TileK > 0, "BM tile sizes must be positive");
    const char* socName = aclrtGetSocName();
    if (socName == nullptr) {
        throw std::runtime_error("aclrtGetSocName returned null");
    }
    auto* platform = platform_ascendc::PlatformAscendCManager::GetInstance(socName);
    if (platform == nullptr) {
        throw std::runtime_error("Failed to initialize AscendC platform information");
    }

    const matmul_tiling::DataType dataType = inputDtype == 1
        ? matmul_tiling::DataType::DT_FLOAT16
        : matmul_tiling::DataType::DT_BF16;
    matmul_tiling::MatmulApiTiling tiling(*platform);
    if (tiling.SetAType(matmul_tiling::TPosition::GM, matmul_tiling::CubeFormat::ND,
                        dataType, transposeX1) != 0 ||
        tiling.SetBType(matmul_tiling::TPosition::GM, matmul_tiling::CubeFormat::ND,
                        dataType, transposeX2) != 0 ||
        tiling.SetCType(matmul_tiling::TPosition::GM, matmul_tiling::CubeFormat::ND,
                        matmul_tiling::DataType::DT_FLOAT) != 0 ||
        tiling.SetBiasType(matmul_tiling::TPosition::GM, matmul_tiling::CubeFormat::ND,
                           matmul_tiling::DataType::DT_FLOAT) != 0 ||
        tiling.SetShape(static_cast<int32_t>(TileM), static_cast<int32_t>(TileN),
                        static_cast<int32_t>(shape.k)) != 0 ||
        tiling.SetOrgShape(static_cast<int32_t>(shape.m), static_cast<int32_t>(shape.n),
                           static_cast<int32_t>(shape.k)) != 0 ||
        tiling.SetFixSplit(static_cast<int32_t>(TileM), static_cast<int32_t>(TileN),
                           static_cast<int32_t>(TileK)) != 0 ||
        tiling.EnableBias(false) != 0 ||
        tiling.SetBufferSpace(-1, -1, -1) != 0) {
        throw std::runtime_error("Failed to configure BM Matmul tiling");
    }

    optiling::TCubeTiling result;
    if (tiling.GetTiling(result) != 0) {
        throw std::runtime_error("Failed to generate BM Matmul tiling");
    }
    return result;
}

struct PersistentCubeTiling {
    GM_ADDR deviceAddress;
    void* hostAddress;
    uint64_t bytes;
};

// Cached execution resources own both allocations for the process lifetime.
// Pinned Host memory keeps the source valid until the stream reaches the
// asynchronous H2D copy; the Device buffer then remains valid for every
// cached Matmul launch.
inline PersistentCubeTiling UploadPersistentCubeTiling(
        optiling::TCubeTiling& tiling, aclrtStream stream) {
    const uint64_t bytes = static_cast<uint64_t>(tiling.GetDataSize());
    if (bytes == 0) {
        throw std::runtime_error("Matmul tiling data must not be empty");
    }

    void* hostAddress = nullptr;
    CheckAcl(aclrtMallocHost(&hostAddress, static_cast<size_t>(bytes)),
             "aclrtMallocHost(persistent Matmul tiling)");
    tiling.SaveToBuffer(static_cast<uint8_t*>(hostAddress), static_cast<size_t>(bytes));

    void* deviceAddress = nullptr;
    const aclError mallocStatus = aclrtMalloc(
        &deviceAddress, static_cast<size_t>(bytes), ACL_MEM_MALLOC_HUGE_FIRST);
    if (mallocStatus != ACL_SUCCESS) {
        aclrtFreeHost(hostAddress);
        CheckAcl(mallocStatus, "aclrtMalloc(persistent Matmul tiling)");
    }

    const aclError copyStatus = aclrtMemcpyAsync(
        deviceAddress, static_cast<size_t>(bytes), hostAddress,
        static_cast<size_t>(bytes), ACL_MEMCPY_HOST_TO_DEVICE, stream);
    if (copyStatus != ACL_SUCCESS) {
        aclrtFree(deviceAddress);
        aclrtFreeHost(hostAddress);
        CheckAcl(copyStatus, "aclrtMemcpyAsync(Matmul tiling H2D)");
    }
    return PersistentCubeTiling{
        static_cast<uint8_t*>(deviceAddress), hostAddress, bytes};
}

}  // namespace bmms
// ===== END host/bm_tiling.h =====

// ===== BEGIN kernels/reference.asc =====
namespace bmms {

__aicore__ inline uint32_t AtomicOutputElements(int64_t batches) {
    return static_cast<uint32_t>(
        (batches + kAtomicAlignmentFloats - 1) / kAtomicAlignmentFloats *
        kAtomicAlignmentFloats);
}

__aicore__ inline void AtomicAddBatchSums(
        AscendC::GlobalTensor<float>& atomicOutput,
        AscendC::LocalTensor<float>& localSums, uint32_t elementCount) {
    AscendC::SetFlag<AscendC::HardEvent::S_MTE3>(0);
    AscendC::WaitFlag<AscendC::HardEvent::S_MTE3>(0);
    AscendC::SetAtomicAdd<float>();
    AscendC::DataCopy(atomicOutput, localSums, elementCount);
    AscendC::DisableDmaAtomic();
}

template<class T>
__aicore__ inline float Decode(uint16_t bits) {
    union {
        uint16_t bits;
        half value;
    } value;
    value.bits = bits;
    return static_cast<float>(value.value);
}

template<>
__aicore__ inline float Decode<bfloat16_t>(uint16_t bits) {
    union {
        uint32_t bits;
        float value;
    } value;
    value.bits = static_cast<uint32_t>(bits) << 16;
    return value.value;
}

// Correctness path. Each worker owns complete (batch, row) tasks, accumulates
// per-batch sums in UB, then issues exactly one aligned atomic GM write.
template<class T, bool TX1, bool TX2>
__global__ __vector__ void RowMax(GM_ADDR x1, GM_ADDR x2, GM_ADDR atomicOutputAddress,
                                  Shape shape, int64_t taskCount,
                                  int64_t workerCount) {
    AscendC::GlobalTensor<uint16_t> lhs;
    AscendC::GlobalTensor<uint16_t> rhs;
    AscendC::GlobalTensor<float> atomicOutput;
    lhs.SetGlobalBuffer(reinterpret_cast<__gm__ uint16_t*>(x1));
    rhs.SetGlobalBuffer(reinterpret_cast<__gm__ uint16_t*>(x2));
    atomicOutput.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(atomicOutputAddress));

    AscendC::TPipe pipe;
    AscendC::TBuf<AscendC::TPosition::VECCALC> atomicBuffer;
    pipe.InitBuffer(atomicBuffer, kMaxOutputBatches * sizeof(float));
    auto localSums = atomicBuffer.Get<float>();
    const uint32_t atomicElements = AtomicOutputElements(shape.b);
    for (uint32_t index = 0; index < atomicElements; ++index) {
        localSums.SetValue(index, 0.0f);
    }

    const int64_t workerId = AscendC::GetBlockIdx();
    for (int64_t taskId = workerId; taskId < taskCount; taskId += workerCount) {
        const int64_t batch = taskId / shape.m;
        const int64_t row = taskId - batch * shape.m;
        float best = -__builtin_inff();

        for (int64_t column = 0; column < shape.n; ++column) {
            float dot = 0.0f;
            for (int64_t depth = 0; depth < shape.k; ++depth) {
                const uint64_t lhsIndex = static_cast<uint64_t>(batch) * shape.m * shape.k +
                    (TX1 ? static_cast<uint64_t>(depth) * shape.m + row
                         : static_cast<uint64_t>(row) * shape.k + depth);
                const uint64_t rhsIndex = static_cast<uint64_t>(batch) * shape.n * shape.k +
                    (TX2 ? static_cast<uint64_t>(column) * shape.k + depth
                         : static_cast<uint64_t>(depth) * shape.n + column);
                dot += Decode<T>(lhs.GetValue(lhsIndex)) * Decode<T>(rhs.GetValue(rhsIndex));
            }
            best = dot > best ? dot : best;
        }
        const uint32_t batchIndex = static_cast<uint32_t>(batch);
        localSums.SetValue(batchIndex, localSums.GetValue(batchIndex) + best);
    }
    AtomicAddBatchSums(atomicOutput, localSums, atomicElements);
}

template<class T>
void LaunchRowMax(GM_ADDR x1, GM_ADDR x2, GM_ADDR atomicOutput, Shape shape,
                  int64_t workerCount, aclrtStream stream,
                  bool transposeX1, bool transposeX2) {
    const int64_t taskCount = shape.b * shape.m;
    if (transposeX1 && transposeX2) {
        RowMax<T, true, true><<<workerCount, nullptr, stream>>>(
            x1, x2, atomicOutput, shape, taskCount, workerCount);
    } else if (transposeX1) {
        RowMax<T, true, false><<<workerCount, nullptr, stream>>>(
            x1, x2, atomicOutput, shape, taskCount, workerCount);
    } else if (transposeX2) {
        RowMax<T, false, true><<<workerCount, nullptr, stream>>>(
            x1, x2, atomicOutput, shape, taskCount, workerCount);
    } else {
        RowMax<T, false, false><<<workerCount, nullptr, stream>>>(
            x1, x2, atomicOutput, shape, taskCount, workerCount);
    }
}

}  // namespace bmms
// ===== END kernels/reference.asc =====

// ===== BEGIN kernels/bm.asc =====
#define ASCENDC_CUBE_ONLY
#include "lib/matmul_intf.h"
#undef ASCENDC_CUBE_ONLY

namespace bmms {

__aicore__ inline void LoadBmCubeTiling(GM_ADDR source, TCubeTiling& destination) {
    auto* sourceWords = reinterpret_cast<__gm__ uint32_t*>(source);
    auto* destinationWords = reinterpret_cast<uint32_t*>(&destination);
    for (uint32_t index = 0; index < sizeof(TCubeTiling) / sizeof(uint32_t); ++index) {
        destinationWords[index] = sourceWords[index];
    }
}

template<class T, bool TX1, bool TX2,
         uint32_t TileM, uint32_t TileN, uint32_t TileK>
__global__ __aicore__ void BmMatmul(
        GM_ADDR x1, GM_ADDR x2, GM_ADDR stage, GM_ADDR cubeTiling,
        Shape shape, uint64_t taskBase, uint32_t waveTasks, uint32_t columnBase) {
    KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_AIC_ONLY);
    const uint32_t block = AscendC::GetBlockIdx();
    if (block >= waveTasks) {
        return;
    }

    const uint64_t mGroups = (static_cast<uint64_t>(shape.m) + TileM - 1) / TileM;
    const uint64_t task = taskBase + block;
    const uint64_t batch = task / mGroups;
    const uint64_t rowBase = (task - batch * mGroups) * TileM;
    const uint32_t actualM = static_cast<uint32_t>(
        shape.m - static_cast<int64_t>(rowBase) < TileM
            ? shape.m - static_cast<int64_t>(rowBase) : TileM);
    const uint32_t actualN = static_cast<uint32_t>(
        shape.n - static_cast<int64_t>(columnBase) < TileN
            ? shape.n - static_cast<int64_t>(columnBase) : TileN);

    AscendC::GlobalTensor<T> lhs;
    AscendC::GlobalTensor<T> rhs;
    AscendC::GlobalTensor<float> output;
    lhs.SetGlobalBuffer(reinterpret_cast<__gm__ T*>(x1));
    rhs.SetGlobalBuffer(reinterpret_cast<__gm__ T*>(x2));
    output.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(stage));

    const uint64_t lhsBatch = batch * static_cast<uint64_t>(shape.m) * shape.k;
    const uint64_t rhsBatch = batch * static_cast<uint64_t>(shape.n) * shape.k;
    const uint64_t lhsOffset = lhsBatch +
        (TX1 ? rowBase : rowBase * static_cast<uint64_t>(shape.k));
    const uint64_t rhsOffset = rhsBatch +
        (TX2 ? static_cast<uint64_t>(columnBase) * shape.k : columnBase);
    const uint64_t outputOffset = static_cast<uint64_t>(block) * TileM * TileN;

    using AType = AscendC::MatmulType<AscendC::TPosition::GM, CubeFormat::ND, T, TX1>;
    using BType = AscendC::MatmulType<AscendC::TPosition::GM, CubeFormat::ND, T, TX2>;
    using CType = AscendC::MatmulType<AscendC::TPosition::GM, CubeFormat::ND, float>;
    AscendC::Matmul<AType, BType, CType, CType, CFG_MDL> matmul;
    AscendC::TPipe pipe;
    TCubeTiling localTiling;
    LoadBmCubeTiling(cubeTiling, localTiling);
    matmul.Init(&localTiling, &pipe);
    matmul.SetOrgShape(static_cast<int>(shape.m), static_cast<int>(shape.n),
                       static_cast<int>(shape.k), static_cast<int>(shape.k),
                       static_cast<int>(TileN));
    matmul.SetTensorA(lhs[lhsOffset], TX1);
    matmul.SetTensorB(rhs[rhsOffset], TX2);
    matmul.SetTail(static_cast<int>(actualM), static_cast<int>(actualN),
                   static_cast<int>(shape.k));
    matmul.IterateAll(output[outputOffset]);
    matmul.End();
}

template<uint32_t TileM, uint32_t TileN>
__global__ __vector__ void UpdateBmRowMax(
        GM_ADDR stageAddress, GM_ADDR rowMaxAddress, GM_ADDR atomicOutputAddress,
        Shape shape,
        uint64_t taskBase, uint32_t waveTasks, uint32_t workerCount,
        uint32_t columnBase, uint32_t finalize) {
    static_assert(TileM * sizeof(float) % 32 == 0,
                  "BM row-max tiles must be 32-byte aligned for DataCopy");
    AscendC::GlobalTensor<float> stage;
    AscendC::GlobalTensor<float> rowMax;
    AscendC::GlobalTensor<float> atomicOutput;
    stage.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(stageAddress));
    rowMax.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(rowMaxAddress));
    atomicOutput.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(atomicOutputAddress));

    AscendC::TPipe pipe;
    AscendC::TBuf<AscendC::TPosition::VECCALC> rowMaxBuffer;
    AscendC::TBuf<AscendC::TPosition::VECCALC> atomicBuffer;
    pipe.InitBuffer(rowMaxBuffer, TileM * sizeof(float));
    pipe.InitBuffer(atomicBuffer, kMaxOutputBatches * sizeof(float));
    auto taskRowMax = rowMaxBuffer.Get<float>();
    auto localSums = atomicBuffer.Get<float>();
    const uint32_t atomicElements = AtomicOutputElements(shape.b);
    if (finalize != 0) {
        for (uint32_t index = 0; index < atomicElements; ++index) {
            localSums.SetValue(index, 0.0f);
        }
    }

    const uint64_t mGroups = (static_cast<uint64_t>(shape.m) + TileM - 1) / TileM;
    const uint32_t actualN = static_cast<uint32_t>(
        shape.n - static_cast<int64_t>(columnBase) < TileN
            ? shape.n - static_cast<int64_t>(columnBase) : TileN);
    for (uint32_t slot = AscendC::GetBlockIdx(); slot < waveTasks; slot += workerCount) {
        const uint64_t task = taskBase + slot;
        const uint64_t batch = task / mGroups;
        const uint64_t rowBase = (task - batch * mGroups) * TileM;
        const uint32_t actualM = static_cast<uint32_t>(
            shape.m - static_cast<int64_t>(rowBase) < TileM
                ? shape.m - static_cast<int64_t>(rowBase) : TileM);
        const uint64_t stageBase = static_cast<uint64_t>(slot) * TileM * TileN;
        const uint64_t rowMaxBase = task * TileM;
        if (columnBase == 0) {
            for (uint32_t row = 0; row < TileM; ++row) {
                taskRowMax.SetValue(row, -__builtin_inff());
            }
        } else {
            AscendC::DataCopy(taskRowMax, rowMax[rowMaxBase], TileM);
            AscendC::SetFlag<AscendC::HardEvent::MTE2_S>(0);
            AscendC::WaitFlag<AscendC::HardEvent::MTE2_S>(0);
        }
        for (uint32_t row = 0; row < actualM; ++row) {
            float best = taskRowMax.GetValue(row);
            const uint64_t tileRow = stageBase + static_cast<uint64_t>(row) * TileN;
            for (uint32_t column = 0; column < actualN; ++column) {
                const float value = stage.GetValue(tileRow + column);
                best = value > best ? value : best;
            }
            taskRowMax.SetValue(row, best);
            if (finalize != 0) {
                const uint32_t batchIndex = static_cast<uint32_t>(batch);
                localSums.SetValue(batchIndex, localSums.GetValue(batchIndex) + best);
            }
        }
        if (finalize == 0) {
            AscendC::SetFlag<AscendC::HardEvent::S_MTE3>(0);
            AscendC::WaitFlag<AscendC::HardEvent::S_MTE3>(0);
            AscendC::DataCopy(rowMax[rowMaxBase], taskRowMax, TileM);
            AscendC::SetFlag<AscendC::HardEvent::MTE3_S>(0);
            AscendC::WaitFlag<AscendC::HardEvent::MTE3_S>(0);
        }
    }
    if (finalize != 0) {
        AtomicAddBatchSums(atomicOutput, localSums, atomicElements);
    }
}

template<class T, bool TX1, bool TX2,
         uint32_t TileM, uint32_t TileN, uint32_t TileK>
inline void LaunchBmMatmul(GM_ADDR x1, GM_ADDR x2, GM_ADDR stage, GM_ADDR cubeTiling,
                           Shape shape, uint64_t taskBase, uint32_t waveTasks,
                           uint32_t columnBase, aclrtStream stream) {
    BmMatmul<T, TX1, TX2, TileM, TileN, TileK><<<waveTasks, nullptr, stream>>>(
        x1, x2, stage, cubeTiling, shape, taskBase, waveTasks, columnBase);
}

template<class T, uint32_t TileM, uint32_t TileN, uint32_t TileK>
inline void LaunchBmMatmulByTranspose(
        GM_ADDR x1, GM_ADDR x2, GM_ADDR stage, GM_ADDR cubeTiling,
        Shape shape, uint64_t taskBase, uint32_t waveTasks, uint32_t columnBase,
        aclrtStream stream, bool transposeX1, bool transposeX2) {
    if (transposeX1 && transposeX2) {
        LaunchBmMatmul<T, true, true, TileM, TileN, TileK>(
            x1, x2, stage, cubeTiling, shape, taskBase, waveTasks, columnBase, stream);
    } else if (transposeX1) {
        LaunchBmMatmul<T, true, false, TileM, TileN, TileK>(
            x1, x2, stage, cubeTiling, shape, taskBase, waveTasks, columnBase, stream);
    } else if (transposeX2) {
        LaunchBmMatmul<T, false, true, TileM, TileN, TileK>(
            x1, x2, stage, cubeTiling, shape, taskBase, waveTasks, columnBase, stream);
    } else {
        LaunchBmMatmul<T, false, false, TileM, TileN, TileK>(
            x1, x2, stage, cubeTiling, shape, taskBase, waveTasks, columnBase, stream);
    }
}

}  // namespace bmms
// ===== END kernels/bm.asc =====

// ===== BEGIN kernels/bmn.asc =====
namespace bmms {

template<class T, bool TX1, bool TX2,
         uint32_t TileM, uint32_t TileN, uint32_t TileK>
__global__ __aicore__ void BmnMatmul(
        GM_ADDR x1, GM_ADDR x2, GM_ADDR stage, GM_ADDR cubeTiling,
        Shape shape, uint64_t taskBase, uint32_t waveTasks,
        uint32_t splitN, uint32_t tileRound) {
    KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_AIC_ONLY);
    const uint32_t block = AscendC::GetBlockIdx();
    if (block >= waveTasks) {
        return;
    }

    const uint64_t mGroups = (static_cast<uint64_t>(shape.m) + TileM - 1) / TileM;
    const uint64_t nTiles = (static_cast<uint64_t>(shape.n) + TileN - 1) / TileN;
    const uint64_t task = taskBase + block;
    const uint64_t bmTask = task / splitN;
    const uint32_t nGroup = static_cast<uint32_t>(task - bmTask * splitN);
    const uint64_t batch = bmTask / mGroups;
    const uint64_t mGroup = bmTask - batch * mGroups;
    const uint64_t tileIndex = static_cast<uint64_t>(tileRound) * splitN + nGroup;
    if (tileIndex >= nTiles) {
        return;
    }

    const uint64_t rowBase = mGroup * TileM;
    const uint32_t columnBase = static_cast<uint32_t>(tileIndex * TileN);
    const uint32_t actualM = static_cast<uint32_t>(
        shape.m - static_cast<int64_t>(rowBase) < TileM
            ? shape.m - static_cast<int64_t>(rowBase) : TileM);
    const uint32_t actualN = static_cast<uint32_t>(
        shape.n - static_cast<int64_t>(columnBase) < TileN
            ? shape.n - static_cast<int64_t>(columnBase) : TileN);

    AscendC::GlobalTensor<T> lhs;
    AscendC::GlobalTensor<T> rhs;
    AscendC::GlobalTensor<float> output;
    lhs.SetGlobalBuffer(reinterpret_cast<__gm__ T*>(x1));
    rhs.SetGlobalBuffer(reinterpret_cast<__gm__ T*>(x2));
    output.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(stage));

    const uint64_t lhsBatch = batch * static_cast<uint64_t>(shape.m) * shape.k;
    const uint64_t rhsBatch = batch * static_cast<uint64_t>(shape.n) * shape.k;
    const uint64_t lhsOffset = lhsBatch +
        (TX1 ? rowBase : rowBase * static_cast<uint64_t>(shape.k));
    const uint64_t rhsOffset = rhsBatch +
        (TX2 ? static_cast<uint64_t>(columnBase) * shape.k : columnBase);
    const uint64_t outputOffset = static_cast<uint64_t>(block) * TileM * TileN;

    using AType = AscendC::MatmulType<AscendC::TPosition::GM, CubeFormat::ND, T, TX1>;
    using BType = AscendC::MatmulType<AscendC::TPosition::GM, CubeFormat::ND, T, TX2>;
    using CType = AscendC::MatmulType<AscendC::TPosition::GM, CubeFormat::ND, float>;
    AscendC::Matmul<AType, BType, CType, CType, CFG_MDL> matmul;
    AscendC::TPipe pipe;
    TCubeTiling localTiling;
    LoadBmCubeTiling(cubeTiling, localTiling);
    matmul.Init(&localTiling, &pipe);
    matmul.SetOrgShape(static_cast<int>(shape.m), static_cast<int>(shape.n),
                       static_cast<int>(shape.k), static_cast<int>(shape.k),
                       static_cast<int>(TileN));
    matmul.SetTensorA(lhs[lhsOffset], TX1);
    matmul.SetTensorB(rhs[rhsOffset], TX2);
    matmul.SetTail(static_cast<int>(actualM), static_cast<int>(actualN),
                   static_cast<int>(shape.k));
    matmul.IterateAll(output[outputOffset]);
    matmul.End();
}

template<uint32_t TileM, uint32_t TileN>
__global__ __vector__ void UpdateBmnPartialMax(
        GM_ADDR stageAddress, GM_ADDR partialMaxAddress, Shape shape,
        uint64_t taskBase, uint32_t waveTasks, uint32_t workerCount,
        uint32_t splitN, uint32_t tileRound) {
    static_assert(TileM * sizeof(float) % 32 == 0,
                  "BMN partial-max tiles must be 32-byte aligned for DataCopy");
    AscendC::GlobalTensor<float> stage;
    AscendC::GlobalTensor<float> partialMax;
    stage.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(stageAddress));
    partialMax.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(partialMaxAddress));

    AscendC::TPipe pipe;
    AscendC::TBuf<AscendC::TPosition::VECCALC> partialBuffer;
    pipe.InitBuffer(partialBuffer, TileM * sizeof(float));
    auto taskPartial = partialBuffer.Get<float>();

    const uint64_t mGroups = (static_cast<uint64_t>(shape.m) + TileM - 1) / TileM;
    const uint64_t nTiles = (static_cast<uint64_t>(shape.n) + TileN - 1) / TileN;
    for (uint32_t slot = AscendC::GetBlockIdx(); slot < waveTasks; slot += workerCount) {
        const uint64_t task = taskBase + slot;
        const uint64_t bmTask = task / splitN;
        const uint32_t nGroup = static_cast<uint32_t>(task - bmTask * splitN);
        const uint64_t tileIndex = static_cast<uint64_t>(tileRound) * splitN + nGroup;
        if (tileIndex >= nTiles) {
            continue;
        }

        const uint64_t batch = bmTask / mGroups;
        const uint64_t mGroup = bmTask - batch * mGroups;
        const uint64_t rowBase = mGroup * TileM;
        const uint32_t columnBase = static_cast<uint32_t>(tileIndex * TileN);
        const uint32_t actualM = static_cast<uint32_t>(
            shape.m - static_cast<int64_t>(rowBase) < TileM
                ? shape.m - static_cast<int64_t>(rowBase) : TileM);
        const uint32_t actualN = static_cast<uint32_t>(
            shape.n - static_cast<int64_t>(columnBase) < TileN
                ? shape.n - static_cast<int64_t>(columnBase) : TileN);
        const uint64_t stageBase = static_cast<uint64_t>(slot) * TileM * TileN;
        const uint64_t partialBase = task * TileM;

        if (tileRound == 0) {
            for (uint32_t row = 0; row < TileM; ++row) {
                taskPartial.SetValue(row, -__builtin_inff());
            }
        } else {
            AscendC::DataCopy(taskPartial, partialMax[partialBase], TileM);
            AscendC::SetFlag<AscendC::HardEvent::MTE2_S>(0);
            AscendC::WaitFlag<AscendC::HardEvent::MTE2_S>(0);
        }

        for (uint32_t row = 0; row < actualM; ++row) {
            float best = taskPartial.GetValue(row);
            const uint64_t tileRow = stageBase + static_cast<uint64_t>(row) * TileN;
            for (uint32_t column = 0; column < actualN; ++column) {
                const float value = stage.GetValue(tileRow + column);
                best = value > best ? value : best;
            }
            taskPartial.SetValue(row, best);
        }

        AscendC::SetFlag<AscendC::HardEvent::S_MTE3>(0);
        AscendC::WaitFlag<AscendC::HardEvent::S_MTE3>(0);
        AscendC::DataCopy(partialMax[partialBase], taskPartial, TileM);
        AscendC::SetFlag<AscendC::HardEvent::MTE3_S>(0);
        AscendC::WaitFlag<AscendC::HardEvent::MTE3_S>(0);
    }
}

template<uint32_t TileM>
__global__ __vector__ void ReduceBmnPartialMax(
        GM_ADDR partialMaxAddress, GM_ADDR atomicOutputAddress, Shape shape,
        uint32_t splitN, uint64_t bmTaskCount, uint32_t workerCount) {
    static_assert(TileM * sizeof(float) % 32 == 0,
                  "BMN reduction tiles must be 32-byte aligned for DataCopy");
    AscendC::GlobalTensor<float> partialMax;
    AscendC::GlobalTensor<float> atomicOutput;
    partialMax.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(partialMaxAddress));
    atomicOutput.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(atomicOutputAddress));

    AscendC::TPipe pipe;
    AscendC::TBuf<AscendC::TPosition::VECCALC> reducedBuffer;
    AscendC::TBuf<AscendC::TPosition::VECCALC> groupBuffer;
    AscendC::TBuf<AscendC::TPosition::VECCALC> atomicBuffer;
    pipe.InitBuffer(reducedBuffer, TileM * sizeof(float));
    pipe.InitBuffer(groupBuffer, TileM * sizeof(float));
    pipe.InitBuffer(atomicBuffer, kMaxOutputBatches * sizeof(float));
    auto reducedRows = reducedBuffer.Get<float>();
    auto groupRows = groupBuffer.Get<float>();
    auto localSums = atomicBuffer.Get<float>();

    const uint32_t atomicElements = AtomicOutputElements(shape.b);
    for (uint32_t index = 0; index < atomicElements; ++index) {
        localSums.SetValue(index, 0.0f);
    }

    const uint64_t mGroups = (static_cast<uint64_t>(shape.m) + TileM - 1) / TileM;
    bool groupBufferInUse = false;
    for (uint64_t bmTask = AscendC::GetBlockIdx(); bmTask < bmTaskCount;
         bmTask += workerCount) {
        const uint64_t batch = bmTask / mGroups;
        const uint64_t mGroup = bmTask - batch * mGroups;
        const uint64_t rowBase = mGroup * TileM;
        const uint32_t actualM = static_cast<uint32_t>(
            shape.m - static_cast<int64_t>(rowBase) < TileM
                ? shape.m - static_cast<int64_t>(rowBase) : TileM);
        for (uint32_t row = 0; row < TileM; ++row) {
            reducedRows.SetValue(row, -__builtin_inff());
        }

        for (uint32_t nGroup = 0; nGroup < splitN; ++nGroup) {
            if (groupBufferInUse) {
                AscendC::SetFlag<AscendC::HardEvent::S_MTE2>(0);
                AscendC::WaitFlag<AscendC::HardEvent::S_MTE2>(0);
            }
            const uint64_t partialTask = bmTask * splitN + nGroup;
            AscendC::DataCopy(groupRows, partialMax[partialTask * TileM], TileM);
            AscendC::SetFlag<AscendC::HardEvent::MTE2_S>(0);
            AscendC::WaitFlag<AscendC::HardEvent::MTE2_S>(0);
            groupBufferInUse = true;
            for (uint32_t row = 0; row < actualM; ++row) {
                const float candidate = groupRows.GetValue(row);
                const float best = reducedRows.GetValue(row);
                reducedRows.SetValue(row, candidate > best ? candidate : best);
            }
        }

        float taskSum = 0.0f;
        for (uint32_t row = 0; row < actualM; ++row) {
            taskSum += reducedRows.GetValue(row);
        }
        const uint32_t batchIndex = static_cast<uint32_t>(batch);
        localSums.SetValue(batchIndex, localSums.GetValue(batchIndex) + taskSum);
    }
    AtomicAddBatchSums(atomicOutput, localSums, atomicElements);
}

template<class T, bool TX1, bool TX2,
         uint32_t TileM, uint32_t TileN, uint32_t TileK>
inline void LaunchBmnMatmul(
        GM_ADDR x1, GM_ADDR x2, GM_ADDR stage, GM_ADDR cubeTiling,
        Shape shape, uint64_t taskBase, uint32_t waveTasks,
        uint32_t splitN, uint32_t tileRound, aclrtStream stream) {
    BmnMatmul<T, TX1, TX2, TileM, TileN, TileK><<<waveTasks, nullptr, stream>>>(
        x1, x2, stage, cubeTiling, shape, taskBase, waveTasks, splitN, tileRound);
}

template<class T, uint32_t TileM, uint32_t TileN, uint32_t TileK>
inline void LaunchBmnMatmulByTranspose(
        GM_ADDR x1, GM_ADDR x2, GM_ADDR stage, GM_ADDR cubeTiling,
        Shape shape, uint64_t taskBase, uint32_t waveTasks,
        uint32_t splitN, uint32_t tileRound, aclrtStream stream,
        bool transposeX1, bool transposeX2) {
    if (transposeX1 && transposeX2) {
        LaunchBmnMatmul<T, true, true, TileM, TileN, TileK>(
            x1, x2, stage, cubeTiling, shape, taskBase, waveTasks,
            splitN, tileRound, stream);
    } else if (transposeX1) {
        LaunchBmnMatmul<T, true, false, TileM, TileN, TileK>(
            x1, x2, stage, cubeTiling, shape, taskBase, waveTasks,
            splitN, tileRound, stream);
    } else if (transposeX2) {
        LaunchBmnMatmul<T, false, true, TileM, TileN, TileK>(
            x1, x2, stage, cubeTiling, shape, taskBase, waveTasks,
            splitN, tileRound, stream);
    } else {
        LaunchBmnMatmul<T, false, false, TileM, TileN, TileK>(
            x1, x2, stage, cubeTiling, shape, taskBase, waveTasks,
            splitN, tileRound, stream);
    }
}

}  // namespace bmms
// ===== END kernels/bmn.asc =====

// ===== BEGIN kernels/kernel_dispatch.asc =====
namespace bmms {

// run_kernel has no completion callback: the competition driver owns stream
// synchronization and timing. Cache exact per-stream execution resources so
// every launch can return asynchronously without freeing in-flight memory.
// Device reset reclaims these process-lifetime allocations after evaluation.
struct ExecutionResourceKey {
    int32_t deviceId;
    aclrtStream stream;
    TilingKey tilingKey;
    Shape shape;
    int32_t inputDtype;
    bool transposeX1;
    bool transposeX2;
    uint32_t launchBlocks;
    uint32_t splitN;
    uint64_t workspaceBytes;
};

struct CachedExecutionResources {
    ExecutionResourceKey key;
    GM_ADDR workspace;
    uint64_t workspaceBytes;
    GM_ADDR cubeTiling;
    void* cubeTilingHost;
    uint64_t cubeTilingBytes;
};

inline bool SameExecutionResourceKey(
        const ExecutionResourceKey& lhs, const ExecutionResourceKey& rhs) {
    return lhs.deviceId == rhs.deviceId && lhs.stream == rhs.stream &&
           lhs.tilingKey == rhs.tilingKey &&
           lhs.shape.b == rhs.shape.b && lhs.shape.m == rhs.shape.m &&
           lhs.shape.n == rhs.shape.n && lhs.shape.k == rhs.shape.k &&
           lhs.inputDtype == rhs.inputDtype &&
           lhs.transposeX1 == rhs.transposeX1 &&
           lhs.transposeX2 == rhs.transposeX2 &&
           lhs.launchBlocks == rhs.launchBlocks && lhs.splitN == rhs.splitN &&
           lhs.workspaceBytes == rhs.workspaceBytes;
}

inline std::vector<CachedExecutionResources>& ExecutionResourceCache() {
    static std::vector<CachedExecutionResources> cache;
    return cache;
}

inline std::atomic_flag& ExecutionResourceCacheLock() {
    static std::atomic_flag lock = ATOMIC_FLAG_INIT;
    return lock;
}

class ExecutionResourceCacheGuard {
public:
    ExecutionResourceCacheGuard() {
        while (ExecutionResourceCacheLock().test_and_set(std::memory_order_acquire)) {
        }
    }

    ~ExecutionResourceCacheGuard() {
        ExecutionResourceCacheLock().clear(std::memory_order_release);
    }

    ExecutionResourceCacheGuard(const ExecutionResourceCacheGuard&) = delete;
    ExecutionResourceCacheGuard& operator=(const ExecutionResourceCacheGuard&) = delete;
};

inline GM_ADDR AllocatePersistentDeviceBuffer(uint64_t bytes, const char* operation) {
    if (bytes == 0) {
        throw std::invalid_argument("Persistent device buffer must not be empty");
    }
    void* address = nullptr;
    CheckAcl(aclrtMalloc(&address, static_cast<size_t>(bytes), ACL_MEM_MALLOC_HUGE_FIRST),
             operation);
    return static_cast<uint8_t*>(address);
}

inline ExecutionResourceKey MakeExecutionResourceKey(
        const Plan& plan, aclrtStream stream, int32_t inputDtype,
        bool transposeX1, bool transposeX2) {
    int32_t deviceId = 0;
    CheckAcl(aclrtGetDevice(&deviceId), "aclrtGetDevice(resource cache key)");
    return ExecutionResourceKey{
        deviceId,
        stream,
        plan.key,
        Shape{plan.tiling.b, plan.tiling.m, plan.tiling.n, plan.tiling.k},
        inputDtype,
        transposeX1,
        transposeX2,
        plan.tiling.launchBlocks,
        plan.tiling.splitN,
        plan.tiling.workspaceBytes};
}

template<class Factory>
inline CachedExecutionResources GetOrCreateExecutionResources(
        const ExecutionResourceKey& key, Factory factory) {
    ExecutionResourceCacheGuard guard;
    for (const auto& resources : ExecutionResourceCache()) {
        if (SameExecutionResourceKey(resources.key, key)) {
            return resources;
        }
    }
    CachedExecutionResources resources = factory();
    ExecutionResourceCache().push_back(resources);
    return resources;
}

inline CachedExecutionResources GetReferenceExecutionResources(
        const Plan& plan, aclrtStream stream, int32_t inputDtype,
        bool transposeX1, bool transposeX2) {
    const ExecutionResourceKey key = MakeExecutionResourceKey(
        plan, stream, inputDtype, transposeX1, transposeX2);
    return GetOrCreateExecutionResources(key, [&]() {
        return CachedExecutionResources{
            key,
            AllocatePersistentDeviceBuffer(
                plan.tiling.workspaceBytes, "aclrtMalloc(reference workspace cache)"),
            plan.tiling.workspaceBytes,
            nullptr,
            nullptr,
            0};
    });
}

template<uint32_t TileM, uint32_t TileN, uint32_t TileK>
inline CachedExecutionResources GetMatmulExecutionResources(
        const Plan& plan, aclrtStream stream, int32_t inputDtype,
        bool transposeX1, bool transposeX2) {
    const Shape shape{plan.tiling.b, plan.tiling.m, plan.tiling.n, plan.tiling.k};
    const ExecutionResourceKey key = MakeExecutionResourceKey(
        plan, stream, inputDtype, transposeX1, transposeX2);
    return GetOrCreateExecutionResources(key, [&]() {
        auto cubeHostTiling = MakeBmCubeTiling<TileM, TileN, TileK>(
            shape, inputDtype, transposeX1, transposeX2);
        GM_ADDR workspace = AllocatePersistentDeviceBuffer(
            plan.tiling.workspaceBytes, "aclrtMalloc(Matmul workspace cache)");
        const PersistentCubeTiling cubeTiling = UploadPersistentCubeTiling(
            cubeHostTiling, stream);
        return CachedExecutionResources{
            key,
            workspace,
            plan.tiling.workspaceBytes,
            cubeTiling.deviceAddress,
            cubeTiling.hostAddress,
            cubeTiling.bytes};
    });
}

inline void ExecuteReferencePlan(const Plan& plan, GM_ADDR x1, GM_ADDR x2, GM_ADDR y,
                                 int32_t inputDtype, aclrtStream stream,
                                 bool transposeX1, bool transposeX2) {
    const CachedExecutionResources resources = GetReferenceExecutionResources(
        plan, stream, inputDtype, transposeX1, transposeX2);
    GM_ADDR atomicOutput = resources.workspace;
    const Shape shape{plan.tiling.b, plan.tiling.m, plan.tiling.n, plan.tiling.k};
    CheckAcl(aclrtMemsetAsync(
                 atomicOutput, static_cast<size_t>(resources.workspaceBytes), 0,
                 static_cast<size_t>(resources.workspaceBytes), stream),
             "aclrtMemsetAsync(reference atomic output)");

    if (inputDtype == 1) {
        LaunchRowMax<half>(x1, x2, atomicOutput, shape, plan.tiling.launchBlocks,
                           stream, transposeX1, transposeX2);
    } else {
        LaunchRowMax<bfloat16_t>(x1, x2, atomicOutput, shape, plan.tiling.launchBlocks,
                                 stream, transposeX1, transposeX2);
    }
    const size_t outputBytes = static_cast<size_t>(shape.b) * sizeof(float);
    CheckAcl(aclrtMemcpyAsync(y, outputBytes, atomicOutput, outputBytes,
                              ACL_MEMCPY_DEVICE_TO_DEVICE, stream),
             "aclrtMemcpyAsync(reference atomic output to y)");
}

template<uint32_t TileM, uint32_t TileN, uint32_t TileK>
inline void ExecuteBmPlan(
        const Plan& plan, GM_ADDR x1, GM_ADDR x2, GM_ADDR y,
        int32_t inputDtype, aclrtStream stream,
        bool transposeX1, bool transposeX2) {
    const Shape shape{plan.tiling.b, plan.tiling.m, plan.tiling.n, plan.tiling.k};
    const uint64_t mGroups = CeilDivU64(shape.m, TileM);
    const uint64_t taskCount = static_cast<uint64_t>(shape.b) * mGroups;
    const uint64_t rowMaxBytes = taskCount * TileM * sizeof(float);
    const uint64_t stageOffset = AlignUpU64(rowMaxBytes, 512);
    const uint64_t stageBytes = static_cast<uint64_t>(plan.tiling.launchBlocks) *
                                TileM * TileN * sizeof(float);
    const uint64_t atomicOffset = stageOffset + stageBytes;
    const uint64_t atomicBytes = AlignUpU64(shape.b, kAtomicAlignmentFloats) * sizeof(float);
    const CachedExecutionResources resources =
        GetMatmulExecutionResources<TileM, TileN, TileK>(
            plan, stream, inputDtype, transposeX1, transposeX2);
    GM_ADDR rowMax = resources.workspace;
    GM_ADDR stage = resources.workspace + stageOffset;
    GM_ADDR atomicOutput = resources.workspace + atomicOffset;
    const uint32_t vectorBlocks = static_cast<uint32_t>(
        std::min<uint64_t>(taskCount, static_cast<uint64_t>(QueryVectorCoreCount())));
    CheckAcl(aclrtMemsetAsync(atomicOutput, static_cast<size_t>(atomicBytes), 0,
                              static_cast<size_t>(atomicBytes), stream),
             "aclrtMemsetAsync(BM atomic output)");
    for (uint32_t columnBase = 0; columnBase < static_cast<uint32_t>(shape.n);
         columnBase += TileN) {
        for (uint64_t taskBase = 0; taskBase < taskCount;
             taskBase += plan.tiling.launchBlocks) {
            const uint32_t waveTasks = static_cast<uint32_t>(std::min<uint64_t>(
                plan.tiling.launchBlocks, taskCount - taskBase));
            if (inputDtype == 1) {
                LaunchBmMatmulByTranspose<half, TileM, TileN, TileK>(
                    x1, x2, stage, resources.cubeTiling, shape, taskBase, waveTasks,
                    columnBase, stream, transposeX1, transposeX2);
            } else {
                LaunchBmMatmulByTranspose<bfloat16_t, TileM, TileN, TileK>(
                    x1, x2, stage, resources.cubeTiling, shape, taskBase, waveTasks,
                    columnBase, stream, transposeX1, transposeX2);
            }
            const uint32_t updateBlocks = std::min(vectorBlocks, waveTasks);
            const uint32_t finalize = columnBase + TileN >= static_cast<uint32_t>(shape.n);
            UpdateBmRowMax<TileM, TileN><<<updateBlocks, nullptr, stream>>>(
                stage, rowMax, atomicOutput, shape, taskBase, waveTasks, updateBlocks,
                columnBase, finalize);
        }
    }
    const size_t outputBytes = static_cast<size_t>(shape.b) * sizeof(float);
    CheckAcl(aclrtMemcpyAsync(y, outputBytes, atomicOutput, outputBytes,
                              ACL_MEMCPY_DEVICE_TO_DEVICE, stream),
             "aclrtMemcpyAsync(BM atomic output to y)");
}

template<uint32_t TileM, uint32_t TileN, uint32_t TileK, uint32_t MaxSplitN>
inline void ExecuteBmnPlan(
        const Plan& plan, GM_ADDR x1, GM_ADDR x2, GM_ADDR y,
        int32_t inputDtype, aclrtStream stream,
        bool transposeX1, bool transposeX2) {
    const Shape shape{plan.tiling.b, plan.tiling.m, plan.tiling.n, plan.tiling.k};
    const uint32_t splitN = plan.tiling.splitN;
    if (splitN < 1 || splitN > MaxSplitN) {
        throw std::invalid_argument("BMN splitN is outside the kernel instance range");
    }

    const uint64_t mGroups = CeilDivU64(shape.m, TileM);
    const uint64_t nTiles = CeilDivU64(shape.n, TileN);
    const uint64_t bmTaskCount = static_cast<uint64_t>(shape.b) * mGroups;
    const uint64_t bmnTaskCount = bmTaskCount * splitN;
    const uint64_t partialMaxBytes = bmnTaskCount * TileM * sizeof(float);
    const uint64_t stageOffset = AlignUpU64(partialMaxBytes, 512);
    const uint64_t stageBytes = static_cast<uint64_t>(plan.tiling.launchBlocks) *
                                TileM * TileN * sizeof(float);
    const uint64_t atomicOffset = stageOffset + stageBytes;
    const uint64_t atomicBytes = AlignUpU64(shape.b, kAtomicAlignmentFloats) * sizeof(float);
    const CachedExecutionResources resources =
        GetMatmulExecutionResources<TileM, TileN, TileK>(
            plan, stream, inputDtype, transposeX1, transposeX2);
    GM_ADDR partialMax = resources.workspace;
    GM_ADDR stage = resources.workspace + stageOffset;
    GM_ADDR atomicOutput = resources.workspace + atomicOffset;
    const uint32_t vectorCoreCount = static_cast<uint32_t>(QueryVectorCoreCount());
    const uint32_t updateWorkers = static_cast<uint32_t>(
        std::min<uint64_t>(bmnTaskCount, vectorCoreCount));
    CheckAcl(aclrtMemsetAsync(atomicOutput, static_cast<size_t>(atomicBytes), 0,
                              static_cast<size_t>(atomicBytes), stream),
             "aclrtMemsetAsync(BMN atomic output)");

    const uint32_t tileRounds = static_cast<uint32_t>(CeilDivU64(nTiles, splitN));
    for (uint32_t tileRound = 0; tileRound < tileRounds; ++tileRound) {
        for (uint64_t taskBase = 0; taskBase < bmnTaskCount;
             taskBase += plan.tiling.launchBlocks) {
            const uint32_t waveTasks = static_cast<uint32_t>(std::min<uint64_t>(
                plan.tiling.launchBlocks, bmnTaskCount - taskBase));
            if (inputDtype == 1) {
                LaunchBmnMatmulByTranspose<half, TileM, TileN, TileK>(
                    x1, x2, stage, resources.cubeTiling, shape, taskBase, waveTasks,
                    splitN, tileRound, stream, transposeX1, transposeX2);
            } else {
                LaunchBmnMatmulByTranspose<bfloat16_t, TileM, TileN, TileK>(
                    x1, x2, stage, resources.cubeTiling, shape, taskBase, waveTasks,
                    splitN, tileRound, stream, transposeX1, transposeX2);
            }
            const uint32_t updateBlocks = std::min(updateWorkers, waveTasks);
            UpdateBmnPartialMax<TileM, TileN><<<updateBlocks, nullptr, stream>>>(
                stage, partialMax, shape, taskBase, waveTasks, updateBlocks,
                splitN, tileRound);
        }
    }

    const uint32_t reduceBlocks = static_cast<uint32_t>(
        std::min<uint64_t>(bmTaskCount, vectorCoreCount));
    ReduceBmnPartialMax<TileM><<<reduceBlocks, nullptr, stream>>>(
        partialMax, atomicOutput, shape, splitN, bmTaskCount, reduceBlocks);
    const size_t outputBytes = static_cast<size_t>(shape.b) * sizeof(float);
    CheckAcl(aclrtMemcpyAsync(y, outputBytes, atomicOutput, outputBytes,
                              ACL_MEMCPY_DEVICE_TO_DEVICE, stream),
             "aclrtMemcpyAsync(BMN atomic output to y)");
}

inline void ExecutePlan(const Plan& plan, GM_ADDR x1, GM_ADDR x2, GM_ADDR y,
                        int32_t inputDtype, aclrtStream stream,
                        bool transposeX1, bool transposeX2) {
    switch (plan.path) {
        case KernelPath::REFERENCE:
            ExecuteReferencePlan(plan, x1, x2, y, inputDtype, stream,
                                 transposeX1, transposeX2);
            return;
        case KernelPath::BM:
            switch (plan.key) {
                case TilingKey::BM_16X128X64:
                    ExecuteBmPlan<16, 128, 64>(plan, x1, x2, y, inputDtype, stream,
                                               transposeX1, transposeX2);
                    return;
                case TilingKey::BM_32X128X64:
                    ExecuteBmPlan<32, 128, 64>(plan, x1, x2, y, inputDtype, stream,
                                               transposeX1, transposeX2);
                    return;
                case TilingKey::BM_32X256X64:
                    ExecuteBmPlan<32, 256, 64>(plan, x1, x2, y, inputDtype, stream,
                                               transposeX1, transposeX2);
                    return;
                case TilingKey::BM_64X128X128:
                    ExecuteBmPlan<64, 128, 128>(plan, x1, x2, y, inputDtype, stream,
                                                transposeX1, transposeX2);
                    return;
                default:
                    throw std::invalid_argument("Selected BM kernel is not implemented");
            }
        case KernelPath::BMN:
            switch (plan.key) {
                case TilingKey::BMN_16X256X64_P2:
                    ExecuteBmnPlan<16, 256, 64, 2>(plan, x1, x2, y, inputDtype, stream,
                                                   transposeX1, transposeX2);
                    return;
                case TilingKey::BMN_16X256X64_P4:
                    ExecuteBmnPlan<16, 256, 64, 4>(plan, x1, x2, y, inputDtype, stream,
                                                   transposeX1, transposeX2);
                    return;
                default:
                    throw std::invalid_argument("Selected BMN kernel is not implemented");
            }
    }
    throw std::invalid_argument("Selected kernel path is invalid");
}

}  // namespace bmms
// ===== END kernels/kernel_dispatch.asc =====

// ===== BEGIN kernel.asc =====
// Included by the local or competition Host driver.

extern "C" void run_kernel(GM_ADDR x1, const TensorGroupInfo& info_x1,
    GM_ADDR x2, const TensorGroupInfo& info_x2, GM_ADDR y, const TensorGroupInfo& info_y,
    int64_t availableCoreNum, aclrtStream stream, bool transposeX1, bool transposeX2) {
    const bmms::Shape shape = bmms::ValidateInputs(
        x1, info_x1, x2, info_x2, y, info_y, transposeX1, transposeX2);
    const bmms::TilingKey key = bmms::SelectTilingKey(
        shape, availableCoreNum, info_x1.tensors[0].dtype, transposeX1, transposeX2);
    const int64_t computeCoreNum = bmms::FindTilingConfig(key)->path == bmms::KernelPath::REFERENCE
        ? availableCoreNum : bmms::QueryCubeCoreCount();
    const bmms::Plan plan = bmms::MakePlan(shape, computeCoreNum, key);
    bmms::ExecutePlan(plan, x1, x2, y, info_x1.tensors[0].dtype, stream,
                      transposeX1, transposeX2);
}
// ===== END kernel.asc =====
