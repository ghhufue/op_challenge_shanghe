namespace bmms {

inline const StaticTilingConfig* FindTilingConfig(TilingKey key) {
    for (size_t index = 0; index < kTilingConfigCount; ++index) {
        if (kTilingConfigs[index].key == key) {
            return &kTilingConfigs[index];
        }
    }
    return nullptr;
}

inline TilingKey ParseTilingKey(int64_t value) {
    if (value < 0 || value > UINT32_MAX) {
        throw std::invalid_argument("Tiling key is outside uint32 range");
    }
    const TilingKey key = static_cast<TilingKey>(static_cast<uint32_t>(value));
    if (FindTilingConfig(key) == nullptr) {
        throw std::invalid_argument("Unknown tiling key: " + std::to_string(value));
    }
    return key;
}

}  // namespace bmms
// ===== END tiling/tiling_catalog.h =====

// ===== BEGIN host/acl_runtime.h =====
namespace bmms {

inline void CheckAcl(aclError status, const char* operation) {
    if (status != ACL_SUCCESS) {
        throw std::runtime_error(std::string(operation) + ": " + std::to_string(status));
    }
}

inline int64_t QueryCoreCount(aclrtDevAttr attribute, const char* name) {
    int32_t deviceId = 0;
    CheckAcl(aclrtGetDevice(&deviceId), "aclrtGetDevice");
    int64_t count = 0;
    CheckAcl(aclrtGetDeviceInfo(deviceId, attribute, &count), name);
    if (count < 1) {
        throw std::runtime_error(std::string("No ") + name + " are available");
    }
    return count;
}

inline int64_t QueryCubeCoreCount() {
    return QueryCoreCount(ACL_DEV_ATTR_CUBE_CORE_NUM, "Cube core count");
}

}  // namespace bmms
// ===== END host/acl_runtime.h =====

// ===== BEGIN host/input_validation.h =====
namespace bmms {

inline Shape ValidateInputs(GM_ADDR x1, const TensorGroupInfo& infoX1,
                            GM_ADDR x2, const TensorGroupInfo& infoX2,
                            GM_ADDR y, const TensorGroupInfo& infoY,
                            bool transposeX1, bool transposeX2) {
    if (x1 == nullptr || x2 == nullptr || y == nullptr) {
        throw std::invalid_argument("Input and output device addresses must be non-null");
    }
    if (infoX1.numTensors != 1 || infoX2.numTensors != 1 || infoY.numTensors != 1 ||
        infoX1.tensors == nullptr || infoX2.tensors == nullptr || infoY.tensors == nullptr) {
        throw std::invalid_argument("Each tensor group must contain exactly one tensor");
    }

    const auto& lhs = infoX1.tensors[0];
    const auto& rhs = infoX2.tensors[0];
    const auto& output = infoY.tensors[0];
    if (lhs.shape == nullptr || rhs.shape == nullptr || output.shape == nullptr ||
        lhs.numDims != 3 || rhs.numDims != 3 || output.numDims != 1) {
        throw std::invalid_argument("Expected rank-3 inputs and a rank-1 output");
    }
    if ((lhs.dtype != 1 && lhs.dtype != 2) || rhs.dtype != lhs.dtype || output.dtype != 0) {
        throw std::invalid_argument("Expected matching FP16/BF16 inputs and FP32 output");
    }

    Shape shape{
        lhs.shape[0],
        transposeX1 ? lhs.shape[2] : lhs.shape[1],
        transposeX2 ? rhs.shape[1] : rhs.shape[2],
        transposeX1 ? lhs.shape[1] : lhs.shape[2]
    };
    const int64_t rhsK = transposeX2 ? rhs.shape[2] : rhs.shape[1];
    if (rhs.shape[0] != shape.b || rhsK != shape.k || output.shape[0] != shape.b) {
        throw std::invalid_argument("Input/output shapes are inconsistent");
    }
    if (shape.b < 1 || shape.b > 64 || shape.m < 1 || shape.m > 8192 ||
        shape.n < 1 || shape.n > 8192 || shape.k < 32 || shape.k > 8192 ||
        shape.k % 8 != 0 || shape.b * shape.m * shape.k > (1LL << 26) ||
        shape.b * shape.n * shape.k > (1LL << 26)) {
        throw std::invalid_argument("Shape is outside the supported problem range");
    }
    return shape;
}

}  // namespace bmms
// ===== END host/input_validation.h =====

// ===== BEGIN host/fused_tiling.h =====
namespace bmms {

inline platform_ascendc::PlatformAscendC* GetAscendPlatform() {
    static platform_ascendc::PlatformAscendC* platform = []() {
        const char* socName = aclrtGetSocName();
        if (socName == nullptr) {
            throw std::runtime_error("aclrtGetSocName returned null");
        }
        auto* instance =
            platform_ascendc::PlatformAscendCManager::GetInstance(socName);
        if (instance == nullptr) {
            throw std::runtime_error(
                "Failed to initialize AscendC platform information");
        }
        return instance;
    }();
    return platform;
}

inline uint64_t QueryMatmulSystemWorkspaceBytes() {
    static const uint64_t bytes = static_cast<uint64_t>(
        GetAscendPlatform()->GetLibApiWorkSpaceSize());
    return bytes;
}

template<uint32_t TileM, uint32_t TileN, uint32_t TileK>
inline AscendC::tiling::TCubeTiling MakeAutoFusedCubeTiling(
        const Shape& shape, int32_t inputDtype,
        bool transposeX1, bool transposeX2) {
    static_assert(TileM % kAivPerAic == 0,
                  "M shard must split evenly across the paired AIV cores");
    constexpr uint32_t rowsPerLane = TileM / kAivPerAic;
    const uint32_t alignedN = static_cast<uint32_t>(
        ((shape.n + 15) / 16) * 16);
    const uint32_t baseN = std::min<uint32_t>(TileN, alignedN);
    const matmul_tiling::DataType dataType = inputDtype == 1
        ? matmul_tiling::DataType::DT_FLOAT16
        : matmul_tiling::DataType::DT_BF16;

    matmul_tiling::MultiCoreMatmulTiling tiling(*GetAscendPlatform());
    // Each AIV client submits an independent rowsPerLane x N Matmul to the
    // paired AIC. SetDim(1) prevents the library tiler from splitting N a
    // second time between the two clients.
    if (tiling.SetDim(1) != 0 ||
        tiling.SetAType(matmul_tiling::TPosition::GM,
                        matmul_tiling::CubeFormat::ND,
                        dataType, transposeX1) != 0 ||
        tiling.SetBType(matmul_tiling::TPosition::GM,
                        matmul_tiling::CubeFormat::ND,
                        dataType, transposeX2) != 0 ||
        tiling.SetCType(matmul_tiling::TPosition::VECIN,
                        matmul_tiling::CubeFormat::ND,
                        matmul_tiling::DataType::DT_FLOAT) != 0 ||
        tiling.SetBiasType(matmul_tiling::TPosition::GM,
                           matmul_tiling::CubeFormat::ND,
                           matmul_tiling::DataType::DT_FLOAT) != 0 ||
        tiling.SetOrgShape(static_cast<int32_t>(shape.m),
                           static_cast<int32_t>(shape.n),
                           static_cast<int32_t>(shape.k)) != 0 ||
        tiling.SetShape(static_cast<int32_t>(rowsPerLane),
                        static_cast<int32_t>(shape.n),
                        static_cast<int32_t>(shape.k)) != 0 ||
        tiling.EnableBias(false) != 0 ||
        tiling.SetTraverse(matmul_tiling::MatrixTraverse::FIRSTM) != 0 ||
        tiling.SetFixSplit(static_cast<int32_t>(rowsPerLane),
                           static_cast<int32_t>(baseN),
                           static_cast<int32_t>(TileK)) != 0 ||
        tiling.SetBufferSpace(-1, -1, -1) != 0) {
        throw std::runtime_error("Failed to configure automatic fused Matmul tiling");
    }

    AscendC::tiling::TCubeTiling result{};
    if (tiling.GetTiling(result) != 0) {
        throw std::runtime_error("Failed to generate automatic fused Matmul tiling");
    }
    if (result.baseM != static_cast<int32_t>(rowsPerLane) ||
        result.baseN < 1 || result.baseN > static_cast<int32_t>(TileN) ||
        result.baseN % 8 != 0 || result.usedCoreNum != 1 ||
        result.singleCoreM != static_cast<int32_t>(rowsPerLane) ||
        result.singleCoreN < static_cast<int32_t>(shape.n)) {
        throw std::runtime_error(
            "Automatic Matmul tiling did not preserve full-N row ownership");
    }
    return result;
}

}  // namespace bmms
// ===== END host/fused_tiling.h =====

// ===== BEGIN tiling/tiling_policy.h =====
#include "submission_policy.h"

namespace bmms {

inline uint64_t CeilDivU64(uint64_t value, uint64_t divisor) {
    return (value + divisor - 1) / divisor;
}

inline uint64_t AlignUpU64(uint64_t value, uint64_t alignment) {
    return CeilDivU64(value, alignment) * alignment;
}

inline TilingKey SelectTilingKey(const Shape& shape, int64_t availableCoreNum,
                                 int32_t inputDtype, bool transposeX1, bool transposeX2) {
    if (availableCoreNum < 1) {
        throw std::invalid_argument("No compute cores are available");
    }
    const TilingKey key = SelectSubmissionTilingKey(
        shape, availableCoreNum, inputDtype, transposeX1, transposeX2);
    const StaticTilingConfig* config = FindTilingConfig(key);
    if (config == nullptr) {
        throw std::invalid_argument("Submission policy selected an unknown tiling key");
    }
    if (!config->implemented) {
        throw std::invalid_argument(
            std::string("Submission policy selected an unimplemented tiling key: ") +
            config->name);
    }
    return key;
}

inline Plan MakePlan(const Shape& shape, int64_t availableCoreNum, TilingKey key) {
    if (availableCoreNum < 1) {
        throw std::invalid_argument("No compute cores are available");
    }
    const StaticTilingConfig* config = FindTilingConfig(key);
    if (config == nullptr) {
        throw std::invalid_argument("Unknown tiling key");
    }
    if (!config->implemented) {
        throw std::invalid_argument(std::string("Tiling key is not implemented: ") + config->name);
    }

    TilingData data{};
    data.b = shape.b;
    data.m = shape.m;
    data.n = shape.n;
    data.k = shape.k;
    data.tileM = config->tileM;
    data.tileN = config->tileN;
    data.tileK = config->tileK;
    data.vecM = config->vecM;
    data.vecN = config->vecN;
    data.splitN = config->splitN;
    data.systemWorkspaceBytes = 0;
    data.partialScoreOffsetBytes = 0;

    if (config->path == KernelPath::REFERENCE) {
        const uint64_t taskCount = static_cast<uint64_t>(shape.b) * shape.m;
        data.splitM = static_cast<uint32_t>(std::min<int64_t>(shape.m, availableCoreNum));
        data.launchBlocks = static_cast<uint32_t>(std::min<uint64_t>(taskCount, availableCoreNum));
        data.workspaceBytes = AlignUpU64(shape.b, kAtomicAlignmentFloats) * sizeof(float);
    } else if (config->path == KernelPath::AUTO_FUSED) {
        const uint64_t mGroups = CeilDivU64(shape.m, config->tileM);
        const uint64_t tasks = static_cast<uint64_t>(shape.b) * mGroups;
        data.splitM = static_cast<uint32_t>(std::min<uint64_t>(mGroups, availableCoreNum));
        data.launchBlocks = static_cast<uint32_t>(std::min<uint64_t>(tasks, availableCoreNum));
        data.systemWorkspaceBytes = QueryMatmulSystemWorkspaceBytes();
        data.partialScoreOffsetBytes = AlignUpU64(data.systemWorkspaceBytes, 512);
        const uint64_t partialBytes = tasks * kAivPerAic * sizeof(float);
        data.workspaceBytes = AlignUpU64(
            data.partialScoreOffsetBytes + partialBytes, 512);
    } else {
        throw std::invalid_argument("Unknown kernel path");
    }
    return Plan{key, config->path, config->name, data};
}

inline Plan SelectPlan(const Shape& shape, int64_t availableCoreNum,
                       int32_t inputDtype, bool transposeX1, bool transposeX2) {
    return MakePlan(shape, availableCoreNum,
                    SelectTilingKey(shape, availableCoreNum, inputDtype,
                                    transposeX1, transposeX2));
}

}  // namespace bmms
// ===== END tiling/tiling_policy.h =====

// ===== BEGIN kernels/reference.asc =====
namespace bmms {

__aicore__ inline uint32_t AtomicOutputElements(int64_t batches) {
    return static_cast<uint32_t>(
        (batches + kAtomicAlignmentFloats - 1) / kAtomicAlignmentFloats *
        kAtomicAlignmentFloats);
}

__aicore__ inline void AtomicAddBatchSums(
        AscendC::GlobalTensor<float>& atomicOutput,
        AscendC::LocalTensor<float>& localSums, uint32_t elementCount) {
    AscendC::SetFlag<AscendC::HardEvent::S_MTE3>(0);
    AscendC::WaitFlag<AscendC::HardEvent::S_MTE3>(0);
    AscendC::SetAtomicAdd<float>();
    AscendC::DataCopy(atomicOutput, localSums, elementCount);
    AscendC::DisableDmaAtomic();
}

template<class T>
__aicore__ inline float Decode(uint16_t bits) {
    union {
        uint16_t bits;
        half value;
    } value;
    value.bits = bits;
    return static_cast<float>(value.value);
}

template<>
__aicore__ inline float Decode<bfloat16_t>(uint16_t bits) {
    union {
        uint32_t bits;
        float value;
    } value;
    value.bits = static_cast<uint32_t>(bits) << 16;
    return value.value;
}

// Correctness path. Each worker owns complete (batch, row) tasks, accumulates
// per-batch sums in UB, then issues exactly one aligned atomic GM write.
template<class T, bool TX1, bool TX2>
__global__ __vector__ void RowMax(GM_ADDR x1, GM_ADDR x2, GM_ADDR atomicOutputAddress,
                                  Shape shape, int64_t taskCount,
                                  int64_t workerCount) {
    AscendC::GlobalTensor<uint16_t> lhs;
    AscendC::GlobalTensor<uint16_t> rhs;
    AscendC::GlobalTensor<float> atomicOutput;
    lhs.SetGlobalBuffer(reinterpret_cast<__gm__ uint16_t*>(x1));
    rhs.SetGlobalBuffer(reinterpret_cast<__gm__ uint16_t*>(x2));
    atomicOutput.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(atomicOutputAddress));

    AscendC::TPipe pipe;
    AscendC::TBuf<AscendC::TPosition::VECCALC> atomicBuffer;
    pipe.InitBuffer(atomicBuffer, kMaxOutputBatches * sizeof(float));
    auto localSums = atomicBuffer.Get<float>();
    const uint32_t atomicElements = AtomicOutputElements(shape.b);
    for (uint32_t index = 0; index < atomicElements; ++index) {
        localSums.SetValue(index, 0.0f);
    }

    const int64_t workerId = AscendC::GetBlockIdx();
    for (int64_t taskId = workerId; taskId < taskCount; taskId += workerCount) {
        const int64_t batch = taskId / shape.m;
        const int64_t row = taskId - batch * shape.m;
        float best = -__builtin_inff();

        for (int64_t column = 0; column < shape.n; ++column) {
            float dot = 0.0f;
            for (int64_t depth = 0; depth < shape.k; ++depth) {
                const uint64_t lhsIndex = static_cast<uint64_t>(batch) * shape.m * shape.k +
                    (TX1 ? static_cast<uint64_t>(depth) * shape.m + row
                         : static_cast<uint64_t>(row) * shape.k + depth);
                const uint64_t rhsIndex = static_cast<uint64_t>(batch) * shape.n * shape.k +
                    (TX2 ? static_cast<uint64_t>(column) * shape.k + depth
                         : static_cast<uint64_t>(depth) * shape.n + column);
                dot += Decode<T>(lhs.GetValue(lhsIndex)) * Decode<T>(rhs.GetValue(rhsIndex));
            }
            best = dot > best ? dot : best;
        }
        const uint32_t batchIndex = static_cast<uint32_t>(batch);
        localSums.SetValue(batchIndex, localSums.GetValue(batchIndex) + best);
    }
    AtomicAddBatchSums(atomicOutput, localSums, atomicElements);
}

template<class T>
void LaunchRowMax(GM_ADDR x1, GM_ADDR x2, GM_ADDR atomicOutput, Shape shape,
                  int64_t workerCount, aclrtStream stream,
                  bool transposeX1, bool transposeX2) {
    const int64_t taskCount = shape.b * shape.m;
    if (transposeX1 && transposeX2) {
        RowMax<T, true, true><<<workerCount, nullptr, stream>>>(
            x1, x2, atomicOutput, shape, taskCount, workerCount);
    } else if (transposeX1) {
        RowMax<T, true, false><<<workerCount, nullptr, stream>>>(
            x1, x2, atomicOutput, shape, taskCount, workerCount);
    } else if (transposeX2) {
        RowMax<T, false, true><<<workerCount, nullptr, stream>>>(
            x1, x2, atomicOutput, shape, taskCount, workerCount);
    } else {
        RowMax<T, false, false><<<workerCount, nullptr, stream>>>(
            x1, x2, atomicOutput, shape, taskCount, workerCount);
    }
}

}  // namespace bmms
// ===== END kernels/reference.asc =====

// ===== BEGIN kernels/auto_matmul_fused.asc =====
#include "lib/matmul_intf.h"

namespace bmms {

using namespace AscendC;

template<class T, bool TX1, bool TX2,
         uint32_t TileM, uint32_t TileN, uint32_t TileK>
class AutoMatmulFusedKernel {
public:
    static constexpr uint32_t RowsPerLane = TileM / kAivPerAic;
    static constexpr uint32_t FloatRepeat = 64;
    static constexpr uint32_t MaxSegments =
        (TileN + FloatRepeat - 1) / FloatRepeat;

    using AType = MatmulType<TPosition::GM, CubeFormat::ND, T, TX1>;
    using BType = MatmulType<TPosition::GM, CubeFormat::ND, T, TX2>;
    using CType = MatmulType<TPosition::VECIN, CubeFormat::ND, float>;
    using BiasType = MatmulType<TPosition::GM, CubeFormat::ND, float>;

    matmul::Matmul<AType, BType, CType, BiasType> matmulObj;

    __aicore__ inline void Init(
            GM_ADDR x1, GM_ADDR x2, GM_ADDR workspaceAddress,
            const TCubeTiling& cubeTiling, Shape shape,
            uint32_t cubeBlocks, uint64_t partialScoreOffsetBytes,
            TPipe* pipe) {
        static_assert(TileM % kAivPerAic == 0,
                      "M shard must split evenly across paired AIV cores");
        static_assert(TileN % 8 == 0,
                      "N tile stride must be a whole number of data blocks");
        this->shape = shape;
        this->cubeTiling = cubeTiling;
        this->cubeBlocks = cubeBlocks;

        lhs.SetGlobalBuffer(reinterpret_cast<__gm__ T*>(x1));
        rhs.SetGlobalBuffer(reinterpret_cast<__gm__ T*>(x2));
        partialScores.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(
            workspaceAddress + partialScoreOffsetBytes));

        pipe->InitBuffer(cQueue, 1, RowsPerLane * TileN * sizeof(float));
        pipe->InitBuffer(rowMaxBuffer, RowsPerLane * sizeof(float));
        pipe->InitBuffer(segmentMaxBuffer,
                         RowsPerLane * MaxSegments * 2 * sizeof(float));
    }

    __aicore__ inline void Process() {
        const uint32_t rawBlock = GetBlockIdx();
        const uint32_t taskRatio = static_cast<uint32_t>(GetTaskRation());
        const uint32_t logicalCore = rawBlock / taskRatio;
        const uint32_t vectorLane = rawBlock - logicalCore * taskRatio;
        const uint64_t mGroups =
            (static_cast<uint64_t>(shape.m) + TileM - 1) / TileM;
        const uint64_t taskCount = static_cast<uint64_t>(shape.b) * mGroups;

        LocalTensor<float> rowMax = rowMaxBuffer.Get<float>();
        LocalTensor<float> segmentMax = segmentMaxBuffer.Get<float>();

        for (uint64_t task = logicalCore; task < taskCount;
             task += cubeBlocks) {
            const uint64_t batch = task / mGroups;
            const uint64_t mGroup = task - batch * mGroups;
            const uint64_t rowBase = mGroup * TileM;
            const uint32_t actualM = static_cast<uint32_t>(
                shape.m - static_cast<int64_t>(rowBase) < TileM
                    ? shape.m - static_cast<int64_t>(rowBase) : TileM);
            const uint32_t laneRowBase = vectorLane * RowsPerLane;
            const uint32_t laneRows = actualM > laneRowBase
                ? (actualM - laneRowBase < RowsPerLane
                       ? actualM - laneRowBase : RowsPerLane)
                : 0;

            if (laneRows == 0) {
                partialScores.SetValue(
                    task * kAivPerAic + vectorLane, 0.0f);
                continue;
            }
            for (uint32_t row = 0; row < RowsPerLane; ++row) {
                rowMax.SetValue(row, -__builtin_inff());
            }

            const uint64_t globalRowBase = rowBase + laneRowBase;
            const uint64_t lhsBatch =
                batch * static_cast<uint64_t>(shape.m) * shape.k;
            const uint64_t rhsBatch =
                batch * static_cast<uint64_t>(shape.n) * shape.k;
            const uint64_t lhsOffset = lhsBatch +
                (TX1 ? globalRowBase
                     : globalRowBase * static_cast<uint64_t>(shape.k));

            matmulObj.SetOrgShape(
                static_cast<int>(shape.m), static_cast<int>(shape.n),
                static_cast<int>(shape.k), static_cast<int>(shape.k),
                static_cast<int>(shape.n));
            matmulObj.SetTensorA(lhs[lhsOffset], TX1);
            matmulObj.SetTensorB(rhs[rhsBatch], TX2);
            matmulObj.DisableBias();
            matmulObj.SetTail(static_cast<int>(laneRows),
                              static_cast<int>(shape.n),
                              static_cast<int>(shape.k));

            uint32_t nTile = 0;
            while (matmulObj.template Iterate<true>()) {
                LocalTensor<float> cLocal = cQueue.AllocTensor<float>();
                matmulObj.template GetTensorC<true>(cLocal, 0, true);
                cQueue.EnQue(cLocal);
                cLocal = cQueue.DeQue<float>();
                ReduceTile(cLocal, rowMax, segmentMax, laneRows, nTile);
                cQueue.FreeTensor(cLocal);
                ++nTile;
            }

            float laneSum = 0.0f;
            for (uint32_t row = 0; row < laneRows; ++row) {
                laneSum += rowMax.GetValue(row);
            }
            partialScores.SetValue(
                task * kAivPerAic + vectorLane, laneSum);
        }
        matmulObj.End();
    }

private:
    __aicore__ inline void ReduceTile(
            const LocalTensor<float>& tile,
            LocalTensor<float>& rowMax,
            LocalTensor<float>& segmentMax,
            uint32_t laneRows, uint32_t nTile) {
        const uint32_t baseN = static_cast<uint32_t>(cubeTiling.baseN);
        const uint32_t columnBase = nTile * baseN;
        const uint32_t actualN = static_cast<uint32_t>(
            shape.n - static_cast<int64_t>(columnBase) < baseN
                ? shape.n - static_cast<int64_t>(columnBase) : baseN);
        const uint32_t activeSegments =
            (actualN + FloatRepeat - 1) / FloatRepeat;

        for (uint32_t segment = 0; segment < activeSegments; ++segment) {
            const uint32_t segmentStart = segment * FloatRepeat;
            const uint32_t segmentCount = actualN - segmentStart < FloatRepeat
                ? actualN - segmentStart : FloatRepeat;
            WholeReduceMax(
                segmentMax[segment * RowsPerLane * 2], tile[segmentStart],
                static_cast<int32_t>(segmentCount),
                static_cast<int32_t>(laneRows), 1, 1,
                static_cast<int32_t>(baseN / 8),
                ReduceOrder::ORDER_ONLY_VALUE);
        }
        SetFlag<HardEvent::V_S>(0);
        WaitFlag<HardEvent::V_S>(0);
        for (uint32_t row = 0; row < laneRows; ++row) {
            float best = rowMax.GetValue(row);
            for (uint32_t segment = 0; segment < activeSegments; ++segment) {
                const float value = segmentMax.GetValue(
                    segment * RowsPerLane * 2 + row);
                best = value > best ? value : best;
            }
            rowMax.SetValue(row, best);
        }
    }

    Shape shape{};
    TCubeTiling cubeTiling{};
    uint32_t cubeBlocks = 0;
    GlobalTensor<T> lhs;
    GlobalTensor<T> rhs;
    GlobalTensor<float> partialScores;
    TQue<TPosition::VECIN, 1> cQueue;
    TBuf<TPosition::VECCALC> rowMaxBuffer;
    TBuf<TPosition::VECCALC> segmentMaxBuffer;
};

template<class T, bool TX1, bool TX2,
         uint32_t TileM, uint32_t TileN, uint32_t TileK>
__global__ __mix__(1, 2) void BatchMatmulMaxSumAutoFused(
        GM_ADDR x1, GM_ADDR x2,
        __kfc_workspace__ GM_ADDR workspaceAddress,
        TCubeTiling cubeTiling, Shape shape, uint32_t cubeBlocks,
        uint64_t partialScoreOffsetBytes) {
    TPipe pipe;
    AutoMatmulFusedKernel<T, TX1, TX2, TileM, TileN, TileK> kernel;
    REGIST_MATMUL_OBJ(&pipe, GetSysWorkSpacePtr(), kernel.matmulObj,
                      &cubeTiling);
    kernel.Init(x1, x2, workspaceAddress, cubeTiling, shape, cubeBlocks,
                partialScoreOffsetBytes, &pipe);
    kernel.Process();
}

template<class T, bool TX1, bool TX2,
         uint32_t TileM, uint32_t TileN, uint32_t TileK>
inline void LaunchBatchMatmulMaxSumAutoFused(
        GM_ADDR x1, GM_ADDR x2, GM_ADDR workspace,
        const TCubeTiling& cubeTiling, Shape shape,
        uint32_t cubeBlocks, uint64_t partialScoreOffsetBytes,
        aclrtStream stream) {
    BatchMatmulMaxSumAutoFused<T, TX1, TX2, TileM, TileN, TileK>
        <<<cubeBlocks, nullptr, stream>>>(
            x1, x2, workspace, cubeTiling, shape, cubeBlocks,
            partialScoreOffsetBytes);
}

template<class T, uint32_t TileM, uint32_t TileN, uint32_t TileK>
inline void LaunchBatchMatmulMaxSumAutoFusedByTranspose(
        GM_ADDR x1, GM_ADDR x2, GM_ADDR workspace,
        const TCubeTiling& cubeTiling, Shape shape,
        uint32_t cubeBlocks, uint64_t partialScoreOffsetBytes,
        aclrtStream stream, bool transposeX1, bool transposeX2) {
    if (transposeX1 && transposeX2) {
        LaunchBatchMatmulMaxSumAutoFused<T, true, true,
                                         TileM, TileN, TileK>(
            x1, x2, workspace, cubeTiling, shape, cubeBlocks,
            partialScoreOffsetBytes, stream);
    } else if (transposeX1) {
        LaunchBatchMatmulMaxSumAutoFused<T, true, false,
                                         TileM, TileN, TileK>(
            x1, x2, workspace, cubeTiling, shape, cubeBlocks,
            partialScoreOffsetBytes, stream);
    } else if (transposeX2) {
        LaunchBatchMatmulMaxSumAutoFused<T, false, true,
                                         TileM, TileN, TileK>(
            x1, x2, workspace, cubeTiling, shape, cubeBlocks,
            partialScoreOffsetBytes, stream);
    } else {
        LaunchBatchMatmulMaxSumAutoFused<T, false, false,
                                         TileM, TileN, TileK>(
            x1, x2, workspace, cubeTiling, shape, cubeBlocks,
            partialScoreOffsetBytes, stream);
    }
}

}  // namespace bmms
// ===== END kernels/auto_matmul_fused.asc =====

// ===== BEGIN kernels/final_reduce.asc =====
namespace bmms {

template<uint32_t TileM>
__global__ __vector__ void ReduceAutoFusedPartialScores(
        GM_ADDR workspaceAddress, GM_ADDR yAddress, Shape shape,
        uint64_t partialScoreOffsetBytes) {
    const uint32_t batch = AscendC::GetBlockIdx();
    if (batch >= static_cast<uint32_t>(shape.b)) {
        return;
    }

    AscendC::GlobalTensor<float> partialScores;
    AscendC::GlobalTensor<float> output;
    partialScores.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(
        workspaceAddress + partialScoreOffsetBytes));
    output.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(yAddress));

    const uint64_t mGroups =
        (static_cast<uint64_t>(shape.m) + TileM - 1) / TileM;
    const uint64_t firstTask = static_cast<uint64_t>(batch) * mGroups;
    float total = 0.0f;
    for (uint64_t mGroup = 0; mGroup < mGroups; ++mGroup) {
        const uint64_t task = firstTask + mGroup;
        for (uint32_t lane = 0; lane < kAivPerAic; ++lane) {
            total += partialScores.GetValue(
                task * kAivPerAic + lane);
        }
    }
    output.SetValue(batch, total);
}

template<uint32_t TileM>
inline void LaunchReduceAutoFusedPartialScores(
        GM_ADDR workspace, GM_ADDR y, Shape shape,
        uint64_t partialScoreOffsetBytes, aclrtStream stream) {
    ReduceAutoFusedPartialScores<TileM>
        <<<static_cast<uint32_t>(shape.b), nullptr, stream>>>(
            workspace, y, shape, partialScoreOffsetBytes);
}

}  // namespace bmms
// ===== END kernels/final_reduce.asc =====

// ===== BEGIN kernels/kernel_dispatch.asc =====
namespace bmms {

// The competition ABI has no workspace parameter. Cache one allocation and
// one host-side Matmul tiling value per stream and exact execution plan so
// run_kernel stays asynchronous after the first use.
struct ExecutionResourceKey {
    aclrtStream stream;
    TilingKey tilingKey;
    Shape shape;
    int32_t inputDtype;
    bool transposeX1;
    bool transposeX2;
    uint32_t launchBlocks;
    uint64_t workspaceBytes;
};

struct CachedExecutionResources {
    ExecutionResourceKey key;
    GM_ADDR workspace;
    uint64_t workspaceBytes;
    AscendC::tiling::TCubeTiling cubeTiling;
};

inline bool SameExecutionResourceKey(
        const ExecutionResourceKey& lhs, const ExecutionResourceKey& rhs) {
    return lhs.stream == rhs.stream && lhs.tilingKey == rhs.tilingKey &&
           lhs.shape.b == rhs.shape.b && lhs.shape.m == rhs.shape.m &&
           lhs.shape.n == rhs.shape.n && lhs.shape.k == rhs.shape.k &&
           lhs.inputDtype == rhs.inputDtype &&
           lhs.transposeX1 == rhs.transposeX1 &&
           lhs.transposeX2 == rhs.transposeX2 &&
           lhs.launchBlocks == rhs.launchBlocks &&
           lhs.workspaceBytes == rhs.workspaceBytes;
}

inline std::vector<CachedExecutionResources>& ExecutionResourceCache() {
    static std::vector<CachedExecutionResources> cache;
    return cache;
}

inline std::atomic_flag& ExecutionResourceCacheLock() {
    static std::atomic_flag lock = ATOMIC_FLAG_INIT;
    return lock;
}

class ExecutionResourceCacheGuard {
public:
    ExecutionResourceCacheGuard() {
        while (ExecutionResourceCacheLock().test_and_set(
                   std::memory_order_acquire)) {
        }
    }

    ~ExecutionResourceCacheGuard() {
        ExecutionResourceCacheLock().clear(std::memory_order_release);
    }

    ExecutionResourceCacheGuard(const ExecutionResourceCacheGuard&) = delete;
    ExecutionResourceCacheGuard& operator=(
        const ExecutionResourceCacheGuard&) = delete;
};

inline GM_ADDR AllocatePersistentDeviceBuffer(
        uint64_t bytes, const char* operation) {
    if (bytes == 0) {
        throw std::invalid_argument(
            "Persistent device buffer must not be empty");
    }
    void* address = nullptr;
    CheckAcl(aclrtMalloc(&address, static_cast<size_t>(bytes),
                         ACL_MEM_MALLOC_HUGE_FIRST), operation);
    return static_cast<uint8_t*>(address);
}

inline ExecutionResourceKey MakeExecutionResourceKey(
        const Plan& plan, aclrtStream stream, int32_t inputDtype,
        bool transposeX1, bool transposeX2) {
    return ExecutionResourceKey{
        stream,
        plan.key,
        Shape{plan.tiling.b, plan.tiling.m,
              plan.tiling.n, plan.tiling.k},
        inputDtype,
        transposeX1,
        transposeX2,
        plan.tiling.launchBlocks,
        plan.tiling.workspaceBytes};
}

template<class Factory>
inline CachedExecutionResources GetOrCreateExecutionResources(
        const ExecutionResourceKey& key, Factory factory) {
    ExecutionResourceCacheGuard guard;
    for (const auto& resources : ExecutionResourceCache()) {
        if (SameExecutionResourceKey(resources.key, key)) {
            return resources;
        }
    }
    CachedExecutionResources resources = factory();
    ExecutionResourceCache().push_back(resources);
    return resources;
}

inline CachedExecutionResources GetReferenceExecutionResources(
        const Plan& plan, aclrtStream stream, int32_t inputDtype,
        bool transposeX1, bool transposeX2) {
    const ExecutionResourceKey key = MakeExecutionResourceKey(
        plan, stream, inputDtype, transposeX1, transposeX2);
    return GetOrCreateExecutionResources(key, [&]() {
        return CachedExecutionResources{
            key,
            AllocatePersistentDeviceBuffer(
                plan.tiling.workspaceBytes,
                "aclrtMalloc(reference workspace cache)"),
            plan.tiling.workspaceBytes,
            AscendC::tiling::TCubeTiling{}};
    });
}

template<uint32_t TileM, uint32_t TileN, uint32_t TileK>
inline CachedExecutionResources GetAutoFusedExecutionResources(
        const Plan& plan, aclrtStream stream, int32_t inputDtype,
        bool transposeX1, bool transposeX2) {
    const ExecutionResourceKey key = MakeExecutionResourceKey(
        plan, stream, inputDtype, transposeX1, transposeX2);
    return GetOrCreateExecutionResources(key, [&]() {
        const Shape shape{plan.tiling.b, plan.tiling.m,
                          plan.tiling.n, plan.tiling.k};
        return CachedExecutionResources{
            key,
            AllocatePersistentDeviceBuffer(
                plan.tiling.workspaceBytes,
                "aclrtMalloc(auto fused workspace cache)"),
            plan.tiling.workspaceBytes,
            MakeAutoFusedCubeTiling<TileM, TileN, TileK>(
                shape, inputDtype, transposeX1, transposeX2)};
    });
}

inline void ExecuteReferencePlan(
        const Plan& plan, GM_ADDR x1, GM_ADDR x2, GM_ADDR y,
        int32_t inputDtype, aclrtStream stream,
        bool transposeX1, bool transposeX2) {
    const CachedExecutionResources resources =
        GetReferenceExecutionResources(
            plan, stream, inputDtype, transposeX1, transposeX2);
    GM_ADDR atomicOutput = resources.workspace;
    const Shape shape{plan.tiling.b, plan.tiling.m,
                      plan.tiling.n, plan.tiling.k};
    CheckAcl(aclrtMemsetAsync(
                 atomicOutput,
                 static_cast<size_t>(resources.workspaceBytes), 0,
                 static_cast<size_t>(resources.workspaceBytes), stream),
             "aclrtMemsetAsync(reference atomic output)");

    if (inputDtype == 1) {
        LaunchRowMax<half>(x1, x2, atomicOutput, shape,
                           plan.tiling.launchBlocks, stream,
                           transposeX1, transposeX2);
    } else {
        LaunchRowMax<bfloat16_t>(x1, x2, atomicOutput, shape,
                                  plan.tiling.launchBlocks, stream,
                                  transposeX1, transposeX2);
    }
    const size_t outputBytes =
        static_cast<size_t>(shape.b) * sizeof(float);
    CheckAcl(aclrtMemcpyAsync(
                 y, outputBytes, atomicOutput, outputBytes,
                 ACL_MEMCPY_DEVICE_TO_DEVICE, stream),
             "aclrtMemcpyAsync(reference atomic output to y)");
}

template<uint32_t TileM, uint32_t TileN, uint32_t TileK>
inline void ExecuteAutoFusedPlan(
        const Plan& plan, GM_ADDR x1, GM_ADDR x2, GM_ADDR y,
        int32_t inputDtype, aclrtStream stream,
        bool transposeX1, bool transposeX2) {
    const Shape shape{plan.tiling.b, plan.tiling.m,
                      plan.tiling.n, plan.tiling.k};
    const CachedExecutionResources resources =
        GetAutoFusedExecutionResources<TileM, TileN, TileK>(
            plan, stream, inputDtype, transposeX1, transposeX2);

    if (inputDtype == 1) {
        LaunchBatchMatmulMaxSumAutoFusedByTranspose<
            half, TileM, TileN, TileK>(
                x1, x2, resources.workspace, resources.cubeTiling,
                shape, plan.tiling.launchBlocks,
                plan.tiling.partialScoreOffsetBytes, stream,
                transposeX1, transposeX2);
    } else {
        LaunchBatchMatmulMaxSumAutoFusedByTranspose<
            bfloat16_t, TileM, TileN, TileK>(
                x1, x2, resources.workspace, resources.cubeTiling,
                shape, plan.tiling.launchBlocks,
                plan.tiling.partialScoreOffsetBytes, stream,
                transposeX1, transposeX2);
    }
    LaunchReduceAutoFusedPartialScores<TileM>(
        resources.workspace, y, shape,
        plan.tiling.partialScoreOffsetBytes, stream);
}

inline void ExecutePlan(
        const Plan& plan, GM_ADDR x1, GM_ADDR x2, GM_ADDR y,
        int32_t inputDtype, aclrtStream stream,
        bool transposeX1, bool transposeX2) {
    switch (plan.path) {
        case KernelPath::REFERENCE:
            ExecuteReferencePlan(plan, x1, x2, y, inputDtype, stream,
                                 transposeX1, transposeX2);
            return;
        case KernelPath::AUTO_FUSED:
            if (plan.key != TilingKey::AUTO_MATMUL_FUSED) {
                throw std::invalid_argument(
                    "Selected automatic fused key is not implemented");
            }
            ExecuteAutoFusedPlan<64, 128, 64>(
                plan, x1, x2, y, inputDtype, stream,
                transposeX1, transposeX2);
            return;
    }
    throw std::invalid_argument("Selected kernel path is invalid");
}

}  // namespace bmms
// ===== END kernels/kernel_dispatch.asc =====

// ===== BEGIN kernel.asc =====
// Included by the local or competition Host driver.

extern "C" void run_kernel(GM_ADDR x1, const TensorGroupInfo& info_x1,
    GM_ADDR x2, const TensorGroupInfo& info_x2, GM_ADDR y, const TensorGroupInfo& info_y,
    int64_t availableCoreNum, aclrtStream stream, bool transposeX1, bool transposeX2) {
    const bmms::Shape shape = bmms::ValidateInputs(
        x1, info_x1, x2, info_x2, y, info_y, transposeX1, transposeX2);
    const bmms::TilingKey key = bmms::SelectTilingKey(
        shape, availableCoreNum, info_x1.tensors[0].dtype, transposeX1, transposeX2);
    const bmms::StaticTilingConfig* config = bmms::FindTilingConfig(key);
    const int64_t computeCoreNum = config->path == bmms::KernelPath::REFERENCE
        ? availableCoreNum : bmms::QueryCubeCoreCount();
    const bmms::Plan plan = bmms::MakePlan(shape, computeCoreNum, key);
    bmms::ExecutePlan(plan, x1, x2, y, info_x1.tensors[0].dtype, stream,
                      transposeX1, transposeX2);
}
// ===== END kernel.asc =====
