// Direct invocation driver. No arguments retains the original case0 paths.
#include <algorithm>
#include <cstdint>
#include <cstdio>
#include <cstdlib>
#include <cstring>
#include <cmath>
#include <chrono>
#include <limits>
#include <stdexcept>
#include <string>
#include <vector>
#include "acl/acl.h"
#include "data_utils.h"
#ifndef TENSOR_GROUP_INFO_DEFINED
#define TENSOR_GROUP_INFO_DEFINED
struct TensorInfo { const int64_t* shape; int64_t numDims; int32_t dtype; };
struct TensorGroupInfo { const TensorInfo* tensors; int64_t numTensors; };
#endif
#ifdef BMMS_USE_SUBMISSION_BUNDLE
#include "submission/kernel.asc"
#else
#include "kernel.asc"
#endif

static void Check(aclError code,const char* op) {
    if(code!=ACL_SUCCESS) throw std::runtime_error(std::string(op)+": "+std::to_string(code));
}
struct Session {
    bool initialized=false, deviceSet=false;
    aclrtStream stream=nullptr;
    void Init() {
        Check(aclInit(nullptr),"aclInit"); initialized=true;
        Check(aclrtSetDevice(0),"aclrtSetDevice"); deviceSet=true;
        Check(aclrtCreateStream(&stream),"aclrtCreateStream");
    }
    ~Session() {
        if(stream) { aclrtSynchronizeStream(stream); aclrtDestroyStream(stream); }
        if(deviceSet) aclrtResetDevice(0);
        if(initialized) aclFinalize();
    }
};
struct DeviceBuffer {
    uint8_t* ptr=nullptr;
    explicit DeviceBuffer(size_t n) {
        Check(aclrtMalloc(reinterpret_cast<void**>(&ptr),n,ACL_MEM_MALLOC_HUGE_FIRST),"aclrtMalloc");
    }
    ~DeviceBuffer() { if(ptr) aclrtFree(ptr); }
    DeviceBuffer(const DeviceBuffer&)=delete;
    DeviceBuffer& operator=(const DeviceBuffer&)=delete;
};
static int64_t Integer(const char* text) {
    size_t used=0; auto n=std::stoll(text,&used);
    if(used!=std::strlen(text)) throw std::runtime_error("Invalid integer");
    return n;
}
int main(int argc,char** argv) {
    try {
        int64_t B=1,M=1,N=1,K=32,repeats=1,warmups=0;
        int64_t forcedTilingKey=-1;
        int32_t dtype=1; bool tx1=false,tx2=false;
        std::string inputDir="./input",outputDir="./output";
        if(argc!=1) {
            if(argc<10 || argc>12) throw std::runtime_error(
                "Usage: executable B M N K float16|bfloat16 TX1 TX2 case_dir repeats [tiling_key [warmups]]");
            B=Integer(argv[1]); M=Integer(argv[2]); N=Integer(argv[3]); K=Integer(argv[4]);
            std::string type(argv[5]);
            if(type!="float16" && type!="bfloat16") throw std::runtime_error("Unsupported dtype");
            dtype=type=="float16"?1:2;
            auto a=Integer(argv[6]),b=Integer(argv[7]);
            if((a!=0&&a!=1)||(b!=0&&b!=1)) throw std::runtime_error("Transpose must be 0 or 1");
            tx1=a; tx2=b; inputDir=outputDir=argv[8]; repeats=Integer(argv[9]);
            if(argc==11) forcedTilingKey=Integer(argv[10]);
            if(argc==12) { forcedTilingKey=Integer(argv[10]); warmups=Integer(argv[11]); }
        }
        if(B<1||B>64||M<1||M>8192||N<1||N>8192||K<32||K>8192||K%8||
           B*M*K>(1LL<<26)||B*N*K>(1LL<<26)||repeats<1||repeats>10000||
           warmups<0||warmups>10000)
            throw std::runtime_error("Shape or repeat count outside supported range");
        size_t ab=2*B*M*K,bb=2*B*N*K,yb=4*B;
        std::vector<uint8_t> ha(ab),hb(bb),ca(ab),cb(bb);
        if(!ReadFile(inputDir+"/x1.bin",ab,ha.data(),ab)||!ReadFile(inputDir+"/x2.bin",bb,hb.data(),bb))
            throw std::runtime_error("Input size/read failure");
        int64_t sa[]={B,tx1?K:M,tx1?M:K},sb[]={B,tx2?N:K,tx2?K:N},sy[]={B};
        TensorInfo at{sa,3,dtype},bt{sb,3,dtype},yt{sy,1,0};
        TensorGroupInfo ai{&at,1},bi{&bt,1},yi{&yt,1};
        Session session; session.Init();
        int64_t cores=0;
        Check(aclrtGetDeviceInfo(0,ACL_DEV_ATTR_CUBE_CORE_NUM,&cores),"cube core count");
        if(cores<=0) throw std::runtime_error("No Cube cores available");
        const bmms::Shape logicalShape{B,M,N,K};
        const bmms::TilingKey selectedKey = forcedTilingKey >= 0
            ? bmms::ParseTilingKey(forcedTilingKey)
            : bmms::SelectTilingKey(logicalShape,cores,dtype,tx1,tx2);
        const bmms::Plan selectedPlan = bmms::MakePlan(logicalShape,cores,selectedKey);
        DeviceBuffer a(ab),b(bb),y(yb);
        Check(aclrtMemcpy(a.ptr,ab,ha.data(),ab,ACL_MEMCPY_HOST_TO_DEVICE),"H2D x1");
        Check(aclrtMemcpy(b.ptr,bb,hb.data(),bb,ACL_MEMCPY_HOST_TO_DEVICE),"H2D x2");
        std::vector<float> output(B),first(B),poison(B,std::numeric_limits<float>::quiet_NaN());
        auto invoke = [&]() {
            if(forcedTilingKey>=0) {
#ifdef BMMS_USE_SUBMISSION_BUNDLE
                throw std::runtime_error(
                    "Forced tiling keys are unavailable in the submission bundle");
#else
                run_kernel_forced(a.ptr,ai,b.ptr,bi,y.ptr,yi,cores,session.stream,
                                  tx1,tx2,static_cast<uint32_t>(forcedTilingKey));
#endif
            } else {
                run_kernel(a.ptr,ai,b.ptr,bi,y.ptr,yi,cores,session.stream,tx1,tx2);
            }
            Check(aclrtSynchronizeStream(session.stream),"kernel synchronize");
        };
        for(int64_t i=0;i<warmups;++i) invoke();
        double ms=0;
        double maxRepeatAbsError=0.0;
        bool repeatBitwiseEqual=true;
        constexpr double repeatRtol=1e-4;
        constexpr double repeatAtol=1e-4;
        std::vector<double> samples;
        samples.reserve(static_cast<size_t>(repeats));
        for(int64_t i=0;i<repeats;++i) {
            Check(aclrtMemcpy(y.ptr,yb,poison.data(),yb,ACL_MEMCPY_HOST_TO_DEVICE),"poison y");
            auto start=std::chrono::steady_clock::now();
            invoke();
            const double elapsed = std::chrono::duration<double,std::milli>(
                std::chrono::steady_clock::now()-start).count();
            ms+=elapsed;
            samples.push_back(elapsed);
            Check(aclrtMemcpy(output.data(),yb,y.ptr,yb,ACL_MEMCPY_DEVICE_TO_HOST),"D2H y");
            for(float v:output) if(!std::isfinite(v)) throw std::runtime_error("Non-finite or unwritten output");
            if(i==0) {
                first=output;
            } else {
                if(std::memcmp(first.data(),output.data(),yb)!=0) repeatBitwiseEqual=false;
                for(size_t index=0;index<output.size();++index) {
                    const double expected=static_cast<double>(first[index]);
                    const double actual=static_cast<double>(output[index]);
                    const double absError=std::fabs(actual-expected);
                    const double bound=repeatAtol+repeatRtol*std::fabs(expected);
                    maxRepeatAbsError=std::max(maxRepeatAbsError,absError);
                    if(absError>bound) {
                        std::fprintf(
                            stderr,
                            "Repeat mismatch: repeat=%lld batch=%zu first=%.9g "
                            "actual=%.9g abs_error=%.9g bound=%.9g\n",
                            static_cast<long long>(i),index,expected,actual,absError,bound);
                        throw std::runtime_error(
                            "Repeated output differs beyond numerical tolerance");
                    }
                }
            }
        }
        Check(aclrtMemcpy(ca.data(),ab,a.ptr,ab,ACL_MEMCPY_DEVICE_TO_HOST),"check x1");
        Check(aclrtMemcpy(cb.data(),bb,b.ptr,bb,ACL_MEMCPY_DEVICE_TO_HOST),"check x2");
        if(ca!=ha||cb!=hb) throw std::runtime_error("Input modified");
        if(!WriteFile(outputDir+"/y.bin",output.data(),yb)) throw std::runtime_error("Output write failure");
        std::sort(samples.begin(),samples.end());
        const double p50=samples[static_cast<size_t>((repeats-1)*50/100)];
        const double p95=samples[static_cast<size_t>((repeats-1)*95/100)];
        std::printf("DONE B=%lld M=%lld N=%lld K=%lld dtype=%d tx=%d%d repeats=%lld mean_call_ms=%.6f input_unchanged=1 repeat_bitwise_equal=%d repeat_within_tolerance=1 max_repeat_abs_error=%.9g\n",
            (long long)B,(long long)M,(long long)N,(long long)K,dtype,tx1,tx2,
            (long long)repeats,ms/repeats,repeatBitwiseEqual?1:0,maxRepeatAbsError);
        std::printf(
            "RESULT_JSON {\"B\":%lld,\"M\":%lld,\"N\":%lld,\"K\":%lld,"
            "\"dtype\":\"%s\",\"input_dtype\":%d,\"transpose_x1\":%s,\"transpose_x2\":%s,"
            "\"tiling_key\":%u,\"tiling_name\":\"%s\",\"tile_m\":%u,"
            "\"tile_n\":%u,\"tile_k\":%u,\"split_m\":%u,\"split_n\":%u,"
            "\"launch_blocks\":%u,\"system_workspace_bytes\":%llu,"
            "\"partial_score_offset_bytes\":%llu,\"workspace_bytes\":%llu,"
            "\"warmups\":%lld,"
            "\"repeats\":%lld,\"mean_call_ms\":%.9f,\"p50_call_ms\":%.9f,"
            "\"p95_call_ms\":%.9f,\"repeat_bitwise_equal\":%s,"
            "\"repeat_within_tolerance\":true,\"max_repeat_abs_error\":%.9g}\n",
            (long long)B,(long long)M,(long long)N,(long long)K,
            dtype==1?"float16":"bfloat16",dtype,
            tx1?"true":"false",tx2?"true":"false",
            static_cast<unsigned>(selectedKey),selectedPlan.name,
            selectedPlan.tiling.tileM,selectedPlan.tiling.tileN,selectedPlan.tiling.tileK,
            selectedPlan.tiling.splitM,selectedPlan.tiling.splitN,
            selectedPlan.tiling.launchBlocks,
            (unsigned long long)selectedPlan.tiling.systemWorkspaceBytes,
            (unsigned long long)selectedPlan.tiling.partialScoreOffsetBytes,
            (unsigned long long)selectedPlan.tiling.workspaceBytes,
            (long long)warmups,(long long)repeats,ms/repeats,p50,p95,
            repeatBitwiseEqual?"true":"false",maxRepeatAbsError);
        return 0;
    } catch(const std::exception& e) { std::fprintf(stderr,"ERROR: %s\n",e.what()); return 1; }
}
