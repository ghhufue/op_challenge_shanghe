#pragma once

#include "lib/matmul_intf.h"

namespace bmms {

using namespace AscendC;

template<class T, bool TX1, bool TX2,
         bool VectorizedReduction, bool Async, uint32_t CBufferCount,
         uint32_t TileM, uint32_t TileN, uint32_t TileK,
         bool SplitN = false>
class AutoMatmulFusedKernel {
public:
    static constexpr uint32_t RowsPerLane = TileM / kAivPerAic;
    static constexpr uint32_t FloatRepeat = 64;
    static constexpr uint32_t FloatBlockElements = 8;
    static constexpr uint32_t MaxSegments =
        (TileN + FloatRepeat - 1) / FloatRepeat;

    using AType = MatmulType<TPosition::GM, CubeFormat::ND, T, TX1>;
    using BType = MatmulType<TPosition::GM, CubeFormat::ND, T, TX2>;
    using CType = MatmulType<TPosition::VECIN, CubeFormat::ND, float>;
    using BiasType = MatmulType<TPosition::GM, CubeFormat::ND, float>;

    matmul::Matmul<AType, BType, CType, BiasType> matmulObj;

    __aicore__ inline void Init(
            GM_ADDR x1, GM_ADDR x2, GM_ADDR atomicOutputAddress,
            GM_ADDR matmulCacheAddress, uint64_t matmulCacheStrideBytes,
            GM_ADDR partialMaxAddress, uint32_t splitN,
            const TCubeTiling& cubeTiling, Shape shape,
            uint32_t cubeBlocks, TPipe* pipe) {
        static_assert(TileM % kAivPerAic == 0,
                      "M shard must split evenly across paired AIV cores");
        static_assert(TileN % 8 == 0,
                      "N tile stride must be a whole number of data blocks");
        static_assert(CBufferCount == 1 || CBufferCount == 2,
                      "C queue supports one or two UB buffers");
        static_assert(Async || CBufferCount == 1,
                      "UB double buffering requires asynchronous Matmul");
        this->shape = shape;
        this->cubeTiling = cubeTiling;
        this->cubeBlocks = cubeBlocks;
        this->matmulCacheAddress = matmulCacheAddress;
        this->matmulCacheStrideBytes = matmulCacheStrideBytes;
        this->splitN = splitN;

        lhs.SetGlobalBuffer(reinterpret_cast<__gm__ T*>(x1));
        rhs.SetGlobalBuffer(reinterpret_cast<__gm__ T*>(x2));
        atomicOutput.SetGlobalBuffer(
            reinterpret_cast<__gm__ float*>(atomicOutputAddress));
        if constexpr (SplitN) {
            partialMax.SetGlobalBuffer(
                reinterpret_cast<__gm__ float*>(partialMaxAddress));
        }

        pipe->InitBuffer(cQueue, CBufferCount,
                         RowsPerLane * TileN * sizeof(float));
        pipe->InitBuffer(rowMaxBuffer, RowsPerLane * sizeof(float));
        pipe->InitBuffer(segmentMaxBuffer,
                         RowsPerLane * MaxSegments * FloatBlockElements *
                             sizeof(float));
        pipe->InitBuffer(atomicBuffer,
                         kMaxOutputBatches * sizeof(float));
    }

    __aicore__ inline void Process() {
        const uint32_t rawBlock = GetBlockIdx();
        const uint32_t taskRatio = static_cast<uint32_t>(GetTaskRation());
        const uint32_t logicalCore = rawBlock / taskRatio;
        const uint32_t vectorLane = rawBlock - logicalCore * taskRatio;
        const uint64_t mGroups =
            (static_cast<uint64_t>(shape.m) + TileM - 1) / TileM;
        const uint64_t mTaskCount = static_cast<uint64_t>(shape.b) * mGroups;
        const uint64_t taskCount = SplitN
            ? mTaskCount * splitN : mTaskCount;

        LocalTensor<float> rowMax = rowMaxBuffer.Get<float>();
        LocalTensor<float> segmentMax = segmentMaxBuffer.Get<float>();
        LocalTensor<float> localSums = atomicBuffer.Get<float>();
        const uint32_t atomicElements = AtomicOutputElements(shape.b);
        for (uint32_t index = 0; index < atomicElements; ++index) {
            localSums.SetValue(index, 0.0f);
        }

        // The original matrix strides and bias state are invariant across
        // every (batch, M-tile) task owned by this client.  SetOrgShape emits
        // a KFC configuration message, so keep it out of the hot task loop.
        matmulObj.SetOrgShape(
            static_cast<int>(shape.m), static_cast<int>(shape.n),
            static_cast<int>(shape.k), static_cast<int>(shape.k),
            static_cast<int>(shape.n));
        matmulObj.DisableBias();

        for (uint64_t task = logicalCore; task < taskCount;
             task += cubeBlocks) {
            const uint64_t mTask = SplitN ? task / splitN : task;
            const uint32_t nShard = SplitN
                ? static_cast<uint32_t>(task - mTask * splitN) : 0;
            const uint64_t batch = mTask / mGroups;
            const uint64_t mGroup = mTask - batch * mGroups;
            const uint64_t rowBase = mGroup * TileM;
            const uint32_t actualM = static_cast<uint32_t>(
                shape.m - static_cast<int64_t>(rowBase) < TileM
                    ? shape.m - static_cast<int64_t>(rowBase) : TileM);
            const uint32_t laneRowBase = vectorLane * RowsPerLane;
            const uint32_t laneRows = actualM > laneRowBase
                ? (actualM - laneRowBase < RowsPerLane
                       ? actualM - laneRowBase : RowsPerLane)
                : 0;

            if (laneRows == 0) {
                continue;
            }
            InitRowMax(rowMax);

            const uint64_t globalRowBase = rowBase + laneRowBase;
            const uint64_t lhsBatch =
                batch * static_cast<uint64_t>(shape.m) * shape.k;
            const uint64_t rhsBatch =
                batch * static_cast<uint64_t>(shape.n) * shape.k;
            const uint64_t nBase = SplitN
                ? (static_cast<uint64_t>(shape.n) * nShard /
                   splitN / 16) * 16
                : 0;
            const uint64_t nEnd = SplitN
                ? (nShard + 1 == splitN
                       ? static_cast<uint64_t>(shape.n)
                       : (static_cast<uint64_t>(shape.n) * (nShard + 1) /
                          splitN / 16) * 16)
                : static_cast<uint64_t>(shape.n);
            const uint32_t actualShardN = SplitN
                ? static_cast<uint32_t>(nEnd - nBase)
                : static_cast<uint32_t>(shape.n);
            const uint64_t lhsOffset = lhsBatch +
                (TX1 ? globalRowBase
                     : globalRowBase * static_cast<uint64_t>(shape.k));
            const uint64_t rhsOffset = rhsBatch +
                (TX2 ? nBase * static_cast<uint64_t>(shape.k) : nBase);

            matmulObj.SetTensorA(lhs[lhsOffset], TX1);
            matmulObj.SetTensorB(rhs[rhsOffset], TX2);
            matmulObj.SetTail(static_cast<int>(laneRows),
                              static_cast<int>(actualShardN),
                              static_cast<int>(shape.k));

            if constexpr (Async) {
                ProcessAsyncTiles(rowMax, segmentMax, laneRows, rawBlock,
                                  actualShardN);
            } else {
                ProcessSynchronousTiles(rowMax, segmentMax, laneRows,
                                        actualShardN);
            }

            if constexpr (SplitN) {
                StorePartialMax(rowMax, task, vectorLane);
            } else {
                const float laneSum = ReduceLaneSum(
                    rowMax, segmentMax, laneRows);
                const uint32_t batchIndex = static_cast<uint32_t>(batch);
                localSums.SetValue(
                    batchIndex, localSums.GetValue(batchIndex) + laneSum);
            }
        }
        if constexpr (!SplitN) {
            AtomicAddBatchSums(atomicOutput, localSums, atomicElements);
        }
        matmulObj.End();
    }

private:
    __aicore__ inline void InitRowMax(LocalTensor<float>& rowMax) {
        if constexpr (VectorizedReduction) {
            Duplicate(rowMax, -__builtin_inff(),
                      static_cast<int32_t>(RowsPerLane));
        } else {
            for (uint32_t row = 0; row < RowsPerLane; ++row) {
                rowMax.SetValue(row, -__builtin_inff());
            }
        }
    }

    __aicore__ inline void ProcessSynchronousTiles(
            LocalTensor<float>& rowMax, LocalTensor<float>& segmentMax,
            uint32_t laneRows, uint32_t nExtent) {
        uint32_t nTile = 0;
        while (matmulObj.template Iterate<true>()) {
            LocalTensor<float> cLocal = cQueue.template AllocTensor<float>();
            matmulObj.template GetTensorC<true>(cLocal, 0, true);
            cQueue.EnQue(cLocal);
            cLocal = cQueue.template DeQue<float>();
            ReduceTile(cLocal, rowMax, segmentMax, laneRows, nTile,
                       nExtent);
            cQueue.FreeTensor(cLocal);
            ++nTile;
        }
    }

    __aicore__ inline void ProcessAsyncTiles(
            LocalTensor<float>& rowMax, LocalTensor<float>& segmentMax,
            uint32_t laneRows, uint32_t rawBlock, uint32_t nExtent) {
        const uint32_t baseN = static_cast<uint32_t>(cubeTiling.baseN);
        const uint32_t tileCount = static_cast<uint32_t>(
            (nExtent + baseN - 1) / baseN);
        GlobalTensor<float> clientWorkspace;
        clientWorkspace.SetGlobalBuffer(
            reinterpret_cast<__gm__ float*>(
                matmulCacheAddress + rawBlock * matmulCacheStrideBytes),
            matmulCacheStrideBytes / sizeof(float));
        matmulObj.SetWorkspace(clientWorkspace);
        matmulObj.template Iterate<false>();

        if constexpr (CBufferCount == 1) {
            for (uint32_t nTile = 0; nTile < tileCount; ++nTile) {
                LocalTensor<float> cLocal = cQueue.template AllocTensor<float>();
                matmulObj.template GetTensorC<false>(cLocal, 0, true);
                cQueue.EnQue(cLocal);
                cLocal = cQueue.template DeQue<float>();
                ReduceTile(cLocal, rowMax, segmentMax, laneRows, nTile,
                           nExtent);
                cQueue.FreeTensor(cLocal);
            }
        } else {
            LocalTensor<float> first = cQueue.template AllocTensor<float>();
            matmulObj.template GetTensorC<false>(first, 0, true);
            cQueue.EnQue(first);

            for (uint32_t nTile = 1; nTile < tileCount; ++nTile) {
                LocalTensor<float> next = cQueue.template AllocTensor<float>();
                matmulObj.template GetTensorC<false>(next, 0, true);
                cQueue.EnQue(next);

                LocalTensor<float> previous = cQueue.template DeQue<float>();
                ReduceTile(previous, rowMax, segmentMax, laneRows,
                           nTile - 1, nExtent);
                cQueue.FreeTensor(previous);
            }

            LocalTensor<float> last = cQueue.template DeQue<float>();
            ReduceTile(last, rowMax, segmentMax, laneRows, tileCount - 1,
                       nExtent);
            cQueue.FreeTensor(last);
        }
    }

    __aicore__ inline void ReduceTile(
            const LocalTensor<float>& tile,
            LocalTensor<float>& rowMax,
            LocalTensor<float>& segmentMax,
            uint32_t laneRows, uint32_t nTile, uint32_t nExtent) {
        const uint32_t baseN = static_cast<uint32_t>(cubeTiling.baseN);
        const uint32_t columnBase = nTile * baseN;
        const uint32_t actualN = static_cast<uint32_t>(
            nExtent - columnBase < baseN
                ? nExtent - columnBase : baseN);
        const uint32_t activeSegments =
            (actualN + FloatRepeat - 1) / FloatRepeat;

        if (actualN % FloatBlockElements != 0) {
            // A compact row can begin at an unaligned element offset.  Peel
            // at most one data block so every WholeReduceMax source and
            // destination is 32-byte aligned, then reduce the row remainder
            // in vector-sized segments.
            if constexpr (VectorizedReduction) {
                SetFlag<HardEvent::V_S>(0);
                WaitFlag<HardEvent::V_S>(0);
            }
            for (uint32_t row = 0; row < laneRows; ++row) {
                const uint32_t rowStart = row * actualN;
                const uint32_t misalignment =
                    rowStart % FloatBlockElements;
                uint32_t prefixCount = misalignment == 0
                    ? 0 : FloatBlockElements - misalignment;
                prefixCount = prefixCount < actualN ? prefixCount : actualN;

                float best = rowMax.GetValue(row);
                for (uint32_t column = 0; column < prefixCount; ++column) {
                    const float value = tile.GetValue(rowStart + column);
                    best = value > best ? value : best;
                }
                rowMax.SetValue(row, best);

                const uint32_t vectorCount = actualN - prefixCount;
                const uint32_t vectorSegments =
                    (vectorCount + FloatRepeat - 1) / FloatRepeat;
                for (uint32_t segment = 0; segment < vectorSegments;
                     ++segment) {
                    const uint32_t segmentStart =
                        rowStart + prefixCount + segment * FloatRepeat;
                    const uint32_t segmentCount =
                        vectorCount - segment * FloatRepeat < FloatRepeat
                            ? vectorCount - segment * FloatRepeat
                            : FloatRepeat;
                    WholeReduceMax(
                        segmentMax[row * MaxSegments * FloatBlockElements +
                                   segment * FloatBlockElements],
                        tile[segmentStart],
                        static_cast<int32_t>(segmentCount), 1, 1, 1, 1,
                        ReduceOrder::ORDER_ONLY_VALUE);
                }
            }

            SetFlag<HardEvent::V_S>(0);
            WaitFlag<HardEvent::V_S>(0);
            for (uint32_t row = 0; row < laneRows; ++row) {
                const uint32_t rowStart = row * actualN;
                const uint32_t misalignment =
                    rowStart % FloatBlockElements;
                uint32_t prefixCount = misalignment == 0
                    ? 0 : FloatBlockElements - misalignment;
                prefixCount = prefixCount < actualN ? prefixCount : actualN;
                const uint32_t vectorCount = actualN - prefixCount;
                const uint32_t vectorSegments =
                    (vectorCount + FloatRepeat - 1) / FloatRepeat;
                float best = rowMax.GetValue(row);
                for (uint32_t segment = 0; segment < vectorSegments;
                     ++segment) {
                    const float value = segmentMax.GetValue(
                        row * MaxSegments * FloatBlockElements +
                        segment * FloatBlockElements);
                    best = value > best ? value : best;
                }
                rowMax.SetValue(row, best);
            }
            if constexpr (VectorizedReduction) {
                SetFlag<HardEvent::S_V>(0);
                WaitFlag<HardEvent::S_V>(0);
            }
            return;
        }

        for (uint32_t segment = 0; segment < activeSegments; ++segment) {
            const uint32_t segmentStart = segment * FloatRepeat;
            const uint32_t segmentCount = actualN - segmentStart < FloatRepeat
                ? actualN - segmentStart : FloatRepeat;
            // Sequential GetTensorC writes every N tile compactly.  Its row
            // stride is the current tile width, not the aligned Matmul baseN.
            WholeReduceMax(
                segmentMax[segment * RowsPerLane * FloatBlockElements],
                tile[segmentStart], static_cast<int32_t>(segmentCount),
                static_cast<int32_t>(laneRows), 1, 1,
                static_cast<int32_t>(actualN / FloatBlockElements),
                ReduceOrder::ORDER_ONLY_VALUE);
        }
        if constexpr (VectorizedReduction) {
            for (uint32_t segment = 0; segment < activeSegments; ++segment) {
                Max(rowMax, rowMax,
                    segmentMax[segment * RowsPerLane * FloatBlockElements],
                    static_cast<int32_t>(laneRows));
            }
        } else {
            SetFlag<HardEvent::V_S>(0);
            WaitFlag<HardEvent::V_S>(0);
            for (uint32_t row = 0; row < laneRows; ++row) {
                float best = rowMax.GetValue(row);
                for (uint32_t segment = 0; segment < activeSegments; ++segment) {
                    const float value = segmentMax.GetValue(
                        segment * RowsPerLane * FloatBlockElements + row);
                    best = value > best ? value : best;
                }
                rowMax.SetValue(row, best);
            }
        }
    }

    __aicore__ inline float ReduceLaneSum(
            LocalTensor<float>& rowMax, LocalTensor<float>& segmentMax,
            uint32_t laneRows) {
        if constexpr (VectorizedReduction) {
            WholeReduceSum(segmentMax, rowMax,
                           static_cast<int32_t>(laneRows), 1, 1, 1, 8);
            SetFlag<HardEvent::V_S>(0);
            WaitFlag<HardEvent::V_S>(0);
            return segmentMax.GetValue(0);
        }
        float laneSum = 0.0f;
        for (uint32_t row = 0; row < laneRows; ++row) {
            laneSum += rowMax.GetValue(row);
        }
        return laneSum;
    }

    __aicore__ inline void StorePartialMax(
            LocalTensor<float>& rowMax, uint64_t task,
            uint32_t vectorLane) {
        // Row maxima may have last been produced by either Vector or Scalar
        // instructions (the compact, unaligned-N path uses both).  Join both
        // producers before MTE3 consumes the full padded lane record.
        SetFlag<HardEvent::V_MTE3>(0);
        WaitFlag<HardEvent::V_MTE3>(0);
        SetFlag<HardEvent::S_MTE3>(0);
        WaitFlag<HardEvent::S_MTE3>(0);
        const uint64_t record =
            task * kAivPerAic + static_cast<uint64_t>(vectorLane);
        DataCopy(partialMax[record * RowsPerLane], rowMax, RowsPerLane);
        SetFlag<HardEvent::MTE3_S>(0);
        WaitFlag<HardEvent::MTE3_S>(0);
    }

    Shape shape{};
    TCubeTiling cubeTiling{};
    uint32_t cubeBlocks = 0;
    GlobalTensor<T> lhs;
    GlobalTensor<T> rhs;
    GlobalTensor<float> atomicOutput;
    GlobalTensor<float> partialMax;
    GM_ADDR matmulCacheAddress = nullptr;
    uint64_t matmulCacheStrideBytes = 0;
    uint32_t splitN = 1;
    TQue<TPosition::VECIN, CBufferCount> cQueue;
    TBuf<TPosition::VECCALC> rowMaxBuffer;
    TBuf<TPosition::VECCALC> segmentMaxBuffer;
    TBuf<TPosition::VECCALC> atomicBuffer;
};

template<class T, bool TX1, bool TX2,
         bool VectorizedReduction, bool Async, uint32_t CBufferCount,
         uint32_t TileM, uint32_t TileN, uint32_t TileK,
         bool SplitN = false>
__global__ __mix__(1, 2) void BatchMatmulMaxSumAutoFused(
        GM_ADDR x1, GM_ADDR x2, GM_ADDR atomicOutputAddress,
        __kfc_workspace__ GM_ADDR workspaceAddress,
        GM_ADDR matmulCacheAddress, uint64_t matmulCacheStrideBytes,
        GM_ADDR partialMaxAddress, uint32_t splitN,
        TCubeTiling cubeTiling, Shape shape, uint32_t cubeBlocks) {
    TPipe pipe;
    AutoMatmulFusedKernel<T, TX1, TX2, VectorizedReduction, Async,
                          CBufferCount, TileM, TileN, TileK, SplitN> kernel;
    REGIST_MATMUL_OBJ(&pipe, GetSysWorkSpacePtr(), kernel.matmulObj,
                      &cubeTiling);
    kernel.Init(x1, x2, atomicOutputAddress, matmulCacheAddress,
                matmulCacheStrideBytes, partialMaxAddress, splitN,
                cubeTiling, shape, cubeBlocks, &pipe);
    kernel.Process();
}

template<class T, bool TX1, bool TX2,
         bool VectorizedReduction, bool Async, uint32_t CBufferCount,
         uint32_t TileM, uint32_t TileN, uint32_t TileK>
inline void LaunchBatchMatmulMaxSumAutoFused(
        GM_ADDR x1, GM_ADDR x2, GM_ADDR atomicOutput, GM_ADDR workspace,
        GM_ADDR matmulCache, uint64_t matmulCacheStrideBytes,
        const TCubeTiling& cubeTiling, Shape shape,
        uint32_t cubeBlocks, aclrtStream stream) {
    BatchMatmulMaxSumAutoFused<T, TX1, TX2, VectorizedReduction, Async,
                               CBufferCount, TileM, TileN, TileK>
        <<<cubeBlocks, nullptr, stream>>>(
            x1, x2, atomicOutput, workspace, matmulCache,
            matmulCacheStrideBytes, nullptr, 1,
            cubeTiling, shape, cubeBlocks);
}

template<class T, bool VectorizedReduction, bool Async,
         uint32_t CBufferCount,
         uint32_t TileM, uint32_t TileN, uint32_t TileK>
inline void LaunchBatchMatmulMaxSumAutoFusedByTranspose(
        GM_ADDR x1, GM_ADDR x2, GM_ADDR atomicOutput, GM_ADDR workspace,
        GM_ADDR matmulCache, uint64_t matmulCacheStrideBytes,
        const TCubeTiling& cubeTiling, Shape shape,
        uint32_t cubeBlocks, aclrtStream stream,
        bool transposeX1, bool transposeX2) {
    if (transposeX1 && transposeX2) {
        LaunchBatchMatmulMaxSumAutoFused<T, true, true,
                                         VectorizedReduction, Async,
                                         CBufferCount, TileM, TileN, TileK>(
            x1, x2, atomicOutput, workspace, matmulCache,
            matmulCacheStrideBytes, cubeTiling, shape,
            cubeBlocks, stream);
    } else if (transposeX1) {
        LaunchBatchMatmulMaxSumAutoFused<T, true, false,
                                         VectorizedReduction, Async,
                                         CBufferCount, TileM, TileN, TileK>(
            x1, x2, atomicOutput, workspace, matmulCache,
            matmulCacheStrideBytes, cubeTiling, shape,
            cubeBlocks, stream);
    } else if (transposeX2) {
        LaunchBatchMatmulMaxSumAutoFused<T, false, true,
                                         VectorizedReduction, Async,
                                         CBufferCount, TileM, TileN, TileK>(
            x1, x2, atomicOutput, workspace, matmulCache,
            matmulCacheStrideBytes, cubeTiling, shape,
            cubeBlocks, stream);
    } else {
        LaunchBatchMatmulMaxSumAutoFused<T, false, false,
                                         VectorizedReduction, Async,
                                         CBufferCount, TileM, TileN, TileK>(
            x1, x2, atomicOutput, workspace, matmulCache,
            matmulCacheStrideBytes, cubeTiling, shape,
            cubeBlocks, stream);
    }
}

template<class T, bool TX1, bool TX2,
         uint32_t TileM, uint32_t TileN, uint32_t TileK>
inline void LaunchBatchMatmulMaxSumAutoFusedSplitN(
        GM_ADDR x1, GM_ADDR x2, GM_ADDR atomicOutput, GM_ADDR workspace,
        GM_ADDR matmulCache, uint64_t matmulCacheStrideBytes,
        GM_ADDR partialMax, uint32_t splitN,
        const TCubeTiling& cubeTiling, Shape shape,
        uint32_t cubeBlocks, aclrtStream stream) {
    BatchMatmulMaxSumAutoFused<T, TX1, TX2, true, true, 2,
                               TileM, TileN, TileK, true>
        <<<cubeBlocks, nullptr, stream>>>(
            x1, x2, atomicOutput, workspace, matmulCache,
            matmulCacheStrideBytes, partialMax, splitN,
            cubeTiling, shape, cubeBlocks);
}

template<class T, uint32_t TileM, uint32_t TileN, uint32_t TileK>
inline void LaunchBatchMatmulMaxSumAutoFusedSplitNByTranspose(
        GM_ADDR x1, GM_ADDR x2, GM_ADDR atomicOutput, GM_ADDR workspace,
        GM_ADDR matmulCache, uint64_t matmulCacheStrideBytes,
        GM_ADDR partialMax, uint32_t splitN,
        const TCubeTiling& cubeTiling, Shape shape,
        uint32_t cubeBlocks, aclrtStream stream,
        bool transposeX1, bool transposeX2) {
    if (transposeX1 && transposeX2) {
        LaunchBatchMatmulMaxSumAutoFusedSplitN<
            T, true, true, TileM, TileN, TileK>(
                x1, x2, atomicOutput, workspace, matmulCache,
                matmulCacheStrideBytes, partialMax, splitN,
                cubeTiling, shape, cubeBlocks, stream);
    } else if (transposeX1) {
        LaunchBatchMatmulMaxSumAutoFusedSplitN<
            T, true, false, TileM, TileN, TileK>(
                x1, x2, atomicOutput, workspace, matmulCache,
                matmulCacheStrideBytes, partialMax, splitN,
                cubeTiling, shape, cubeBlocks, stream);
    } else if (transposeX2) {
        LaunchBatchMatmulMaxSumAutoFusedSplitN<
            T, false, true, TileM, TileN, TileK>(
                x1, x2, atomicOutput, workspace, matmulCache,
                matmulCacheStrideBytes, partialMax, splitN,
                cubeTiling, shape, cubeBlocks, stream);
    } else {
        LaunchBatchMatmulMaxSumAutoFusedSplitN<
            T, false, false, TileM, TileN, TileK>(
                x1, x2, atomicOutput, workspace, matmulCache,
                matmulCacheStrideBytes, partialMax, splitN,
                cubeTiling, shape, cubeBlocks, stream);
    }
}

template<uint32_t TileM>
__global__ __vector__ void FinalizeAutoFusedSplitN(
        GM_ADDR partialMaxAddress, GM_ADDR atomicOutputAddress,
        Shape shape, uint32_t splitN, uint32_t workerCount) {
    constexpr uint32_t rowsPerLane = TileM / kAivPerAic;
    GlobalTensor<float> partialMax;
    GlobalTensor<float> atomicOutput;
    partialMax.SetGlobalBuffer(
        reinterpret_cast<__gm__ float*>(partialMaxAddress));
    atomicOutput.SetGlobalBuffer(
        reinterpret_cast<__gm__ float*>(atomicOutputAddress));

    TPipe pipe;
    TBuf<TPosition::VECCALC> sumBuffer;
    pipe.InitBuffer(sumBuffer, kMaxOutputBatches * sizeof(float));
    LocalTensor<float> sums = sumBuffer.Get<float>();
    const uint32_t outputElements = AtomicOutputElements(shape.b);
    for (uint32_t index = 0; index < outputElements; ++index) {
        sums.SetValue(index, 0.0f);
    }

    const uint64_t mGroups =
        (static_cast<uint64_t>(shape.m) + TileM - 1) / TileM;
    const uint64_t workerId = GetBlockIdx();
    for (uint64_t batch = workerId;
         batch < static_cast<uint64_t>(shape.b); batch += workerCount) {
        float batchSum = 0.0f;
        for (uint64_t mGroup = 0; mGroup < mGroups; ++mGroup) {
            const uint64_t rowBase = mGroup * TileM;
            const uint32_t actualM = static_cast<uint32_t>(
                shape.m - static_cast<int64_t>(rowBase) < TileM
                    ? shape.m - static_cast<int64_t>(rowBase) : TileM);
            for (uint32_t lane = 0; lane < kAivPerAic; ++lane) {
                const uint32_t laneRowBase = lane * rowsPerLane;
                const uint32_t laneRows = actualM > laneRowBase
                    ? (actualM - laneRowBase < rowsPerLane
                           ? actualM - laneRowBase : rowsPerLane)
                    : 0;
                for (uint32_t row = 0; row < laneRows; ++row) {
                    float best = -__builtin_inff();
                    for (uint32_t nShard = 0; nShard < splitN; ++nShard) {
                        const uint64_t task =
                            (batch * mGroups + mGroup) * splitN + nShard;
                        const uint64_t record = task * kAivPerAic + lane;
                        const float value = partialMax.GetValue(
                            record * rowsPerLane + row);
                        best = value > best ? value : best;
                    }
                    batchSum += best;
                }
            }
        }
        sums.SetValue(static_cast<uint32_t>(batch), batchSum);
    }
    AtomicAddBatchSums(atomicOutput, sums, outputElements);
}

template<uint32_t TileM>
inline void LaunchFinalizeAutoFusedSplitN(
        GM_ADDR partialMax, GM_ADDR atomicOutput, Shape shape,
        uint32_t splitN, uint32_t workerCount, aclrtStream stream) {
    FinalizeAutoFusedSplitN<TileM><<<workerCount, nullptr, stream>>>(
        partialMax, atomicOutput, shape, splitN, workerCount);
}

}  // namespace bmms
