#pragma once

namespace bmms {

inline void ExecuteReferencePlan(const Plan& plan, GM_ADDR x1, GM_ADDR x2, GM_ADDR y,
                                 int32_t inputDtype, aclrtStream stream,
                                 bool transposeX1, bool transposeX2) {
    DeviceAllocation workspace(plan.tiling.workspaceBytes);
    GM_ADDR atomicOutput = workspace.Address();
    const Shape shape{plan.tiling.b, plan.tiling.m, plan.tiling.n, plan.tiling.k};
    CheckAcl(aclrtMemsetAsync(atomicOutput, static_cast<size_t>(workspace.Bytes()), 0,
                              static_cast<size_t>(workspace.Bytes()), stream),
             "aclrtMemsetAsync(reference atomic output)");

    if (inputDtype == 1) {
        LaunchRowMax<half>(x1, x2, atomicOutput, shape, plan.tiling.launchBlocks,
                           stream, transposeX1, transposeX2);
    } else {
        LaunchRowMax<bfloat16_t>(x1, x2, atomicOutput, shape, plan.tiling.launchBlocks,
                                 stream, transposeX1, transposeX2);
    }
    const size_t outputBytes = static_cast<size_t>(shape.b) * sizeof(float);
    CheckAcl(aclrtMemcpyAsync(y, outputBytes, atomicOutput, outputBytes,
                              ACL_MEMCPY_DEVICE_TO_DEVICE, stream),
             "aclrtMemcpyAsync(reference atomic output to y)");

    CheckAcl(aclrtSynchronizeStream(stream), "aclrtSynchronizeStream(reference kernels)");
}

inline void ExecuteBm16x128x64Plan(
        const Plan& plan, GM_ADDR x1, GM_ADDR x2, GM_ADDR y,
        int32_t inputDtype, aclrtStream stream,
        bool transposeX1, bool transposeX2) {
    const Shape shape{plan.tiling.b, plan.tiling.m, plan.tiling.n, plan.tiling.k};
    const uint64_t rowCount = static_cast<uint64_t>(shape.b) * shape.m;
    const uint64_t rowMaxBytes = rowCount * sizeof(float);
    const uint64_t stageOffset = AlignUpU64(rowMaxBytes, 512);
    const uint64_t stageBytes = static_cast<uint64_t>(plan.tiling.launchBlocks) *
                                kBmTileM * kBmTileN * sizeof(float);
    const uint64_t atomicOffset = stageOffset + stageBytes;
    const uint64_t atomicBytes = AlignUpU64(shape.b, kAtomicAlignmentFloats) * sizeof(float);
    DeviceAllocation workspace(plan.tiling.workspaceBytes);
    GM_ADDR rowMax = workspace.Address();
    GM_ADDR stage = workspace.Address() + stageOffset;
    GM_ADDR atomicOutput = workspace.Address() + atomicOffset;

    auto cubeHostTiling = MakeBm16x128x64CubeTiling(
        shape, inputDtype, transposeX1, transposeX2);
    DeviceAllocation cubeTiling = UploadCubeTiling(cubeHostTiling);
    const uint32_t vectorBlocks = static_cast<uint32_t>(
        std::min<uint64_t>(rowCount, static_cast<uint64_t>(QueryVectorCoreCount())));
    CheckAcl(aclrtMemsetAsync(atomicOutput, static_cast<size_t>(atomicBytes), 0,
                              static_cast<size_t>(atomicBytes), stream),
             "aclrtMemsetAsync(BM atomic output)");
    InitBmRowMax<<<vectorBlocks, nullptr, stream>>>(rowMax, rowCount, vectorBlocks);

    const uint64_t mGroups = CeilDivU64(shape.m, kBmTileM);
    const uint64_t taskCount = static_cast<uint64_t>(shape.b) * mGroups;
    for (uint32_t columnBase = 0; columnBase < static_cast<uint32_t>(shape.n);
         columnBase += kBmTileN) {
        for (uint64_t taskBase = 0; taskBase < taskCount;
             taskBase += plan.tiling.launchBlocks) {
            const uint32_t waveTasks = static_cast<uint32_t>(std::min<uint64_t>(
                plan.tiling.launchBlocks, taskCount - taskBase));
            if (inputDtype == 1) {
                LaunchBmMatmulByTranspose<half>(
                    x1, x2, stage, cubeTiling.Address(), shape, taskBase, waveTasks,
                    columnBase, stream, transposeX1, transposeX2);
            } else {
                LaunchBmMatmulByTranspose<bfloat16_t>(
                    x1, x2, stage, cubeTiling.Address(), shape, taskBase, waveTasks,
                    columnBase, stream, transposeX1, transposeX2);
            }
            const uint32_t updateBlocks = std::min(vectorBlocks, waveTasks);
            const uint32_t finalize = columnBase + kBmTileN >= static_cast<uint32_t>(shape.n);
            UpdateBmRowMax<<<updateBlocks, nullptr, stream>>>(
                stage, rowMax, atomicOutput, shape, taskBase, waveTasks, updateBlocks,
                columnBase, finalize);
        }
    }
    const size_t outputBytes = static_cast<size_t>(shape.b) * sizeof(float);
    CheckAcl(aclrtMemcpyAsync(y, outputBytes, atomicOutput, outputBytes,
                              ACL_MEMCPY_DEVICE_TO_DEVICE, stream),
             "aclrtMemcpyAsync(BM atomic output to y)");
    CheckAcl(aclrtSynchronizeStream(stream), "aclrtSynchronizeStream(BM_16X128X64 kernels)");
}

inline void ExecutePlan(const Plan& plan, GM_ADDR x1, GM_ADDR x2, GM_ADDR y,
                        int32_t inputDtype, aclrtStream stream,
                        bool transposeX1, bool transposeX2) {
    switch (plan.path) {
        case KernelPath::REFERENCE:
            ExecuteReferencePlan(plan, x1, x2, y, inputDtype, stream,
                                 transposeX1, transposeX2);
            return;
        case KernelPath::BM:
            if (plan.key != TilingKey::BM_16X128X64) {
                throw std::invalid_argument("Selected BM kernel is not implemented");
            }
            ExecuteBm16x128x64Plan(plan, x1, x2, y, inputDtype, stream,
                                   transposeX1, transposeX2);
            return;
        case KernelPath::BMN:
            throw std::invalid_argument("Selected optimized kernel path is not implemented");
    }
    throw std::invalid_argument("Selected kernel path is invalid");
}

}  // namespace bmms
