#pragma once

namespace bmms {

// run_kernel has no completion callback: the competition driver owns stream
// synchronization and timing. Cache exact per-stream execution resources so
// every launch can return asynchronously without freeing in-flight memory.
// Device reset reclaims these process-lifetime allocations after evaluation.
struct ExecutionResourceKey {
    int32_t deviceId;
    aclrtStream stream;
    TilingKey tilingKey;
    Shape shape;
    int32_t inputDtype;
    bool transposeX1;
    bool transposeX2;
    uint32_t launchBlocks;
    uint32_t splitN;
    uint64_t workspaceBytes;
};

struct CachedExecutionResources {
    ExecutionResourceKey key;
    GM_ADDR workspace;
    uint64_t workspaceBytes;
    GM_ADDR cubeTiling;
    void* cubeTilingHost;
    uint64_t cubeTilingBytes;
};

inline bool SameExecutionResourceKey(
        const ExecutionResourceKey& lhs, const ExecutionResourceKey& rhs) {
    return lhs.deviceId == rhs.deviceId && lhs.stream == rhs.stream &&
           lhs.tilingKey == rhs.tilingKey &&
           lhs.shape.b == rhs.shape.b && lhs.shape.m == rhs.shape.m &&
           lhs.shape.n == rhs.shape.n && lhs.shape.k == rhs.shape.k &&
           lhs.inputDtype == rhs.inputDtype &&
           lhs.transposeX1 == rhs.transposeX1 &&
           lhs.transposeX2 == rhs.transposeX2 &&
           lhs.launchBlocks == rhs.launchBlocks && lhs.splitN == rhs.splitN &&
           lhs.workspaceBytes == rhs.workspaceBytes;
}

inline std::vector<CachedExecutionResources>& ExecutionResourceCache() {
    static std::vector<CachedExecutionResources> cache;
    return cache;
}

inline std::atomic_flag& ExecutionResourceCacheLock() {
    static std::atomic_flag lock = ATOMIC_FLAG_INIT;
    return lock;
}

class ExecutionResourceCacheGuard {
public:
    ExecutionResourceCacheGuard() {
        while (ExecutionResourceCacheLock().test_and_set(std::memory_order_acquire)) {
        }
    }

    ~ExecutionResourceCacheGuard() {
        ExecutionResourceCacheLock().clear(std::memory_order_release);
    }

    ExecutionResourceCacheGuard(const ExecutionResourceCacheGuard&) = delete;
    ExecutionResourceCacheGuard& operator=(const ExecutionResourceCacheGuard&) = delete;
};

inline GM_ADDR AllocatePersistentDeviceBuffer(uint64_t bytes, const char* operation) {
    if (bytes == 0) {
        throw std::invalid_argument("Persistent device buffer must not be empty");
    }
    void* address = nullptr;
    CheckAcl(aclrtMalloc(&address, static_cast<size_t>(bytes), ACL_MEM_MALLOC_HUGE_FIRST),
             operation);
    return static_cast<uint8_t*>(address);
}

inline ExecutionResourceKey MakeExecutionResourceKey(
        const Plan& plan, aclrtStream stream, int32_t inputDtype,
        bool transposeX1, bool transposeX2) {
    int32_t deviceId = 0;
    CheckAcl(aclrtGetDevice(&deviceId), "aclrtGetDevice(resource cache key)");
    return ExecutionResourceKey{
        deviceId,
        stream,
        plan.key,
        Shape{plan.tiling.b, plan.tiling.m, plan.tiling.n, plan.tiling.k},
        inputDtype,
        transposeX1,
        transposeX2,
        plan.tiling.launchBlocks,
        plan.tiling.splitN,
        plan.tiling.workspaceBytes};
}

template<class Factory>
inline CachedExecutionResources GetOrCreateExecutionResources(
        const ExecutionResourceKey& key, Factory factory) {
    ExecutionResourceCacheGuard guard;
    for (const auto& resources : ExecutionResourceCache()) {
        if (SameExecutionResourceKey(resources.key, key)) {
            return resources;
        }
    }
    CachedExecutionResources resources = factory();
    ExecutionResourceCache().push_back(resources);
    return resources;
}

inline CachedExecutionResources GetReferenceExecutionResources(
        const Plan& plan, aclrtStream stream, int32_t inputDtype,
        bool transposeX1, bool transposeX2) {
    const ExecutionResourceKey key = MakeExecutionResourceKey(
        plan, stream, inputDtype, transposeX1, transposeX2);
    return GetOrCreateExecutionResources(key, [&]() {
        return CachedExecutionResources{
            key,
            AllocatePersistentDeviceBuffer(
                plan.tiling.workspaceBytes, "aclrtMalloc(reference workspace cache)"),
            plan.tiling.workspaceBytes,
            nullptr,
            nullptr,
            0};
    });
}

template<uint32_t TileM, uint32_t TileN, uint32_t TileK>
inline CachedExecutionResources GetMatmulExecutionResources(
        const Plan& plan, aclrtStream stream, int32_t inputDtype,
        bool transposeX1, bool transposeX2) {
    const Shape shape{plan.tiling.b, plan.tiling.m, plan.tiling.n, plan.tiling.k};
    const ExecutionResourceKey key = MakeExecutionResourceKey(
        plan, stream, inputDtype, transposeX1, transposeX2);
    return GetOrCreateExecutionResources(key, [&]() {
        auto cubeHostTiling = MakeBmCubeTiling<TileM, TileN, TileK>(
            shape, inputDtype, transposeX1, transposeX2);
        GM_ADDR workspace = AllocatePersistentDeviceBuffer(
            plan.tiling.workspaceBytes, "aclrtMalloc(Matmul workspace cache)");
        const PersistentCubeTiling cubeTiling = UploadPersistentCubeTiling(
            cubeHostTiling, stream);
        return CachedExecutionResources{
            key,
            workspace,
            plan.tiling.workspaceBytes,
            cubeTiling.deviceAddress,
            cubeTiling.hostAddress,
            cubeTiling.bytes};
    });
}

inline void ExecuteReferencePlan(const Plan& plan, GM_ADDR x1, GM_ADDR x2, GM_ADDR y,
                                 int32_t inputDtype, aclrtStream stream,
                                 bool transposeX1, bool transposeX2) {
    const CachedExecutionResources resources = GetReferenceExecutionResources(
        plan, stream, inputDtype, transposeX1, transposeX2);
    GM_ADDR atomicOutput = resources.workspace;
    const Shape shape{plan.tiling.b, plan.tiling.m, plan.tiling.n, plan.tiling.k};
    CheckAcl(aclrtMemsetAsync(
                 atomicOutput, static_cast<size_t>(resources.workspaceBytes), 0,
                 static_cast<size_t>(resources.workspaceBytes), stream),
             "aclrtMemsetAsync(reference atomic output)");

    if (inputDtype == 1) {
        LaunchRowMax<half>(x1, x2, atomicOutput, shape, plan.tiling.launchBlocks,
                           stream, transposeX1, transposeX2);
    } else {
        LaunchRowMax<bfloat16_t>(x1, x2, atomicOutput, shape, plan.tiling.launchBlocks,
                                 stream, transposeX1, transposeX2);
    }
    const size_t outputBytes = static_cast<size_t>(shape.b) * sizeof(float);
    CheckAcl(aclrtMemcpyAsync(y, outputBytes, atomicOutput, outputBytes,
                              ACL_MEMCPY_DEVICE_TO_DEVICE, stream),
             "aclrtMemcpyAsync(reference atomic output to y)");
}

template<uint32_t TileM, uint32_t TileN, uint32_t TileK>
inline void ExecuteBmPlan(
        const Plan& plan, GM_ADDR x1, GM_ADDR x2, GM_ADDR y,
        int32_t inputDtype, aclrtStream stream,
        bool transposeX1, bool transposeX2) {
    const Shape shape{plan.tiling.b, plan.tiling.m, plan.tiling.n, plan.tiling.k};
    const uint64_t mGroups = CeilDivU64(shape.m, TileM);
    const uint64_t taskCount = static_cast<uint64_t>(shape.b) * mGroups;
    const uint64_t rowMaxBytes = taskCount * TileM * sizeof(float);
    const uint64_t stageOffset = AlignUpU64(rowMaxBytes, 512);
    const uint64_t stageBytes = static_cast<uint64_t>(plan.tiling.launchBlocks) *
                                TileM * TileN * sizeof(float);
    const uint64_t atomicOffset = stageOffset + stageBytes;
    const uint64_t atomicBytes = AlignUpU64(shape.b, kAtomicAlignmentFloats) * sizeof(float);
    const CachedExecutionResources resources =
        GetMatmulExecutionResources<TileM, TileN, TileK>(
            plan, stream, inputDtype, transposeX1, transposeX2);
    GM_ADDR rowMax = resources.workspace;
    GM_ADDR stage = resources.workspace + stageOffset;
    GM_ADDR atomicOutput = resources.workspace + atomicOffset;
    const uint32_t vectorBlocks = static_cast<uint32_t>(
        std::min<uint64_t>(taskCount, static_cast<uint64_t>(QueryVectorCoreCount())));
    CheckAcl(aclrtMemsetAsync(atomicOutput, static_cast<size_t>(atomicBytes), 0,
                              static_cast<size_t>(atomicBytes), stream),
             "aclrtMemsetAsync(BM atomic output)");
    for (uint32_t columnBase = 0; columnBase < static_cast<uint32_t>(shape.n);
         columnBase += TileN) {
        for (uint64_t taskBase = 0; taskBase < taskCount;
             taskBase += plan.tiling.launchBlocks) {
            const uint32_t waveTasks = static_cast<uint32_t>(std::min<uint64_t>(
                plan.tiling.launchBlocks, taskCount - taskBase));
            if (inputDtype == 1) {
                LaunchBmMatmulByTranspose<half, TileM, TileN, TileK>(
                    x1, x2, stage, resources.cubeTiling, shape, taskBase, waveTasks,
                    columnBase, stream, transposeX1, transposeX2);
            } else {
                LaunchBmMatmulByTranspose<bfloat16_t, TileM, TileN, TileK>(
                    x1, x2, stage, resources.cubeTiling, shape, taskBase, waveTasks,
                    columnBase, stream, transposeX1, transposeX2);
            }
            const uint32_t updateBlocks = std::min(vectorBlocks, waveTasks);
            const uint32_t finalize = columnBase + TileN >= static_cast<uint32_t>(shape.n);
            UpdateBmRowMax<TileM, TileN><<<updateBlocks, nullptr, stream>>>(
                stage, rowMax, atomicOutput, shape, taskBase, waveTasks, updateBlocks,
                columnBase, finalize);
        }
    }
    const size_t outputBytes = static_cast<size_t>(shape.b) * sizeof(float);
    CheckAcl(aclrtMemcpyAsync(y, outputBytes, atomicOutput, outputBytes,
                              ACL_MEMCPY_DEVICE_TO_DEVICE, stream),
             "aclrtMemcpyAsync(BM atomic output to y)");
}

template<uint32_t TileM, uint32_t TileN, uint32_t TileK, uint32_t MaxSplitN>
inline void ExecuteBmnPlan(
        const Plan& plan, GM_ADDR x1, GM_ADDR x2, GM_ADDR y,
        int32_t inputDtype, aclrtStream stream,
        bool transposeX1, bool transposeX2) {
    const Shape shape{plan.tiling.b, plan.tiling.m, plan.tiling.n, plan.tiling.k};
    const uint32_t splitN = plan.tiling.splitN;
    if (splitN < 1 || splitN > MaxSplitN) {
        throw std::invalid_argument("BMN splitN is outside the kernel instance range");
    }

    const uint64_t mGroups = CeilDivU64(shape.m, TileM);
    const uint64_t nTiles = CeilDivU64(shape.n, TileN);
    const uint64_t bmTaskCount = static_cast<uint64_t>(shape.b) * mGroups;
    const uint64_t bmnTaskCount = bmTaskCount * splitN;
    const uint64_t partialMaxBytes = bmnTaskCount * TileM * sizeof(float);
    const uint64_t stageOffset = AlignUpU64(partialMaxBytes, 512);
    const uint64_t stageBytes = static_cast<uint64_t>(plan.tiling.launchBlocks) *
                                TileM * TileN * sizeof(float);
    const uint64_t atomicOffset = stageOffset + stageBytes;
    const uint64_t atomicBytes = AlignUpU64(shape.b, kAtomicAlignmentFloats) * sizeof(float);
    const CachedExecutionResources resources =
        GetMatmulExecutionResources<TileM, TileN, TileK>(
            plan, stream, inputDtype, transposeX1, transposeX2);
    GM_ADDR partialMax = resources.workspace;
    GM_ADDR stage = resources.workspace + stageOffset;
    GM_ADDR atomicOutput = resources.workspace + atomicOffset;
    const uint32_t vectorCoreCount = static_cast<uint32_t>(QueryVectorCoreCount());
    const uint32_t updateWorkers = static_cast<uint32_t>(
        std::min<uint64_t>(bmnTaskCount, vectorCoreCount));
    CheckAcl(aclrtMemsetAsync(atomicOutput, static_cast<size_t>(atomicBytes), 0,
                              static_cast<size_t>(atomicBytes), stream),
             "aclrtMemsetAsync(BMN atomic output)");

    const uint32_t tileRounds = static_cast<uint32_t>(CeilDivU64(nTiles, splitN));
    for (uint32_t tileRound = 0; tileRound < tileRounds; ++tileRound) {
        for (uint64_t taskBase = 0; taskBase < bmnTaskCount;
             taskBase += plan.tiling.launchBlocks) {
            const uint32_t waveTasks = static_cast<uint32_t>(std::min<uint64_t>(
                plan.tiling.launchBlocks, bmnTaskCount - taskBase));
            if (inputDtype == 1) {
                LaunchBmnMatmulByTranspose<half, TileM, TileN, TileK>(
                    x1, x2, stage, resources.cubeTiling, shape, taskBase, waveTasks,
                    splitN, tileRound, stream, transposeX1, transposeX2);
            } else {
                LaunchBmnMatmulByTranspose<bfloat16_t, TileM, TileN, TileK>(
                    x1, x2, stage, resources.cubeTiling, shape, taskBase, waveTasks,
                    splitN, tileRound, stream, transposeX1, transposeX2);
            }
            const uint32_t updateBlocks = std::min(updateWorkers, waveTasks);
            UpdateBmnPartialMax<TileM, TileN><<<updateBlocks, nullptr, stream>>>(
                stage, partialMax, shape, taskBase, waveTasks, updateBlocks,
                splitN, tileRound);
        }
    }

    const uint32_t reduceBlocks = static_cast<uint32_t>(
        std::min<uint64_t>(bmTaskCount, vectorCoreCount));
    ReduceBmnPartialMax<TileM><<<reduceBlocks, nullptr, stream>>>(
        partialMax, atomicOutput, shape, splitN, bmTaskCount, reduceBlocks);
    const size_t outputBytes = static_cast<size_t>(shape.b) * sizeof(float);
    CheckAcl(aclrtMemcpyAsync(y, outputBytes, atomicOutput, outputBytes,
                              ACL_MEMCPY_DEVICE_TO_DEVICE, stream),
             "aclrtMemcpyAsync(BMN atomic output to y)");
}

inline void ExecutePlan(const Plan& plan, GM_ADDR x1, GM_ADDR x2, GM_ADDR y,
                        int32_t inputDtype, aclrtStream stream,
                        bool transposeX1, bool transposeX2) {
    switch (plan.path) {
        case KernelPath::REFERENCE:
            ExecuteReferencePlan(plan, x1, x2, y, inputDtype, stream,
                                 transposeX1, transposeX2);
            return;
        case KernelPath::BM:
            switch (plan.key) {
                case TilingKey::BM_16X128X64:
                    ExecuteBmPlan<16, 128, 64>(plan, x1, x2, y, inputDtype, stream,
                                               transposeX1, transposeX2);
                    return;
                case TilingKey::BM_32X128X64:
                    ExecuteBmPlan<32, 128, 64>(plan, x1, x2, y, inputDtype, stream,
                                               transposeX1, transposeX2);
                    return;
                case TilingKey::BM_32X256X64:
                    ExecuteBmPlan<32, 256, 64>(plan, x1, x2, y, inputDtype, stream,
                                               transposeX1, transposeX2);
                    return;
                case TilingKey::BM_64X128X128:
                    ExecuteBmPlan<64, 128, 128>(plan, x1, x2, y, inputDtype, stream,
                                                transposeX1, transposeX2);
                    return;
                default:
                    throw std::invalid_argument("Selected BM kernel is not implemented");
            }
        case KernelPath::BMN:
            switch (plan.key) {
                case TilingKey::BMN_16X256X64_P2:
                    ExecuteBmnPlan<16, 256, 64, 2>(plan, x1, x2, y, inputDtype, stream,
                                                   transposeX1, transposeX2);
                    return;
                case TilingKey::BMN_16X256X64_P4:
                    ExecuteBmnPlan<16, 256, 64, 4>(plan, x1, x2, y, inputDtype, stream,
                                                   transposeX1, transposeX2);
                    return;
                default:
                    throw std::invalid_argument("Selected BMN kernel is not implemented");
            }
    }
    throw std::invalid_argument("Selected kernel path is invalid");
}

}  // namespace bmms
