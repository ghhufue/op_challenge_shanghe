#pragma once

namespace bmms {

inline void CheckAcl(aclError status, const char* operation) {
    if (status != ACL_SUCCESS) {
        throw std::runtime_error(std::string(operation) + ": " + std::to_string(status));
    }
}

inline void ExecuteReferencePlan(const Plan& plan, GM_ADDR x1, GM_ADDR x2, GM_ADDR y,
                                 int32_t inputDtype, aclrtStream stream,
                                 bool transposeX1, bool transposeX2) {
    void* workspace = nullptr;
    CheckAcl(aclrtMalloc(&workspace, static_cast<size_t>(plan.tiling.workspaceBytes),
                         ACL_MEM_MALLOC_HUGE_FIRST),
             "aclrtMalloc(row maxima)");
    GM_ADDR partial = static_cast<uint8_t*>(workspace);
    const Shape shape{plan.tiling.b, plan.tiling.m, plan.tiling.n, plan.tiling.k};

    if (inputDtype == 1) {
        LaunchRowMax<half>(x1, x2, partial, shape, plan.tiling.launchBlocks,
                           stream, transposeX1, transposeX2);
    } else {
        LaunchRowMax<bfloat16_t>(x1, x2, partial, shape, plan.tiling.launchBlocks,
                                 stream, transposeX1, transposeX2);
    }
    SumRows<<<1, nullptr, stream>>>(partial, y, shape);

    const aclError synchronizeStatus = aclrtSynchronizeStream(stream);
    const aclError freeStatus = aclrtFree(workspace);
    CheckAcl(synchronizeStatus, "aclrtSynchronizeStream(reference kernels)");
    CheckAcl(freeStatus, "aclrtFree(row maxima)");
}

inline void ExecutePlan(const Plan& plan, GM_ADDR x1, GM_ADDR x2, GM_ADDR y,
                        int32_t inputDtype, aclrtStream stream,
                        bool transposeX1, bool transposeX2) {
    switch (plan.path) {
        case KernelPath::REFERENCE:
            ExecuteReferencePlan(plan, x1, x2, y, inputDtype, stream,
                                 transposeX1, transposeX2);
            return;
        case KernelPath::BM:
        case KernelPath::BMN:
            throw std::invalid_argument("Selected optimized kernel path is not implemented");
    }
    throw std::invalid_argument("Selected kernel path is invalid");
}

}  // namespace bmms
