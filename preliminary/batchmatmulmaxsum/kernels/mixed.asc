#pragma once

#include "lib/matmul_intf.h"

namespace bmms {

using namespace AscendC;

constexpr uint64_t kMixedSyncMode = 2;
constexpr uint64_t kMixedReadyFlag = 5;
constexpr uint64_t kMixedReusableFlagBase = 6;

// Match the official FusedLinearOnlineMaxSum MIX kernel: Matmul emits unit
// completion information and the paired AIV sub-blocks consume each tile.
constexpr MatmulConfig kBmmsMixedMatmulConfig{
    false, false, true, 0, 0, 0, false, false, false, false,
    false, 0, 0, 0, 0, 0, 0, 0, true};

__aicore__ inline void LoadMixedCubeTiling(
        GM_ADDR source, TCubeTiling& destination) {
    auto* sourceWords = reinterpret_cast<__gm__ uint32_t*>(source);
    auto* destinationWords = reinterpret_cast<uint32_t*>(&destination);
    for (uint32_t index = 0;
         index < sizeof(TCubeTiling) / sizeof(uint32_t); ++index) {
        destinationWords[index] = sourceWords[index];
    }
}

template<class T, bool TX1, bool TX2,
         uint32_t TileM, uint32_t TileN, uint32_t TileK>
__global__ __aicore__ void BatchMatmulMaxSumMixed(
        GM_ADDR x1, GM_ADDR x2, GM_ADDR workspaceAddress, GM_ADDR yAddress,
        GM_ADDR cubeTilingAddress, Shape shape, uint32_t cubeBlocks,
        uint32_t nGroups) {
    KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_MIX_AIC_1_2);
    static_assert(TileM % kMixedVectorRatio == 0,
                  "Mixed Matmul rows must split evenly across paired AIV cores");

    const uint32_t rawBlock = GetBlockIdx();
    const uint32_t taskRatio = static_cast<uint32_t>(GetTaskRation());
    uint32_t logicalCore = rawBlock;
    uint32_t vectorLane = 0;
    if ASCEND_IS_AIV {
        logicalCore = rawBlock / taskRatio;
        vectorLane = rawBlock - logicalCore * taskRatio;
    }

    const uint64_t mGroups =
        (static_cast<uint64_t>(shape.m) + TileM - 1) / TileM;
    const uint64_t nTiles =
        (static_cast<uint64_t>(shape.n) + TileN - 1) / TileN;
    const uint64_t bmTaskCount = static_cast<uint64_t>(shape.b) * mGroups;
    const uint64_t taskCount = bmTaskCount * nGroups;
    uint64_t iterationsForCore = 0;
    for (uint64_t task = logicalCore; task < taskCount; task += cubeBlocks) {
        const uint32_t nGroup = static_cast<uint32_t>(task % nGroups);
        iterationsForCore += (nTiles - nGroup + nGroups - 1) / nGroups;
    }
    const uint64_t stageElementsPerBuffer =
        static_cast<uint64_t>(TileM) * TileN;
    const uint64_t stageElements =
        static_cast<uint64_t>(cubeBlocks) * kMixedStageBuffers *
        stageElementsPerBuffer;
    const uint64_t partialMaxOffsetElements =
        ((stageElements * sizeof(float) + 511) / 512 * 512) / sizeof(float);
    const uint64_t partialMaxElements = taskCount * TileM;
    const uint64_t partialSumOffsetElements =
        ((partialMaxOffsetElements * sizeof(float) +
          partialMaxElements * sizeof(float) + 511) / 512 * 512) /
        sizeof(float);

    GlobalTensor<T> lhs;
    GlobalTensor<T> rhs;
    GlobalTensor<float> stage;
    GlobalTensor<float> partialMax;
    GlobalTensor<float> partialSums;
    GlobalTensor<float> output;
    lhs.SetGlobalBuffer(reinterpret_cast<__gm__ T*>(x1));
    rhs.SetGlobalBuffer(reinterpret_cast<__gm__ T*>(x2));
    stage.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(workspaceAddress));
    partialMax.SetGlobalBuffer(
        reinterpret_cast<__gm__ float*>(workspaceAddress) +
        partialMaxOffsetElements);
    partialSums.SetGlobalBuffer(
        reinterpret_cast<__gm__ float*>(workspaceAddress) +
        partialSumOffsetElements);
    output.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(yAddress));

    TPipe pipe;
    if ASCEND_IS_AIC {
        using AType = MatmulType<TPosition::GM, CubeFormat::ND, T, TX1>;
        using BType = MatmulType<TPosition::GM, CubeFormat::ND, T, TX2>;
        using CType = MatmulType<TPosition::GM, CubeFormat::ND, float>;
        // A fused MIX kernel runs the Matmul implementation directly on its
        // AIC side.  The generic Matmul alias selects MatmulServiceAux when
        // SPLIT_CORE_CUBE is defined, which only services a separate AIV
        // client and leaves this direct AIC call without a producer.
        matmul::MatmulImpl<AType, BType, CType, CType,
                           kBmmsMixedMatmulConfig> matmul;
        TCubeTiling cubeTiling;
        LoadMixedCubeTiling(cubeTilingAddress, cubeTiling);
        matmul.Init(&cubeTiling, &pipe);

        uint64_t sequence = 0;
        for (uint64_t task = logicalCore; task < taskCount; task += cubeBlocks) {
            const uint64_t bmTask = task / nGroups;
            const uint32_t nGroup = static_cast<uint32_t>(task % nGroups);
            const uint64_t batch = bmTask / mGroups;
            const uint64_t mGroup = bmTask - batch * mGroups;
            const uint64_t rowBase = mGroup * TileM;
            const uint32_t actualM = static_cast<uint32_t>(
                shape.m - static_cast<int64_t>(rowBase) < TileM
                    ? shape.m - static_cast<int64_t>(rowBase) : TileM);
            const uint64_t lhsBatch =
                batch * static_cast<uint64_t>(shape.m) * shape.k;
            const uint64_t rhsBatch =
                batch * static_cast<uint64_t>(shape.n) * shape.k;
            const uint64_t lhsOffset = lhsBatch +
                (TX1 ? rowBase : rowBase * static_cast<uint64_t>(shape.k));

            for (uint64_t nTile = nGroup; nTile < nTiles;
                 nTile += nGroups, ++sequence) {
                const uint32_t pingPong = static_cast<uint32_t>(sequence & 1ULL);
                if (sequence >= kMixedStageBuffers) {
                    CrossCoreWaitFlag(kMixedReusableFlagBase + pingPong);
                }

                const uint32_t columnBase = static_cast<uint32_t>(nTile * TileN);
                const uint32_t actualN = static_cast<uint32_t>(
                    shape.n - static_cast<int64_t>(columnBase) < TileN
                        ? shape.n - static_cast<int64_t>(columnBase) : TileN);
                const uint64_t rhsOffset = rhsBatch +
                    (TX2 ? static_cast<uint64_t>(columnBase) * shape.k
                         : columnBase);
                const uint64_t stageOffset =
                    (static_cast<uint64_t>(logicalCore) * kMixedStageBuffers +
                     pingPong) * stageElementsPerBuffer;

                matmul.SetOrgShape(static_cast<int>(shape.m),
                                   static_cast<int>(shape.n),
                                   static_cast<int>(shape.k),
                                   static_cast<int>(shape.k),
                                   static_cast<int>(TileN));
                matmul.SetTensorA(lhs[lhsOffset], TX1);
                matmul.SetTensorB(rhs[rhsOffset], TX2);
                matmul.SetTail(static_cast<int>(actualM),
                               static_cast<int>(actualN),
                               static_cast<int>(shape.k));
                // Each core owns a compact TileM x TileN staging buffer.  The
                // MIX Matmul API must therefore write sequentially instead of
                // applying the global output matrix stride.
                matmul.template IterateAll<false>(stage[stageOffset], 0, true);
                CrossCoreSetFlag<kMixedSyncMode, PIPE_FIX>(kMixedReadyFlag);
            }
        }
        matmul.End();
    }

    if ASCEND_IS_AIV {
        constexpr uint32_t RowsPerLane = TileM / kMixedVectorRatio;
        constexpr uint32_t FloatRepeat = 64;
        constexpr uint32_t MaxSegments = TileN / FloatRepeat;
        TBuf<TPosition::VECCALC> tileBuffer;
        TBuf<TPosition::VECCALC> rowMaxBuffer;
        TBuf<TPosition::VECCALC> segmentMaxBuffer;
        pipe.InitBuffer(tileBuffer, RowsPerLane * TileN * sizeof(float));
        pipe.InitBuffer(rowMaxBuffer, RowsPerLane * sizeof(float));
        pipe.InitBuffer(segmentMaxBuffer,
                        RowsPerLane * MaxSegments * 2 * sizeof(float));
        LocalTensor<float> tile = tileBuffer.Get<float>();
        LocalTensor<float> rowMax = rowMaxBuffer.Get<float>();
        LocalTensor<float> segmentMax = segmentMaxBuffer.Get<float>();

        uint64_t sequence = 0;
        for (uint64_t task = logicalCore; task < taskCount; task += cubeBlocks) {
            const uint64_t bmTask = task / nGroups;
            const uint32_t nGroup = static_cast<uint32_t>(task % nGroups);
            const uint64_t batch = bmTask / mGroups;
            const uint64_t mGroup = bmTask - batch * mGroups;
            const uint64_t rowBase = mGroup * TileM;
            const uint32_t actualM = static_cast<uint32_t>(
                shape.m - static_cast<int64_t>(rowBase) < TileM
                    ? shape.m - static_cast<int64_t>(rowBase) : TileM);
            const uint32_t laneRowBase = vectorLane * RowsPerLane;
            const uint32_t laneRows = actualM > laneRowBase
                ? (actualM - laneRowBase < RowsPerLane
                       ? actualM - laneRowBase : RowsPerLane)
                : 0;
            for (uint32_t row = 0; row < RowsPerLane; ++row) {
                rowMax.SetValue(row, -__builtin_inff());
            }

            for (uint64_t nTile = nGroup; nTile < nTiles;
                 nTile += nGroups, ++sequence) {
                const uint32_t pingPong = static_cast<uint32_t>(sequence & 1ULL);
                CrossCoreWaitFlag(kMixedReadyFlag);
                const uint32_t columnBase = static_cast<uint32_t>(nTile * TileN);
                const uint32_t actualN = static_cast<uint32_t>(
                    shape.n - static_cast<int64_t>(columnBase) < TileN
                        ? shape.n - static_cast<int64_t>(columnBase) : TileN);
                const uint64_t stageOffset =
                    (static_cast<uint64_t>(logicalCore) * kMixedStageBuffers +
                     pingPong) * stageElementsPerBuffer +
                    static_cast<uint64_t>(laneRowBase) * TileN;

                DataCopy(tile, stage[stageOffset], RowsPerLane * TileN);
                SetFlag<HardEvent::MTE2_V>(0);
                WaitFlag<HardEvent::MTE2_V>(0);
                const uint32_t activeSegments =
                    (actualN + FloatRepeat - 1) / FloatRepeat;
                for (uint32_t segment = 0; segment < activeSegments; ++segment) {
                    const uint32_t segmentStart = segment * FloatRepeat;
                    const uint32_t segmentCount = actualN - segmentStart < FloatRepeat
                        ? actualN - segmentStart : FloatRepeat;
                    if (laneRows > 0) {
                        WholeReduceMax(
                            segmentMax[segment * RowsPerLane * 2], tile[segmentStart],
                            static_cast<int32_t>(segmentCount),
                            static_cast<int32_t>(laneRows), 1, 1,
                            static_cast<int32_t>(TileN / 8),
                            ReduceOrder::ORDER_ONLY_VALUE);
                    }
                }
                if (laneRows > 0) {
                    SetFlag<HardEvent::V_S>(0);
                    WaitFlag<HardEvent::V_S>(0);
                    for (uint32_t row = 0; row < laneRows; ++row) {
                        float best = rowMax.GetValue(row);
                        for (uint32_t segment = 0; segment < activeSegments;
                            ++segment) {
                            const float value = segmentMax.GetValue(
                                segment * RowsPerLane * 2 + row);
                            best = value > best ? value : best;
                        }
                        rowMax.SetValue(row, best);
                    }
                }
                if (sequence + kMixedStageBuffers < iterationsForCore) {
                    // This acknowledgement follows the MTE3 write of the
                    // per-tile partial maxima.  PIPE_S is not a valid producer
                    // for this cross-core event on dav-2201 and faults as an
                    // illegal AIV instruction once a stage buffer is reused.
                    CrossCoreSetFlag<kMixedSyncMode, PIPE_MTE3>(
                        kMixedReusableFlagBase + pingPong);
                }
            }

            const uint64_t partialBase = task * TileM + laneRowBase;
            SetFlag<HardEvent::S_MTE3>(0);
            WaitFlag<HardEvent::S_MTE3>(0);
            DataCopy(partialMax[partialBase], rowMax, RowsPerLane);
            SetFlag<HardEvent::MTE3_S>(0);
            WaitFlag<HardEvent::MTE3_S>(0);
        }
    }

    SyncAll<false>();

    if ASCEND_IS_AIV {
        constexpr uint32_t RowsPerLane = TileM / kMixedVectorRatio;
        TBuf<TPosition::VECCALC> batchSumBuffer;
        pipe.InitBuffer(batchSumBuffer, kMaxOutputBatches * sizeof(float));
        LocalTensor<float> batchSums = batchSumBuffer.Get<float>();
        for (uint32_t batch = 0; batch < kMaxOutputBatches; ++batch) {
            batchSums.SetValue(batch, 0.0f);
        }

        const uint32_t vectorBlocks = cubeBlocks * taskRatio;
        const uint64_t laneTaskCount = bmTaskCount * kMixedVectorRatio;
        for (uint64_t laneTask = rawBlock; laneTask < laneTaskCount;
             laneTask += vectorBlocks) {
            const uint64_t bmTask = laneTask / kMixedVectorRatio;
            const uint32_t lane = static_cast<uint32_t>(
                laneTask % kMixedVectorRatio);
            const uint64_t batch = bmTask / mGroups;
            const uint64_t mGroup = bmTask - batch * mGroups;
            const uint64_t rowBase = mGroup * TileM;
            const uint32_t actualM = static_cast<uint32_t>(
                shape.m - static_cast<int64_t>(rowBase) < TileM
                    ? shape.m - static_cast<int64_t>(rowBase) : TileM);
            const uint32_t laneRowBase = lane * RowsPerLane;
            const uint32_t laneRows = actualM > laneRowBase
                ? (actualM - laneRowBase < RowsPerLane
                       ? actualM - laneRowBase : RowsPerLane)
                : 0;
            float taskSum = 0.0f;
            for (uint32_t row = 0; row < laneRows; ++row) {
                float best = -__builtin_inff();
                for (uint32_t nGroup = 0; nGroup < nGroups; ++nGroup) {
                    const uint64_t task = bmTask * nGroups + nGroup;
                    const float value = partialMax.GetValue(
                        task * TileM + laneRowBase + row);
                    best = value > best ? value : best;
                }
                taskSum += best;
            }
            const uint32_t batchIndex = static_cast<uint32_t>(batch);
            batchSums.SetValue(
                batchIndex, batchSums.GetValue(batchIndex) + taskSum);
        }

        const uint64_t partialBase =
            static_cast<uint64_t>(rawBlock) * kMaxOutputBatches;
        SetFlag<HardEvent::S_MTE3>(0);
        WaitFlag<HardEvent::S_MTE3>(0);
        DataCopy(partialSums[partialBase], batchSums, kMaxOutputBatches);
        SetFlag<HardEvent::MTE3_S>(0);
        WaitFlag<HardEvent::MTE3_S>(0);
    }

    SyncAll<false>();

    if ASCEND_IS_AIV {
        const uint32_t vectorBlocks = cubeBlocks * taskRatio;
        // Keep the final B<=64 reduction on one well-defined AIV sub-block.
        // Direct MIX launches expose only the paired sub-block IDs reliably at
        // this point; distributing batches by rawBlock can leave higher batch
        // outputs unwritten even though every worker partial is available.
        if (rawBlock == 0) {
            for (uint32_t batch = 0; batch < static_cast<uint32_t>(shape.b);
                 ++batch) {
                float total = 0.0f;
                for (uint32_t worker = 0; worker < vectorBlocks; ++worker) {
                    total += partialSums.GetValue(
                        static_cast<uint64_t>(worker) * kMaxOutputBatches + batch);
                }
                output.SetValue(batch, total);
            }
        }
    }
}

template<class T, bool TX1, bool TX2,
         uint32_t TileM, uint32_t TileN, uint32_t TileK>
inline void LaunchBatchMatmulMaxSumMixed(
        GM_ADDR x1, GM_ADDR x2, GM_ADDR workspace, GM_ADDR y,
        GM_ADDR cubeTiling, Shape shape,
        uint32_t cubeBlocks, uint32_t nGroups, aclrtStream stream) {
    BatchMatmulMaxSumMixed<T, TX1, TX2, TileM, TileN, TileK>
        <<<cubeBlocks, nullptr, stream>>>(
            x1, x2, workspace, y, cubeTiling, shape, cubeBlocks, nGroups);
}

template<class T, uint32_t TileM, uint32_t TileN, uint32_t TileK>
inline void LaunchBatchMatmulMaxSumMixedByTranspose(
        GM_ADDR x1, GM_ADDR x2, GM_ADDR workspace, GM_ADDR y,
        GM_ADDR cubeTiling, Shape shape,
        uint32_t cubeBlocks, uint32_t nGroups, aclrtStream stream,
        bool transposeX1, bool transposeX2) {
    if (transposeX1 && transposeX2) {
        LaunchBatchMatmulMaxSumMixed<T, true, true, TileM, TileN, TileK>(
            x1, x2, workspace, y, cubeTiling, shape, cubeBlocks, nGroups, stream);
    } else if (transposeX1) {
        LaunchBatchMatmulMaxSumMixed<T, true, false, TileM, TileN, TileK>(
            x1, x2, workspace, y, cubeTiling, shape, cubeBlocks, nGroups, stream);
    } else if (transposeX2) {
        LaunchBatchMatmulMaxSumMixed<T, false, true, TileM, TileN, TileK>(
            x1, x2, workspace, y, cubeTiling, shape, cubeBlocks, nGroups, stream);
    } else {
        LaunchBatchMatmulMaxSumMixed<T, false, false, TileM, TileN, TileK>(
            x1, x2, workspace, y, cubeTiling, shape, cubeBlocks, nGroups, stream);
    }
}

}  // namespace bmms
