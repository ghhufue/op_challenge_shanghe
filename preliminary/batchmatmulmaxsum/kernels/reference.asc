#pragma once

namespace bmms {

__aicore__ inline uint32_t AtomicOutputElements(int64_t batches) {
    return static_cast<uint32_t>(
        (batches + kAtomicAlignmentFloats - 1) / kAtomicAlignmentFloats *
        kAtomicAlignmentFloats);
}

__aicore__ inline void AtomicAddBatchSums(
        AscendC::GlobalTensor<float>& atomicOutput,
        AscendC::LocalTensor<float>& localSums, uint32_t elementCount) {
    AscendC::SetFlag<AscendC::HardEvent::S_MTE3>(0);
    AscendC::WaitFlag<AscendC::HardEvent::S_MTE3>(0);
    AscendC::SetAtomicAdd<float>();
    AscendC::DataCopy(atomicOutput, localSums, elementCount);
    AscendC::DisableDmaAtomic();
}

template<class T>
__aicore__ inline float Decode(uint16_t bits) {
    union {
        uint16_t bits;
        half value;
    } value;
    value.bits = bits;
    return static_cast<float>(value.value);
}

template<>
__aicore__ inline float Decode<bfloat16_t>(uint16_t bits) {
    union {
        uint32_t bits;
        float value;
    } value;
    value.bits = static_cast<uint32_t>(bits) << 16;
    return value.value;
}

// Correctness path. Each worker owns complete (batch, row) tasks, accumulates
// per-batch sums in UB, then issues exactly one aligned atomic GM write.
template<class T, bool TX1, bool TX2>
__global__ __vector__ void RowMax(GM_ADDR x1, GM_ADDR x2, GM_ADDR atomicOutputAddress,
                                  Shape shape, int64_t taskCount,
                                  int64_t workerCount) {
    AscendC::GlobalTensor<uint16_t> lhs;
    AscendC::GlobalTensor<uint16_t> rhs;
    AscendC::GlobalTensor<float> atomicOutput;
    lhs.SetGlobalBuffer(reinterpret_cast<__gm__ uint16_t*>(x1));
    rhs.SetGlobalBuffer(reinterpret_cast<__gm__ uint16_t*>(x2));
    atomicOutput.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(atomicOutputAddress));

    AscendC::TPipe pipe;
    AscendC::TBuf<AscendC::TPosition::VECCALC> atomicBuffer;
    pipe.InitBuffer(atomicBuffer, kMaxOutputBatches * sizeof(float));
    auto localSums = atomicBuffer.Get<float>();
    const uint32_t atomicElements = AtomicOutputElements(shape.b);
    for (uint32_t index = 0; index < atomicElements; ++index) {
        localSums.SetValue(index, 0.0f);
    }

    const int64_t workerId = AscendC::GetBlockIdx();
    for (int64_t taskId = workerId; taskId < taskCount; taskId += workerCount) {
        const int64_t batch = taskId / shape.m;
        const int64_t row = taskId - batch * shape.m;
        float best = -__builtin_inff();

        for (int64_t column = 0; column < shape.n; ++column) {
            float dot = 0.0f;
            for (int64_t depth = 0; depth < shape.k; ++depth) {
                const uint64_t lhsIndex = static_cast<uint64_t>(batch) * shape.m * shape.k +
                    (TX1 ? static_cast<uint64_t>(depth) * shape.m + row
                         : static_cast<uint64_t>(row) * shape.k + depth);
                const uint64_t rhsIndex = static_cast<uint64_t>(batch) * shape.n * shape.k +
                    (TX2 ? static_cast<uint64_t>(column) * shape.k + depth
                         : static_cast<uint64_t>(depth) * shape.n + column);
                dot += Decode<T>(lhs.GetValue(lhsIndex)) * Decode<T>(rhs.GetValue(rhsIndex));
            }
            best = dot > best ? dot : best;
        }
        const uint32_t batchIndex = static_cast<uint32_t>(batch);
        localSums.SetValue(batchIndex, localSums.GetValue(batchIndex) + best);
    }
    AtomicAddBatchSums(atomicOutput, localSums, atomicElements);
}

template<class T>
void LaunchRowMax(GM_ADDR x1, GM_ADDR x2, GM_ADDR atomicOutput, Shape shape,
                  int64_t workerCount, aclrtStream stream,
                  bool transposeX1, bool transposeX2) {
    const int64_t taskCount = shape.b * shape.m;
    if (transposeX1 && transposeX2) {
        RowMax<T, true, true><<<workerCount, nullptr, stream>>>(
            x1, x2, atomicOutput, shape, taskCount, workerCount);
    } else if (transposeX1) {
        RowMax<T, true, false><<<workerCount, nullptr, stream>>>(
            x1, x2, atomicOutput, shape, taskCount, workerCount);
    } else if (transposeX2) {
        RowMax<T, false, true><<<workerCount, nullptr, stream>>>(
            x1, x2, atomicOutput, shape, taskCount, workerCount);
    } else {
        RowMax<T, false, false><<<workerCount, nullptr, stream>>>(
            x1, x2, atomicOutput, shape, taskCount, workerCount);
    }
}

}  // namespace bmms
