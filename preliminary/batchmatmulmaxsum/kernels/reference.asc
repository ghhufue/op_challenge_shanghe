#pragma once

namespace bmms {

template<class T>
__aicore__ inline float Decode(uint16_t bits) {
    union {
        uint16_t bits;
        half value;
    } value;
    value.bits = bits;
    return static_cast<float>(value.value);
}

template<>
__aicore__ inline float Decode<bfloat16_t>(uint16_t bits) {
    union {
        uint32_t bits;
        float value;
    } value;
    value.bits = static_cast<uint32_t>(bits) << 16;
    return value.value;
}

// Correctness path. Each worker owns complete (batch, row) tasks, so K is
// fully accumulated before Max(N), and every partial result has one writer.
template<class T, bool TX1, bool TX2>
__global__ __vector__ void RowMax(GM_ADDR x1, GM_ADDR x2, GM_ADDR partial,
                                  Shape shape, int64_t taskCount,
                                  int64_t workerCount) {
    AscendC::GlobalTensor<uint16_t> lhs;
    AscendC::GlobalTensor<uint16_t> rhs;
    AscendC::GlobalTensor<float> rowMax;
    lhs.SetGlobalBuffer(reinterpret_cast<__gm__ uint16_t*>(x1));
    rhs.SetGlobalBuffer(reinterpret_cast<__gm__ uint16_t*>(x2));
    rowMax.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(partial));

    const int64_t workerId = AscendC::GetBlockIdx();
    for (int64_t taskId = workerId; taskId < taskCount; taskId += workerCount) {
        const int64_t batch = taskId / shape.m;
        const int64_t row = taskId - batch * shape.m;
        float best = -__builtin_inff();

        for (int64_t column = 0; column < shape.n; ++column) {
            float dot = 0.0f;
            for (int64_t depth = 0; depth < shape.k; ++depth) {
                const uint64_t lhsIndex = static_cast<uint64_t>(batch) * shape.m * shape.k +
                    (TX1 ? static_cast<uint64_t>(depth) * shape.m + row
                         : static_cast<uint64_t>(row) * shape.k + depth);
                const uint64_t rhsIndex = static_cast<uint64_t>(batch) * shape.n * shape.k +
                    (TX2 ? static_cast<uint64_t>(column) * shape.k + depth
                         : static_cast<uint64_t>(depth) * shape.n + column);
                dot += Decode<T>(lhs.GetValue(lhsIndex)) * Decode<T>(rhs.GetValue(rhsIndex));
            }
            best = dot > best ? dot : best;
        }
        rowMax.SetValue(static_cast<uint64_t>(taskId), best);
    }
}

__global__ __vector__ void SumRows(GM_ADDR partial, GM_ADDR y, Shape shape) {
    AscendC::GlobalTensor<float> rowMax;
    AscendC::GlobalTensor<float> output;
    rowMax.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(partial));
    output.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(y));

    AscendC::TPipe pipe;
    AscendC::TBuf<AscendC::TPosition::VECCALC> buffer;
    pipe.InitBuffer(buffer, 64 * sizeof(float));
    auto result = buffer.Get<float>();

    for (int64_t batch = 0; batch < shape.b; ++batch) {
        float score = 0.0f;
        const uint64_t base = static_cast<uint64_t>(batch) * shape.m;
        for (int64_t row = 0; row < shape.m; ++row) {
            score += rowMax.GetValue(base + row);
        }
        result.SetValue(static_cast<uint32_t>(batch), score);
    }

    AscendC::SetFlag<AscendC::HardEvent::S_MTE3>(0);
    AscendC::WaitFlag<AscendC::HardEvent::S_MTE3>(0);
    AscendC::DataCopyExtParams params{
        1, static_cast<uint32_t>(shape.b * sizeof(float)), 0, 0, 0
    };
    AscendC::DataCopyPad(output, result, params);
}

template<class T>
void LaunchRowMax(GM_ADDR x1, GM_ADDR x2, GM_ADDR partial, Shape shape,
                  int64_t workerCount, aclrtStream stream,
                  bool transposeX1, bool transposeX2) {
    const int64_t taskCount = shape.b * shape.m;
    if (transposeX1 && transposeX2) {
        RowMax<T, true, true><<<workerCount, nullptr, stream>>>(
            x1, x2, partial, shape, taskCount, workerCount);
    } else if (transposeX1) {
        RowMax<T, true, false><<<workerCount, nullptr, stream>>>(
            x1, x2, partial, shape, taskCount, workerCount);
    } else if (transposeX2) {
        RowMax<T, false, true><<<workerCount, nullptr, stream>>>(
            x1, x2, partial, shape, taskCount, workerCount);
    } else {
        RowMax<T, false, false><<<workerCount, nullptr, stream>>>(
            x1, x2, partial, shape, taskCount, workerCount);
    }
}

}  // namespace bmms
