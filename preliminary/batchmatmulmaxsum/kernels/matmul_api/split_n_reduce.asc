#pragma once

namespace bmms {

// Stage 2 of the single-launch split-N path.  Every (batch, M-group, lane)
// reduction task has one AIV owner, which merges all N-shard maxima and then
// contributes the resulting row sums to the padded per-batch atomic output.
template<uint32_t TileM>
__aicore__ inline void ReduceAllNShardsAndSumM(
        AscendC::GlobalTensor<float>& partialMax,
        AscendC::GlobalTensor<float>& atomicOutput,
        AscendC::LocalTensor<float>& localSums,
        Shape shape, uint32_t splitN,
        uint32_t workerId, uint32_t workerCount) {
    constexpr uint32_t rowsPerLane = TileM / kAivPerAic;
    const uint64_t mGroups =
        (static_cast<uint64_t>(shape.m) + TileM - 1) / TileM;
    const uint64_t reductionTaskCount =
        static_cast<uint64_t>(shape.b) * mGroups * kAivPerAic;

    for (uint64_t reductionTask = workerId;
         reductionTask < reductionTaskCount;
         reductionTask += workerCount) {
        const uint32_t lane = static_cast<uint32_t>(
            reductionTask % kAivPerAic);
        const uint64_t mTask = reductionTask / kAivPerAic;
        const uint64_t batch = mTask / mGroups;
        const uint64_t mGroup = mTask - batch * mGroups;
        const uint64_t rowBase = mGroup * TileM;
        const uint32_t actualM = static_cast<uint32_t>(
            shape.m - static_cast<int64_t>(rowBase) < TileM
                ? shape.m - static_cast<int64_t>(rowBase) : TileM);
        const uint32_t laneRowBase = lane * rowsPerLane;
        const uint32_t laneRows = actualM > laneRowBase
            ? (actualM - laneRowBase < rowsPerLane
                   ? actualM - laneRowBase : rowsPerLane)
            : 0;

        float laneSum = 0.0f;
        for (uint32_t row = 0; row < laneRows; ++row) {
            float best = -__builtin_inff();
            for (uint32_t nShard = 0; nShard < splitN; ++nShard) {
                const uint64_t task = mTask * splitN + nShard;
                const uint64_t record = task * kAivPerAic + lane;
                const float value = partialMax.GetValue(
                    record * rowsPerLane + row);
                best = value > best ? value : best;
            }
            laneSum += best;
        }

        const uint32_t batchIndex = static_cast<uint32_t>(batch);
        localSums.SetValue(
            batchIndex, localSums.GetValue(batchIndex) + laneSum);
    }

    AtomicAddBatchSums(
        atomicOutput, localSums, AtomicOutputElements(shape.b));
}

}  // namespace bmms
