#pragma once

namespace bmms {

template<class T, bool TX1, bool TX2,
         uint32_t TileM, uint32_t TileN, uint32_t TileK>
__global__ __aicore__ void BmnMatmul(
        GM_ADDR x1, GM_ADDR x2, GM_ADDR stage, GM_ADDR cubeTiling,
        Shape shape, uint64_t taskBase, uint32_t waveTasks,
        uint32_t splitN, uint32_t tileRound) {
    KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_AIC_ONLY);
    const uint32_t block = AscendC::GetBlockIdx();
    if (block >= waveTasks) {
        return;
    }

    const uint64_t mGroups = (static_cast<uint64_t>(shape.m) + TileM - 1) / TileM;
    const uint64_t nTiles = (static_cast<uint64_t>(shape.n) + TileN - 1) / TileN;
    const uint64_t task = taskBase + block;
    const uint64_t bmTask = task / splitN;
    const uint32_t nGroup = static_cast<uint32_t>(task - bmTask * splitN);
    const uint64_t batch = bmTask / mGroups;
    const uint64_t mGroup = bmTask - batch * mGroups;
    const uint64_t tileIndex = static_cast<uint64_t>(tileRound) * splitN + nGroup;
    if (tileIndex >= nTiles) {
        return;
    }

    const uint64_t rowBase = mGroup * TileM;
    const uint32_t columnBase = static_cast<uint32_t>(tileIndex * TileN);
    const uint32_t actualM = static_cast<uint32_t>(
        shape.m - static_cast<int64_t>(rowBase) < TileM
            ? shape.m - static_cast<int64_t>(rowBase) : TileM);
    const uint32_t actualN = static_cast<uint32_t>(
        shape.n - static_cast<int64_t>(columnBase) < TileN
            ? shape.n - static_cast<int64_t>(columnBase) : TileN);

    AscendC::GlobalTensor<T> lhs;
    AscendC::GlobalTensor<T> rhs;
    AscendC::GlobalTensor<float> output;
    lhs.SetGlobalBuffer(reinterpret_cast<__gm__ T*>(x1));
    rhs.SetGlobalBuffer(reinterpret_cast<__gm__ T*>(x2));
    output.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(stage));

    const uint64_t lhsBatch = batch * static_cast<uint64_t>(shape.m) * shape.k;
    const uint64_t rhsBatch = batch * static_cast<uint64_t>(shape.n) * shape.k;
    const uint64_t lhsOffset = lhsBatch +
        (TX1 ? rowBase : rowBase * static_cast<uint64_t>(shape.k));
    const uint64_t rhsOffset = rhsBatch +
        (TX2 ? static_cast<uint64_t>(columnBase) * shape.k : columnBase);
    const uint64_t outputOffset = static_cast<uint64_t>(block) * TileM * TileN;

    using AType = AscendC::MatmulType<AscendC::TPosition::GM, CubeFormat::ND, T, TX1>;
    using BType = AscendC::MatmulType<AscendC::TPosition::GM, CubeFormat::ND, T, TX2>;
    using CType = AscendC::MatmulType<AscendC::TPosition::GM, CubeFormat::ND, float>;
    AscendC::Matmul<AType, BType, CType, CType, CFG_MDL> matmul;
    AscendC::TPipe pipe;
    TCubeTiling localTiling;
    LoadBmCubeTiling(cubeTiling, localTiling);
    matmul.Init(&localTiling, &pipe);
    matmul.SetOrgShape(static_cast<int>(shape.m), static_cast<int>(shape.n),
                       static_cast<int>(shape.k), static_cast<int>(shape.k),
                       static_cast<int>(TileN));
    matmul.SetTensorA(lhs[lhsOffset], TX1);
    matmul.SetTensorB(rhs[rhsOffset], TX2);
    matmul.SetTail(static_cast<int>(actualM), static_cast<int>(actualN),
                   static_cast<int>(shape.k));
    matmul.IterateAll(output[outputOffset]);
    matmul.End();
}

template<uint32_t TileM, uint32_t TileN>
__global__ __vector__ void UpdateBmnPartialMax(
        GM_ADDR stageAddress, GM_ADDR partialMaxAddress, Shape shape,
        uint64_t taskBase, uint32_t waveTasks, uint32_t workerCount,
        uint32_t splitN, uint32_t tileRound) {
    static_assert(TileM * sizeof(float) % 32 == 0,
                  "BMN partial-max tiles must be 32-byte aligned for DataCopy");
    AscendC::GlobalTensor<float> stage;
    AscendC::GlobalTensor<float> partialMax;
    stage.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(stageAddress));
    partialMax.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(partialMaxAddress));

    AscendC::TPipe pipe;
    AscendC::TBuf<AscendC::TPosition::VECCALC> partialBuffer;
    pipe.InitBuffer(partialBuffer, TileM * sizeof(float));
    auto taskPartial = partialBuffer.Get<float>();

    const uint64_t mGroups = (static_cast<uint64_t>(shape.m) + TileM - 1) / TileM;
    const uint64_t nTiles = (static_cast<uint64_t>(shape.n) + TileN - 1) / TileN;
    for (uint32_t slot = AscendC::GetBlockIdx(); slot < waveTasks; slot += workerCount) {
        const uint64_t task = taskBase + slot;
        const uint64_t bmTask = task / splitN;
        const uint32_t nGroup = static_cast<uint32_t>(task - bmTask * splitN);
        const uint64_t tileIndex = static_cast<uint64_t>(tileRound) * splitN + nGroup;
        if (tileIndex >= nTiles) {
            continue;
        }

        const uint64_t batch = bmTask / mGroups;
        const uint64_t mGroup = bmTask - batch * mGroups;
        const uint64_t rowBase = mGroup * TileM;
        const uint32_t columnBase = static_cast<uint32_t>(tileIndex * TileN);
        const uint32_t actualM = static_cast<uint32_t>(
            shape.m - static_cast<int64_t>(rowBase) < TileM
                ? shape.m - static_cast<int64_t>(rowBase) : TileM);
        const uint32_t actualN = static_cast<uint32_t>(
            shape.n - static_cast<int64_t>(columnBase) < TileN
                ? shape.n - static_cast<int64_t>(columnBase) : TileN);
        const uint64_t stageBase = static_cast<uint64_t>(slot) * TileM * TileN;
        const uint64_t partialBase = task * TileM;

        if (tileRound == 0) {
            for (uint32_t row = 0; row < TileM; ++row) {
                taskPartial.SetValue(row, -__builtin_inff());
            }
        } else {
            AscendC::DataCopy(taskPartial, partialMax[partialBase], TileM);
            AscendC::SetFlag<AscendC::HardEvent::MTE2_S>(0);
            AscendC::WaitFlag<AscendC::HardEvent::MTE2_S>(0);
        }

        for (uint32_t row = 0; row < actualM; ++row) {
            float best = taskPartial.GetValue(row);
            const uint64_t tileRow = stageBase + static_cast<uint64_t>(row) * TileN;
            for (uint32_t column = 0; column < actualN; ++column) {
                const float value = stage.GetValue(tileRow + column);
                best = value > best ? value : best;
            }
            taskPartial.SetValue(row, best);
        }

        AscendC::SetFlag<AscendC::HardEvent::S_MTE3>(0);
        AscendC::WaitFlag<AscendC::HardEvent::S_MTE3>(0);
        AscendC::DataCopy(partialMax[partialBase], taskPartial, TileM);
        AscendC::SetFlag<AscendC::HardEvent::MTE3_S>(0);
        AscendC::WaitFlag<AscendC::HardEvent::MTE3_S>(0);
    }
}

template<uint32_t TileM>
__global__ __vector__ void ReduceBmnPartialMax(
        GM_ADDR partialMaxAddress, GM_ADDR atomicOutputAddress, Shape shape,
        uint32_t splitN, uint64_t bmTaskCount, uint32_t workerCount) {
    static_assert(TileM * sizeof(float) % 32 == 0,
                  "BMN reduction tiles must be 32-byte aligned for DataCopy");
    AscendC::GlobalTensor<float> partialMax;
    AscendC::GlobalTensor<float> atomicOutput;
    partialMax.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(partialMaxAddress));
    atomicOutput.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(atomicOutputAddress));

    AscendC::TPipe pipe;
    AscendC::TBuf<AscendC::TPosition::VECCALC> reducedBuffer;
    AscendC::TBuf<AscendC::TPosition::VECCALC> groupBuffer;
    AscendC::TBuf<AscendC::TPosition::VECCALC> atomicBuffer;
    pipe.InitBuffer(reducedBuffer, TileM * sizeof(float));
    pipe.InitBuffer(groupBuffer, TileM * sizeof(float));
    pipe.InitBuffer(atomicBuffer, kMaxOutputBatches * sizeof(float));
    auto reducedRows = reducedBuffer.Get<float>();
    auto groupRows = groupBuffer.Get<float>();
    auto localSums = atomicBuffer.Get<float>();

    const uint32_t atomicElements = AtomicOutputElements(shape.b);
    for (uint32_t index = 0; index < atomicElements; ++index) {
        localSums.SetValue(index, 0.0f);
    }

    const uint64_t mGroups = (static_cast<uint64_t>(shape.m) + TileM - 1) / TileM;
    bool groupBufferInUse = false;
    for (uint64_t bmTask = AscendC::GetBlockIdx(); bmTask < bmTaskCount;
         bmTask += workerCount) {
        const uint64_t batch = bmTask / mGroups;
        const uint64_t mGroup = bmTask - batch * mGroups;
        const uint64_t rowBase = mGroup * TileM;
        const uint32_t actualM = static_cast<uint32_t>(
            shape.m - static_cast<int64_t>(rowBase) < TileM
                ? shape.m - static_cast<int64_t>(rowBase) : TileM);
        for (uint32_t row = 0; row < TileM; ++row) {
            reducedRows.SetValue(row, -__builtin_inff());
        }

        for (uint32_t nGroup = 0; nGroup < splitN; ++nGroup) {
            if (groupBufferInUse) {
                AscendC::SetFlag<AscendC::HardEvent::S_MTE2>(0);
                AscendC::WaitFlag<AscendC::HardEvent::S_MTE2>(0);
            }
            const uint64_t partialTask = bmTask * splitN + nGroup;
            AscendC::DataCopy(groupRows, partialMax[partialTask * TileM], TileM);
            AscendC::SetFlag<AscendC::HardEvent::MTE2_S>(0);
            AscendC::WaitFlag<AscendC::HardEvent::MTE2_S>(0);
            groupBufferInUse = true;
            for (uint32_t row = 0; row < actualM; ++row) {
                const float candidate = groupRows.GetValue(row);
                const float best = reducedRows.GetValue(row);
                reducedRows.SetValue(row, candidate > best ? candidate : best);
            }
        }

        float taskSum = 0.0f;
        for (uint32_t row = 0; row < actualM; ++row) {
            taskSum += reducedRows.GetValue(row);
        }
        const uint32_t batchIndex = static_cast<uint32_t>(batch);
        localSums.SetValue(batchIndex, localSums.GetValue(batchIndex) + taskSum);
    }
    AtomicAddBatchSums(atomicOutput, localSums, atomicElements);
}

template<class T, bool TX1, bool TX2,
         uint32_t TileM, uint32_t TileN, uint32_t TileK>
inline void LaunchBmnMatmul(
        GM_ADDR x1, GM_ADDR x2, GM_ADDR stage, GM_ADDR cubeTiling,
        Shape shape, uint64_t taskBase, uint32_t waveTasks,
        uint32_t splitN, uint32_t tileRound, aclrtStream stream) {
    BmnMatmul<T, TX1, TX2, TileM, TileN, TileK><<<waveTasks, nullptr, stream>>>(
        x1, x2, stage, cubeTiling, shape, taskBase, waveTasks, splitN, tileRound);
}

template<class T, uint32_t TileM, uint32_t TileN, uint32_t TileK>
inline void LaunchBmnMatmulByTranspose(
        GM_ADDR x1, GM_ADDR x2, GM_ADDR stage, GM_ADDR cubeTiling,
        Shape shape, uint64_t taskBase, uint32_t waveTasks,
        uint32_t splitN, uint32_t tileRound, aclrtStream stream,
        bool transposeX1, bool transposeX2) {
    if (transposeX1 && transposeX2) {
        LaunchBmnMatmul<T, true, true, TileM, TileN, TileK>(
            x1, x2, stage, cubeTiling, shape, taskBase, waveTasks,
            splitN, tileRound, stream);
    } else if (transposeX1) {
        LaunchBmnMatmul<T, true, false, TileM, TileN, TileK>(
            x1, x2, stage, cubeTiling, shape, taskBase, waveTasks,
            splitN, tileRound, stream);
    } else if (transposeX2) {
        LaunchBmnMatmul<T, false, true, TileM, TileN, TileK>(
            x1, x2, stage, cubeTiling, shape, taskBase, waveTasks,
            splitN, tileRound, stream);
    } else {
        LaunchBmnMatmul<T, false, false, TileM, TileN, TileK>(
            x1, x2, stage, cubeTiling, shape, taskBase, waveTasks,
            splitN, tileRound, stream);
    }
}

}  // namespace bmms
