#pragma once

namespace bmms {

template<uint32_t TileM>
__global__ __vector__ void ReduceAutoFusedPartialScores(
        GM_ADDR workspaceAddress, GM_ADDR yAddress, Shape shape,
        uint64_t partialScoreOffsetBytes) {
    const uint32_t batch = AscendC::GetBlockIdx();
    if (batch >= static_cast<uint32_t>(shape.b)) {
        return;
    }

    AscendC::GlobalTensor<float> partialScores;
    AscendC::GlobalTensor<float> output;
    partialScores.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(
        workspaceAddress + partialScoreOffsetBytes));
    output.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(yAddress));

    const uint64_t mGroups =
        (static_cast<uint64_t>(shape.m) + TileM - 1) / TileM;
    const uint64_t firstTask = static_cast<uint64_t>(batch) * mGroups;
    float total = 0.0f;
    for (uint64_t mGroup = 0; mGroup < mGroups; ++mGroup) {
        const uint64_t task = firstTask + mGroup;
        for (uint32_t lane = 0; lane < kAivPerAic; ++lane) {
            total += partialScores.GetValue(
                task * kAivPerAic + lane);
        }
    }
    output.SetValue(batch, total);
}

template<uint32_t TileM>
inline void LaunchReduceAutoFusedPartialScores(
        GM_ADDR workspace, GM_ADDR y, Shape shape,
        uint64_t partialScoreOffsetBytes, aclrtStream stream) {
    ReduceAutoFusedPartialScores<TileM>
        <<<static_cast<uint32_t>(shape.b), nullptr, stream>>>(
            workspace, y, shape, partialScoreOffsetBytes);
}

}  // namespace bmms
