// Included by the local or competition Host driver.
#include <algorithm>
#include <cstdint>
#include <stdexcept>
#include <string>
#include <vector>
#include "acl/acl.h"
#include "kernel_operator.h"
#include "host/acl_runtime.h"
#include "tiling/tiling_types.h"
#include "tiling/tiling_catalog.h"
#include "tiling/tiling_policy.h"
#include "host/input_validation.h"
#include "host/bm_tiling.h"
#include "kernels/reference.asc"
#include "kernels/bm.asc"
#include "kernels/bmn.asc"
#include "kernels/kernel_dispatch.asc"

extern "C" void run_kernel(GM_ADDR x1, const TensorGroupInfo& info_x1,
    GM_ADDR x2, const TensorGroupInfo& info_x2, GM_ADDR y, const TensorGroupInfo& info_y,
    int64_t availableCoreNum, aclrtStream stream, bool transposeX1, bool transposeX2) {
    const bmms::Shape shape = bmms::ValidateInputs(
        x1, info_x1, x2, info_x2, y, info_y, transposeX1, transposeX2);
    const bmms::TilingKey key = bmms::SelectTilingKey(
        shape, availableCoreNum, info_x1.tensors[0].dtype, transposeX1, transposeX2);
    const int64_t computeCoreNum = bmms::FindTilingConfig(key)->path == bmms::KernelPath::REFERENCE
        ? availableCoreNum : bmms::QueryCubeCoreCount();
    const bmms::Plan plan = bmms::MakePlan(shape, computeCoreNum, key);
    bmms::ExecutePlan(plan, x1, x2, y, info_x1.tensors[0].dtype, stream,
                      transposeX1, transposeX2);
}

#ifdef BMMS_ENABLE_TUNING
extern "C" void run_kernel_forced(GM_ADDR x1, const TensorGroupInfo& info_x1,
    GM_ADDR x2, const TensorGroupInfo& info_x2, GM_ADDR y, const TensorGroupInfo& info_y,
    int64_t availableCoreNum, aclrtStream stream, bool transposeX1, bool transposeX2,
    uint32_t forcedTilingKey) {
    const bmms::Shape shape = bmms::ValidateInputs(
        x1, info_x1, x2, info_x2, y, info_y, transposeX1, transposeX2);
    const bmms::TilingKey key = bmms::ParseTilingKey(forcedTilingKey);
    const int64_t computeCoreNum = bmms::FindTilingConfig(key)->path == bmms::KernelPath::REFERENCE
        ? availableCoreNum : bmms::QueryCubeCoreCount();
    const bmms::Plan plan = bmms::MakePlan(shape, computeCoreNum, key);
    bmms::ExecutePlan(plan, x1, x2, y, info_x1.tensors[0].dtype, stream,
                      transposeX1, transposeX2);
}
#endif
